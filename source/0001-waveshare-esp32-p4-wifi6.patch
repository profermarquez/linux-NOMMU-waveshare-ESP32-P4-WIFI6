index 0000000..dfc23ff
--- /dev/null
+++ b/linux/waveshare/post-build.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Waveshare ESP32-P4-WIFI6 post-build: runs after the Stamp-P4/m3-lab scripts.
+set -eu
+TARGET_DIR=$1
+for f in "${TARGET_DIR}/etc/init.d/S40network" "${TARGET_DIR}/usr/sbin/wifi-connect" "${TARGET_DIR}/usr/sbin/boot-save"; do
+	[ -f "$f" ] && chmod 0755 "$f"
+done
+# Board identity for the login banner and scripts.
+mkdir -p "${TARGET_DIR}/etc/board"
+printf "%s\n" "Waveshare ESP32-P4-WIFI6" >"${TARGET_DIR}/etc/board/model"
diff --git a/linux/waveshare/rootfs-overlay/etc/init.d/S40network b/linux/waveshare/rootfs-overlay/etc/init.d/S40network
new file mode 100755
index 0000000..b674117
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/init.d/S40network
@@ -0,0 +1,139 @@
+#!/bin/sh
+# Waveshare ESP32-P4-WIFI6 network bring-up (replaces the Stamp-P4 m3-lab
+# NG/wpa_supplicant script).
+#
+# The on-board ESP32-C6 runs ESP-Hosted-MCU 3.0.10.  Linux side:
+#   esp_hosted_mcu.ko  -> ethsta0 (802.3 netdev) + /dev/esps0 (RPC channel)
+#   eh-wifi-sta        -> tells the C6 which network to join (RPC), stays up
+#   udhcpc             -> IPv4 on ethsta0
+#
+# Credentials: /boot/wifi-sta.conf (ssid=/psk=, written by wifi-connect and
+# saved to flash by boot-save).  A root-only copy is made in /run/wifi for
+# eh-wifi-sta.  Nothing here prints the passphrase.
+#
+# No "set -e": every step handles its own failure (see the Stamp-P4 #41 note).
+
+if [ -z "${ES_SYSMARK:-}" ] && [ -x /usr/sbin/run-system ]; then
+	ES_SYSMARK=1 exec /usr/sbin/run-system "$0" "$@"
+fi
+
+IFACE=ethsta0
+MOD=esp_hosted_mcu
+CRED_SRC=/boot/wifi-sta.conf
+CRED_RUN=/run/wifi/sta.conf
+STA_PID=/run/eh-wifi-sta.pid
+STA_SUP=/run/.eh-wifi-sta-sup
+DHCP_PID=/run/udhcpc.ethsta0.pid
+LOG=/run/eh-wifi-sta.log
+
+log() { echo "WS-NET: $*"; }
+
+load_module() {
+	if grep -q "^$MOD " /proc/modules; then
+		return 0
+	fi
+	krel=""
+	read -r krel < /proc/sys/kernel/osrelease
+	ko=""
+	for d in updates extra; do
+		[ -f "/lib/modules/$krel/$d/$MOD.ko" ] && ko="/lib/modules/$krel/$d/$MOD.ko" && break
+	done
+	[ -n "$ko" ] || { log "ERROR: $MOD.ko not found under /lib/modules/$krel"; return 1; }
+	mhz=5
+	[ -r /etc/board/sdio-clock-mhz ] && read -r mhz < /etc/board/sdio-clock-mhz
+	if insmod "$ko" "clockspeed=$mhz"; then
+		log "loaded $MOD clockspeed=${mhz}MHz"
+	else
+		log "ERROR: insmod $ko failed rc=$?"
+		return 1
+	fi
+	# Nothing loads lazily later (Stamp-P4 #40): no /sbin/modprobe forks.
+	echo > /proc/sys/kernel/modprobe 2>/dev/null || true
+}
+
+# The m3-lab S05 mounts /tmp/boot.img on /boot, reads it and unmounts it again
+# (ES_BOOT_FS SYNC_UMOUNT) so the Stamp-P4 can export it as a USB drive.  The
+# Waveshare has no USB drive for it, so keep the RAM copy mounted on /boot:
+# wifi-connect, boot-save and the user edit it there.
+mount_boot() {
+	grep -q '^[^ ]* /boot ' /proc/mounts && return 0
+	[ -f /tmp/boot.img ] || { log "ERROR: /tmp/boot.img missing"; return 1; }
+	if mount -t vfat -o loop,rw,sync,umask=0077 /tmp/boot.img /boot; then
+		log "mounted /tmp/boot.img on /boot"
+	else
+		log "ERROR: cannot mount /tmp/boot.img on /boot"
+		return 1
+	fi
+}
+
+wait_iface() {
+	n=0
+	while [ "$n" -lt 30 ]; do
+		[ -d "/sys/class/net/$IFACE" ] && return 0
+		n=$((n + 1))
+		sleep 1
+	done
+	return 1
+}
+
+stop_sta() {
+	if [ -f "$STA_SUP" ]; then
+		read -r p < "$STA_SUP" 2>/dev/null && kill "$p" 2>/dev/null
+		rm -f "$STA_SUP"
+	fi
+	if [ -f "$DHCP_PID" ]; then
+		read -r p < "$DHCP_PID" 2>/dev/null && kill "$p" 2>/dev/null
+		rm -f "$DHCP_PID"
+	fi
+	sleep 1
+}
+
+start_sta() {
+	mount_boot
+	if [ ! -f "$CRED_SRC" ]; then
+		log "no $CRED_SRC: run 'wifi-connect' on the console to join a network"
+		return 0
+	fi
+	umask 077
+	mkdir -p /run/wifi
+	cp -f "$CRED_SRC" "$CRED_RUN" && chmod 600 "$CRED_RUN" || {
+		log "ERROR: cannot stage credentials"; return 1; }
+	ifconfig "$IFACE" up 2>/dev/null || true
+	# eh-wifi-sta must stay resident; respawn restarts it if it exits.
+	respawn -d 5 -p "$STA_PID" -- /usr/sbin/eh-wifi-sta "$CRED_RUN" >>"$LOG" 2>&1 &
+	echo $! > "$STA_SUP"
+	# -f keeps udhcpc in the foreground of its own background job (NOMMU
+	# BusyBox would otherwise re-exec to daemonize); it retries until the
+	# C6 has associated and then renews the lease.
+	udhcpc -f -i "$IFACE" -t 0 -T 3 -A 5 -p "$DHCP_PID" >/dev/null 2>&1 &
+	log "station started on $IFACE (log: $LOG)"
+}
+
+case "${1:-start}" in
+	start)
+		[ -r /etc/hostname ] && read -r h < /etc/hostname && hostname "$h" 2>/dev/null
+		ifconfig lo 127.0.0.1 up 2>/dev/null || true
+		load_module || exit 1
+		# Do not hold up the console login while the C6 comes up.
+		(
+			if wait_iface; then
+				log "$IFACE appeared"
+				start_sta
+			else
+				log "ERROR: $IFACE did not appear (check dmesg for esp_hosted_mcu)"
+			fi
+		) &
+		;;
+	stop)
+		stop_sta
+		;;
+	restart|reload)
+		stop_sta
+		start_sta
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}" >&2
+		exit 1
+		;;
+esac
+exit 0
