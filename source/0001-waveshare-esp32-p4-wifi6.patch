new file mode 100644
index 0000000..dab8020
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/inittab
@@ -0,0 +1,8 @@
+::sysinit:/etc/init.d/rcS
+# Waveshare ESP32-P4-WIFI6: the USB-C serial port (CH343) is UART0 = ttyS0.
+ttyS0::askfirst:-/bin/sh
+# Supervised daemons (#29): init restarts them if they exit.
+::respawn:/usr/sbin/bootsyncd
+::respawn:/usr/sbin/mdnsd -i ethsta0
+::restart:/sbin/init
+::ctrlaltdel:/sbin/reboot
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/boot-save b/linux/waveshare/rootfs-overlay/usr/sbin/boot-save
new file mode 100755
index 0000000..e115c03
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/boot-save
@@ -0,0 +1,30 @@
+#!/bin/sh
+# boot-save — write the /boot drive (config, Wi-Fi network, SSH keys, your
+# programs) to flash so it survives a reboot.  On the Stamp-P4 this happened
+# when the USB host released the drive; the Waveshare has no USB drive, so
+# run this after editing files in /boot.  Uses boot-commit (A/B slots with
+# CRC; the active slot is never erased).
+IMG=/tmp/boot.img
+SNAP=/run/.boot-save.img
+[ -w /run ] || { echo "boot-save: run as root" >&2; exit 1; }
+[ -f "$IMG" ] || { echo "boot-save: $IMG missing" >&2; exit 1; }
+umask 077
+sync
+# Snapshot with /boot read-only so the FAT image is consistent; afterwards
+# restore whatever mode /boot was in (the m3-lab init leaves it ro).
+was_rw=0
+grep -qE '^[^ ]+ /boot [^ ]+ rw[, ]' /proc/mounts && was_rw=1
+if [ "$was_rw" -eq 1 ]; then
+	mount -o remount,ro /boot 2>/dev/null || { echo "boot-save: /boot busy (close open files)" >&2; exit 1; }
+fi
+cp -f "$IMG" "$SNAP"; rc=$?
+[ "$was_rw" -eq 1 ] && mount -o remount,rw /boot 2>/dev/null
+[ "$rc" -eq 0 ] || { rm -f "$SNAP"; echo "boot-save: snapshot failed" >&2; exit 1; }
+rc=0
+/usr/sbin/boot-commit "$SNAP" || rc=$?
+rm -f "$SNAP"
+case "$rc" in
+	0) echo "boot-save: saved to flash" ;;
+	2) echo "boot-save: staged; it is written to flash at the next reboot" ;;
+	*) echo "boot-save: FAILED (rc=$rc), nothing saved" >&2; exit 1 ;;
+esac
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect
new file mode 100755
index 0000000..f44a7f9
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect
@@ -0,0 +1,65 @@
+#!/bin/sh
+# wifi-connect — join a Wi-Fi network as a station (Waveshare ESP32-P4-WIFI6).
+#
+# Asks for the SSID (case-sensitive) and the passphrase on the terminal; the
+# passphrase is read without echo and is never printed or logged.  Writes
+# /boot/wifi-sta.conf, saves /boot to flash (boot-save) and restarts the
+# station.  Run it as root on the serial console.
+CONF=/boot/wifi-sta.conf
+
+[ -w /run ] || { echo "wifi-connect: run as root" >&2; exit 1; }
+[ -d /boot ] || { echo "wifi-connect: /boot is not mounted" >&2; exit 1; }
+
+printf 'SSID (case-sensitive): '
+IFS= read -r ssid || exit 1
+[ -n "$ssid" ] || { echo "empty SSID" >&2; exit 1; }
+stty -echo 2>/dev/null
+printf 'Passphrase (not shown): '
+IFS= read -r psk
+rc=$?
+stty echo 2>/dev/null
+echo
+[ "$rc" -eq 0 ] || exit 1
+n=${#psk}
+if [ "$n" -ne 0 ] && { [ "$n" -lt 8 ] || [ "$n" -gt 64 ]; }; then
+	psk=""
+	echo "wifi-connect: a WPA2 passphrase has 8..63 characters" >&2
+	exit 1
+fi
+
+umask 077
+# The m3-lab init unmounts /boot after reading it (ES_BOOT_FS SYNC_UMOUNT);
+# S40network mounts the RAM image /tmp/boot.img back.  Mount it here too if
+# it is missing, and open it for writing only while the file is replaced.
+if ! grep -q '^[^ ]* /boot ' /proc/mounts; then
+	mount -t vfat -o loop,rw,sync,umask=0077 /tmp/boot.img /boot ||
+		{ psk=""; echo "wifi-connect: cannot mount /tmp/boot.img on /boot" >&2; exit 1; }
+fi
+was_ro=0
+grep -qE '^[^ ]+ /boot [^ ]+ ro[, ]' /proc/mounts && was_ro=1
+if [ "$was_ro" -eq 1 ]; then
+	mount -o remount,rw /boot || { psk=""; echo "wifi-connect: cannot remount /boot rw" >&2; exit 1; }
+fi
+tmp="$CONF.new"
+{ printf 'ssid=%s\n' "$ssid"; printf 'psk=%s\n' "$psk"; } > "$tmp" || { psk=""; exit 1; }
+psk=""
+mv -f "$tmp" "$CONF" || exit 1
+sync
+echo "Saved network \"$ssid\" to $CONF"
+if [ -x /usr/sbin/boot-save ]; then
+	/usr/sbin/boot-save || echo "wifi-connect: not saved to flash yet (see boot-save output)" >&2
+fi
+[ "$was_ro" -eq 1 ] && mount -o remount,ro /boot 2>/dev/null
+/etc/init.d/S40network restart
+echo "Waiting for an address on ethsta0 (Ctrl-C to stop waiting)..."
+i=0
+while [ "$i" -lt 40 ]; do
+	o=$(ifconfig ethsta0 2>/dev/null)
+	case "$o" in
+	*"inet addr:"*) echo "$o" | grep 'inet addr'; exit 0 ;;
+	esac
+	i=$((i + 1))
+	sleep 1
+done
+echo "No address yet; see /run/eh-wifi-sta.log and 'dmesg | grep -i esp'"
+exit 1
