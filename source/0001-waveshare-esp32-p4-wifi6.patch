 fi
 
 if [[ -n ${BUILDROOT_JLEVEL:-} ]]; then
@@ -2283,6 +2312,20 @@ if $lab_profile; then
 else
 	set_config_value "${br_output}/.config" BR2_PACKAGE_BOOT_COMMIT "# BR2_PACKAGE_BOOT_COMMIT is not set"
 fi
