@@ -1285,6 +1301,19 @@ if $network_profile; then
 	# external source cache while keeping the upstream tree out of Git.
 	make_args+=(ESP_HOSTED_NG_SITE="${hosted_root}")
 	make_args+=(BR2_DL_DIR="${buildroot_root}/dl")
