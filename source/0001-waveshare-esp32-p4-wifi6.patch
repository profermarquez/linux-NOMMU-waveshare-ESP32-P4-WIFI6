diff --git a/linux/waveshare/eh-wifi-sta/main/main.c b/linux/waveshare/eh-wifi-sta/main/main.c
new file mode 100644
index 0000000..70da4a6
--- /dev/null
+++ b/linux/waveshare/eh-wifi-sta/main/main.c
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * eh-wifi-sta — keep the Waveshare on-board ESP32-C6 (ESP-Hosted-MCU 3.0.10)
+ * associated as a Wi-Fi station.
+ *
+ *   eh-wifi-sta [CONFIG_FILE]          (default /etc/wifi/sta.conf)
+ *
+ * CONFIG_FILE holds two lines, "ssid=..." and "psk=...", and must not be
+ * readable by group/other.  The SSID is case-sensitive.  The passphrase is
+ * never printed, logged or passed on a command line.  The process stays
+ * resident (the link is torn down when it exits); IPv4 is configured by the
+ * system DHCP client on ethsta0.
+ */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "esp_log.h"
+#include "esp_wifi.h"
+#include "esp_hosted_examples_common.h"
+
+static const char *TAG = "eh-wifi-sta";
+
+static void wipe(void *p, size_t n)
+{
+	volatile unsigned char *v = p;
+	while (n--)
+		*v++ = 0;
+}
+
+static int read_value(const char *line, const char *key, char *out, size_t cap)
+{
+	size_t k = strlen(key);
+	size_t n;
+
+	if (strncmp(line, key, k) != 0 || line[k] != '=')
+		return 0;
+	line += k + 1;
+	n = strcspn(line, "\r\n");
+	if (n >= cap)
+		return -1;
+	memcpy(out, line, n);
+	out[n] = '\0';
+	return 1;
+}
+
+static int load_config(const char *path, char *ssid, size_t ssid_cap,
+		       char *psk, size_t psk_cap)
+{
+	struct stat st;
+	char line[160];
+	FILE *f;
+	int have_ssid = 0;
+
+	if (stat(path, &st) != 0) {
+		ESP_LOGE(TAG, "%s: %s (run wifi-connect first)", path, strerror(errno));
+		return -1;
+	}
+	if (st.st_mode & 077) {
+		ESP_LOGE(TAG, "%s must not be readable by group/other (chmod 600)", path);
+		return -1;
+	}
+	f = fopen(path, "r");
+	if (!f) {
+		ESP_LOGE(TAG, "%s: %s", path, strerror(errno));
+		return -1;
+	}
+	psk[0] = '\0';
+	while (fgets(line, sizeof(line), f)) {
+		int r = read_value(line, "ssid", ssid, ssid_cap);
+
+		if (r > 0)
+			have_ssid = 1;
+		if (r == 0)
+			r = read_value(line, "psk", psk, psk_cap);
+		if (r < 0) {
+			ESP_LOGE(TAG, "%s: value too long", path);
+			wipe(line, sizeof(line));
+			fclose(f);
+			return -1;
+		}
+	}
+	wipe(line, sizeof(line));
+	fclose(f);
+	if (!have_ssid || !ssid[0]) {
+		ESP_LOGE(TAG, "%s: no ssid= line", path);
+		return -1;
+	}
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *path = argc > 1 ? argv[1] : "/etc/wifi/sta.conf";
+	char ssid[33];	/* 802.11 SSID: up to 32 bytes */
+	char psk[65];	/* WPA2 passphrase 8..63, or 64 hex digits */
+	esp_err_t err;
+
+	if (load_config(path, ssid, sizeof(ssid), psk, sizeof(psk)) != 0)
+		return 1;
+
+	ESP_LOGI(TAG, "starting station for SSID \"%s\"", ssid);
+	err = eh_example_sta_start(ssid, psk);
+	wipe(psk, sizeof(psk));
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "station start failed: %s", esp_err_to_name(err));
+		return 1;
+	}
+	err = esp_wifi_connect();
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "esp_wifi_connect: %s", esp_err_to_name(err));
+		return 1;
+	}
+	/* Reconnects are driven by the disconnect handler; stay resident. */
+	for (;;)
+		sleep(3600);
+	return 0;
+}
diff --git a/linux/waveshare/eh-wifi-sta/sdkconfig.defaults b/linux/waveshare/eh-wifi-sta/sdkconfig.defaults
new file mode 100644
index 0000000..cb3e588
--- /dev/null
+++ b/linux/waveshare/eh-wifi-sta/sdkconfig.defaults
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: Apache-2.0
+CONFIG_ESP_HOSTED=y
+CONFIG_ESP_HOSTED_HOST=y
+CONFIG_ESP_HOSTED_HOST_TYPE_POSIX=y
+CONFIG_ESP_HOSTED_HOST_PORT_TYPE_POSIX=y
+CONFIG_ESP_HOSTED_HOST_VSERIAL_LINUX=y
+CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
+CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
+CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
+CONFIG_ESP_HOSTED_HOST_AUTO_FEAT_INIT=y
+CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM_AUTO_INIT=y
+CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
+CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_AUTO_INIT=y
+# Upstream Linux build bug: iTWT is on by default but its include directory
+# is not exported to eh_host_feat_rpc_ext_v2.  Not needed for a station.
+# CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ITWT is not set
+# DHCP is run by the system (udhcpc from S40network), not spawned here.
+CONFIG_ESP_NETIF_LINUX_DHCP_CLIENT_BACKEND_EXTERNAL=y
+# Credentials come from a root-only file at run time, never from the build.
+CONFIG_EH_EXAMPLE_WIFI_SSID=""
+CONFIG_EH_EXAMPLE_WIFI_PASSWORD=""
+# Keep retrying forever: the daemon is supervised and should stay connected.
+CONFIG_EH_EXAMPLE_WIFI_MAXIMUM_RETRY=2147483647
