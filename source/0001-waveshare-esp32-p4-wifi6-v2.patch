diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/wifi-scan b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-scan
new file mode 100755
index 0000000..4f8dac7
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-scan
@@ -0,0 +1,13 @@
+#!/bin/sh
+# wifi-scan — list nearby Wi-Fi networks (Waveshare v2, via eh-wifid).
+. /usr/lib/board/wifi-lib.sh
+wl_need_root
+out=$(eh-wifictl scan) || { echo "$out" >&2; exit 1; }
+printf '%-5s %-3s %-10s %-6s %s\n' RSSI CH SECURITY SAVED SSID
+# No "| while": on NOMMU a piped shell loop needs a re-exec'ed subshell.
+t=/run/.wifi-scan.$$
+printf '%s\n' "$out" | sort -t "$(printf '\t')" -k1,1nr > "$t"
+while IFS="$(printf '\t')" read -r rssi ch auth saved ssid; do
+	printf '%-5s %-3s %-10s %-6s %s\n' "$rssi" "$ch" "$auth" "$saved" "$ssid"
+done < "$t"
+rm -f "$t"
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/wifi-status b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-status
new file mode 100755
index 0000000..be762b9
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-status
@@ -0,0 +1,18 @@
+#!/bin/sh
+# wifi-status — station / soft-AP state, addresses and saved networks.
+. /usr/lib/board/wifi-lib.sh
+wl_need_root
+if ! wl_daemon_up; then
+	echo "eh-wifid is not running (log: /run/eh-wifid.log)"
+	exit 1
+fi
+eh-wifictl status
+for i in ethsta0 ethap0; do
+	a=$(ifconfig "$i" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')
+	echo "${i}_ipv4=${a:-none}"
+done
+echo "saved networks (priority order, passphrases not shown):"
+[ -f "$WIFI_TXT" ] && wl_ssids "$WIFI_TXT" | sed 's/^/  wifi.txt  /'
+wl_ssids "$NETS" | sed 's/^/  saved     /'
+[ -r /run/time-sync.status ] && echo "time: $(cat /run/time-sync.status)"
+exit 0
