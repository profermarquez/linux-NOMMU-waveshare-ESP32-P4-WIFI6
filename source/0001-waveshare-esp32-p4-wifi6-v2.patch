@@ -0,0 +1,42 @@
+################################################################################
+# ESP-Hosted-MCU 3.0.10 Linux host kernel module (Waveshare ESP32-P4-WIFI6)
+#
+# Talks to the unchanged ESP-Hosted-MCU 3.0.10 firmware on the on-board C6.
+# Source: a pinned copy of the espressif/esp_hosted 3.0.10 component kept
+# outside Git in waveshare-port/vendor/ (see waveshare-port/README.md).
+################################################################################
+
+ESP_HOSTED_MCU_VERSION = 3.0.10
+ESP_HOSTED_MCU_SITE = $(BR2_EXTERNAL_STAMP_P4_PATH)/../../../vendor/esp-hosted-mcu-3.0.10
+ESP_HOSTED_MCU_SITE_METHOD = local
+ESP_HOSTED_MCU_LICENSE = GPL-2.0-only (kernel module)
+ESP_HOSTED_MCU_DEPENDENCIES = linux
+ESP_HOSTED_MCU_KMOD_DIR = $(@D)/host/linux/eh_host_linux_kmod/driver
+ESP_HOSTED_MCU_MODULE_MAKE_OPTS = \
+	target=sdio \
+	ESP_SLAVE=CONFIG_TARGET_ESP32C6 \
+	ARCH=$(KERNEL_ARCH) \
+	CROSS_COMPILE="$(TARGET_CROSS)" \
+	CONFIG_BT_ENABLED=n \
+	CONFIG_TEST_RAW_TP=n \
+	CONFIG_DEBUG_LOGS=n
+
+define ESP_HOSTED_MCU_APPLY_PATCH
+	$(APPLY_PATCHES) $(@D) $(BR2_EXTERNAL_STAMP_P4_PATH)/package/esp-hosted-mcu \*.patch
+endef
+ESP_HOSTED_MCU_POST_RSYNC_HOOKS += ESP_HOSTED_MCU_APPLY_PATCH
+
+define ESP_HOSTED_MCU_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(LINUX_DIR) \
+		$(LINUX_MAKE_FLAGS) M=$(ESP_HOSTED_MCU_KMOD_DIR) \
+		$(ESP_HOSTED_MCU_MODULE_MAKE_OPTS) modules
+endef
+
+define ESP_HOSTED_MCU_INSTALL_TARGET_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(LINUX_DIR) \
+		$(LINUX_MAKE_FLAGS) M=$(ESP_HOSTED_MCU_KMOD_DIR) \
+		$(ESP_HOSTED_MCU_MODULE_MAKE_OPTS) \
+		INSTALL_MOD_PATH=$(TARGET_DIR) modules_install
+endef
+
+$(eval $(generic-package))
