diff --git a/linux/boot-shim/main/ws_sdmmc.c b/linux/boot-shim/main/ws_sdmmc.c
new file mode 100644
index 0000000..8f05a42
--- /dev/null
+++ b/linux/boot-shim/main/ws_sdmmc.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-only
+/*
+ * Waveshare ESP32-P4-WIFI6: bring up SDMMC Slot 1 for the on-board ESP32-C6
+ * before Linux takes over.  Replaces m2_sdmmc.c (Stamp-AddOn C6) when the
+ * shim is built with BOARD=waveshare.
+ *
+ * Wiring (Waveshare BSP / ESP-Hosted sdkconfig of the working
+ * 10_wifistation example, and linux-waveshare-xc):
+ *   Slot 1 via GPIO matrix: CLK=18, CMD=19, D0..D3=14..17
+ *   C6 reset: GPIO54, active-high (1 = C6 held in reset, 0 = running)
+ *
+ * The controller and pins are configured with ESP-IDF's own SDMMC host
+ * driver, exactly as linux-waveshare-xc's shim did (it enumerated the C6
+ * under Linux).  The reset sequence follows ESP-Hosted-MCU's host reset for
+ * an active-high line (inactive, assert 10 ms, release) followed by the same
+ * 1500 ms readiness window the Stamp-P4 port validated, so the C6 is ready
+ * before the Linux MMC core sends CMD5.
+ */
+#include <stdint.h>
+
+#include "driver/gpio.h"
+#include "driver/sdmmc_host.h"
+#include "esp_ldo_regulator.h"
+#include "esp_log.h"
+#include "esp_rom_sys.h"
+
+#include "m2_sdmmc.h"
+
+#define WS_C6_RESET_GPIO	54
+#define WS_SDIO_CLK		18
+#define WS_SDIO_CMD		19
+#define WS_SDIO_D0		14
+#define WS_SDIO_D1		15
+#define WS_SDIO_D2		16
+#define WS_SDIO_D3		17
+
+#define C6_RESET_ASSERT_US	10000u
+#define C6_RESET_INACTIVE_US	10000u
+#define C6_RESET_READY_DELAY_US	1500000u
+
+static const char *TAG = "ws_sdio";
+
+static void ws_c6_reset(void)
+{
+	const gpio_config_t cfg = {
+		.pin_bit_mask = 1ULL << WS_C6_RESET_GPIO,
+		.mode = GPIO_MODE_OUTPUT,
+		.pull_up_en = GPIO_PULLUP_DISABLE,
+		.pull_down_en = GPIO_PULLDOWN_DISABLE,
+		.intr_type = GPIO_INTR_DISABLE,
+	};
+
+	ESP_ERROR_CHECK(gpio_config(&cfg));
+	gpio_set_level(WS_C6_RESET_GPIO, 0);	/* inactive */
+	esp_rom_delay_us(C6_RESET_INACTIVE_US);
+	gpio_set_level(WS_C6_RESET_GPIO, 1);	/* assert reset */
+	esp_rom_delay_us(C6_RESET_ASSERT_US);
+	gpio_set_level(WS_C6_RESET_GPIO, 0);	/* release */
+	esp_rom_delay_us(C6_RESET_READY_DELAY_US);
+	ESP_LOGI(TAG, "C6 released from active-high reset on GPIO%d", WS_C6_RESET_GPIO);
+}
+
+/*
+ * microSD slot (GPIO39..44, the SDMMC slot-0 IO_MUX pads): Waveshare's
+ * 09_sdmmc example powers this IO domain from the P4's internal LDO_VO4
+ * (EXAMPLE_SD_PWR_CTRL_LDO_IO_ID default 4, enabled by default).  Linux
+ * drives the card over a bit-banged SPI bus on those pads, so the LDO must
+ * already be on before the jump; the handle is deliberately never released.
+ */
+#define WS_SD_LDO_CHAN		4
+#define WS_SD_LDO_MV		3300
+
+static void ws_sd_power_on(void)
+{
+	esp_ldo_channel_handle_t ldo = NULL;
+	const esp_ldo_channel_config_t cfg = {
+		.chan_id = WS_SD_LDO_CHAN,
+		.voltage_mv = WS_SD_LDO_MV,
+	};
+	esp_err_t err = esp_ldo_acquire_channel(&cfg, &ldo);
+
+	if (err == ESP_OK)
+		ESP_LOGI(TAG, "microSD IO power: LDO_VO%d on at %d mV",
+			 WS_SD_LDO_CHAN, WS_SD_LDO_MV);
+	else
+		ESP_LOGW(TAG, "microSD IO power: LDO_VO%d failed: %s",
+			 WS_SD_LDO_CHAN, esp_err_to_name(err));
+}
+
+void m2_sdmmc_init(void)
+{
+	sdmmc_slot_config_t slot = SDMMC_SLOT_CONFIG_DEFAULT();
+
+	ws_sd_power_on();
+
+	slot.width = 4;
+	slot.clk = WS_SDIO_CLK;
+	slot.cmd = WS_SDIO_CMD;
+	slot.d0 = WS_SDIO_D0;
+	slot.d1 = WS_SDIO_D1;
+	slot.d2 = WS_SDIO_D2;
+	slot.d3 = WS_SDIO_D3;
+	slot.cd = SDMMC_SLOT_NO_CD;
+	slot.wp = SDMMC_SLOT_NO_WP;
+	slot.flags |= SDMMC_SLOT_FLAG_INTERNAL_PULLUP;
+
+	ESP_ERROR_CHECK(sdmmc_host_init());
+	ESP_ERROR_CHECK(sdmmc_host_init_slot(SDMMC_HOST_SLOT_1, &slot));
+	ESP_LOGI(TAG, "C6 SDIO slot 1 ready: CLK%d CMD%d D0..D3=%d..%d",
+		 WS_SDIO_CLK, WS_SDIO_CMD, WS_SDIO_D0, WS_SDIO_D3);
+
+	/* Reset after the pins are routed (pull-ups present), before Linux. */
+	ws_c6_reset();
+}
