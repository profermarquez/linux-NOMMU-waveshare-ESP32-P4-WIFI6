diff --git a/linux/buildroot-external/package/eh-wifi-sta/eh-wifi-sta.mk b/linux/buildroot-external/package/eh-wifi-sta/eh-wifi-sta.mk
new file mode 100644
index 0000000..5658894
--- /dev/null
+++ b/linux/buildroot-external/package/eh-wifi-sta/eh-wifi-sta.mk
@@ -0,0 +1,63 @@
+################################################################################
+# eh-wifi-sta: ESP-Hosted-MCU 3.0.10 Wi-Fi station daemon (Waveshare port)
+#
+# Built with the component's own Linux-host CMake from the pinned
+# esp-hosted-mcu-3.0.10 copy; the application sources live in
+# linux/waveshare/eh-wifi-sta and are copied next to it after rsync.
+################################################################################
+
+EH_WIFI_STA_VERSION = 3.0.10
+EH_WIFI_STA_SITE = $(BR2_EXTERNAL_STAMP_P4_PATH)/../../../vendor/esp-hosted-mcu-3.0.10
+EH_WIFI_STA_SITE_METHOD = local
+EH_WIFI_STA_LICENSE = Apache-2.0
+EH_WIFI_STA_APP_SRC = $(BR2_EXTERNAL_STAMP_P4_PATH)/../waveshare/eh-wifi-sta
+EH_WIFI_STA_SUBDIR = waveshare-app
+EH_WIFI_STA_DEPENDENCIES = host-python3
+
+define EH_WIFI_STA_COPY_APP
+	rm -rf $(@D)/waveshare-app
+	cp -a $(EH_WIFI_STA_APP_SRC) $(@D)/waveshare-app
+	$(APPLY_PATCHES) $(@D) $(BR2_EXTERNAL_STAMP_P4_PATH)/package/eh-wifi-sta \*.patch
+endef
+EH_WIFI_STA_POST_RSYNC_HOOKS += EH_WIFI_STA_COPY_APP
+
+EH_WIFI_STA_CONF_ENV = EH_PATH=$(@D)
+EH_WIFI_STA_MAKE_ENV = EH_PATH=$(@D)
+# NOMMU bFLT: every object must be position independent and the program is
+# loaded to RAM (-r), as the Stamp-P4 MicroPython package does; otherwise
+# binfmt_flat rejects relocations ("reloc outside program").
+# elf2flt.ld, preprocessed the way ld-elf2flt does for a plain (non-shared,
+# rodata-in-data) link, plus the eh_host_feat_descs section inside .data.
+define EH_WIFI_STA_FLAT_LD
+	sed -e '/^W_RODAT:/d' -e 's/^[A-Z_]*://' \
+		$(HOST_DIR)/$(GNU_TARGET_NAME)/lib/elf2flt.ld > $(@D)/waveshare-flat.ld.tmp
+	awk '/^[ \t]*\*\(\.data\)[ \t]*$$/ && !done { \
+		print "\t\t. = ALIGN(8) ;"; \
+		print "\t\tPROVIDE(_eh_host_feat_descs_start = .) ;"; \
+		print "\t\tKEEP(*(eh_host_feat_descs))"; \
+		print "\t\tPROVIDE(_eh_host_feat_descs_end = .) ;"; done = 1 } { print }' \
+		$(@D)/waveshare-flat.ld.tmp > $(@D)/waveshare-flat.ld
+	grep -q 'KEEP(\*(eh_host_feat_descs))' $(@D)/waveshare-flat.ld
+	! grep -qE '^[A-Z_]+:' $(@D)/waveshare-flat.ld
+endef
+EH_WIFI_STA_PRE_CONFIGURE_HOOKS += EH_WIFI_STA_FLAT_LD
+
+EH_WIFI_STA_CONF_OPTS = -DCMAKE_BUILD_TYPE=MinSizeRel \
+	-DEH_LINUX_FLAT_LD=$(@D)/waveshare-flat.ld \
+	-DCMAKE_POSITION_INDEPENDENT_CODE=ON \
+	-DCMAKE_C_FLAGS="$(TARGET_CFLAGS) -fPIC" \
+	-DCMAKE_EXE_LINKER_FLAGS="$(TARGET_LDFLAGS) -fPIC -Wl,-elf2flt=-r"
+
+# NOMMU: the bFLT main stack defaults to 4 KiB; the Stamp-P4 m3-lab gate
+# requires >= 16000 bytes.  The worker threads get their own stacks.
+define EH_WIFI_STA_SET_FLAT_STACK
+	$(TARGET_CC) $(TARGET_CFLAGS) -Wall -Os -fPIC $(TARGET_LDFLAGS) -Wl,-elf2flt=-r \
+		-o $(TARGET_DIR)/usr/sbin/eh-wifictl $(@D)/waveshare-app/main/eh-wifictl.c
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 65536 $(TARGET_DIR)/usr/sbin/eh-wifid
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 16384 $(TARGET_DIR)/usr/sbin/eh-wifictl
+	rm -f $(TARGET_DIR)/usr/sbin/eh-wifi-sta $(TARGET_DIR)/usr/sbin/eh-wifictl.gdb
+	chmod 0755 $(TARGET_DIR)/usr/sbin/eh-wifictl
+endef
+EH_WIFI_STA_POST_INSTALL_TARGET_HOOKS += EH_WIFI_STA_SET_FLAT_STACK
+
+$(eval $(cmake-package))
diff --git a/linux/buildroot-external/package/esp-hosted-mcu/0001-p4-host-fixes.patch b/linux/buildroot-external/package/esp-hosted-mcu/0001-p4-host-fixes.patch
new file mode 100644
index 0000000..5c2e687
--- /dev/null
+++ b/linux/buildroot-external/package/esp-hosted-mcu/0001-p4-host-fixes.patch
@@ -0,0 +1,253 @@
+From: Waveshare ESP32-P4-WIFI6 port
+Subject: [PATCH] eh_host_linux_kmod: ESP32-P4 host fixes for the Waveshare port
+
+Ports the ESP32-P4 host-side fixes the Stamp-P4 project found for
+ESP-Hosted-NG to the ESP-Hosted-MCU 3.0.10 Linux kernel module, so it can
+talk to the unchanged ESP-Hosted-MCU 3.0.10 firmware on the C6:
+
+ - slave register window accessed one byte at a time over CMD52; CMD53
+   reads of that window return zeros on the P4 DW-MMC host (NG 0012);
+ - no nested sdio_claim_host() inside the SDIO IRQ callback (NG 0028);
+ - WQ_PERCPU spelled out for Linux 7.x alloc_workqueue() (NG 0038);
+ - 5 MHz default SDIO clock (NG 0002), still overridable by clockspeed=;
+ - Makefile: ccflags-y instead of EXTRA_CFLAGS (ignored since Linux 6.15)
+   and the module renamed esp_hosted_mcu.ko.
+
+The CMD53 data path is unchanged.
+---
+diff -ruN a/host/linux/eh_host_linux_kmod/driver/Makefile b/host/linux/eh_host_linux_kmod/driver/Makefile
+--- a/host/linux/eh_host_linux_kmod/driver/Makefile
++++ b/host/linux/eh_host_linux_kmod/driver/Makefile
+@@ -23,12 +23,15 @@
+ KERNEL := /lib/modules/$(shell uname -r)/build
+ ARCH := arm64
+ 
++# Waveshare port: Linux 6.15+ ignores EXTRA_CFLAGS, so ccflags-y is used
++# throughout; the SDIO module is named esp_hosted_mcu so it cannot be
++# confused with ESP-Hosted-NG's esp32_sdio.ko.
+ #Default interface is sdio
+-MODULE_NAME=esp32_sdio
++MODULE_NAME=esp_hosted_mcu
+ 
+ #Targets passed overrides default value
+ ifeq ($(target), sdio)
+-	MODULE_NAME=esp32_sdio
++	MODULE_NAME=esp_hosted_mcu
+ endif
+ 
+ ifeq ($(target), spi)
+@@ -36,21 +39,21 @@
+ endif
+ 
+ ifeq ($(CONFIG_TEST_RAW_TP), y)
+-	EXTRA_CFLAGS += -DCONFIG_TEST_RAW_TP
++	ccflags-y += -DCONFIG_TEST_RAW_TP
+ endif
+ 
+ ifeq ($(CONFIG_DEBUG_STATS), y)
+-	EXTRA_CFLAGS += -DESP_DEBUG_STATS
++	ccflags-y += -DESP_DEBUG_STATS
+ endif
+ 
+ ifeq ($(CONFIG_BT_ENABLED), y)
+-	EXTRA_CFLAGS += -DCONFIG_BT_ENABLED
++	ccflags-y += -DCONFIG_BT_ENABLED
+ 	module_objects += src/esp_bt.o
+ endif
+ 
+-EXTRA_CFLAGS += -I$(M)/include -I$(M)/src/priv_include -I$(M)/../../../../common/eh_common/include
++ccflags-y += -I$(M)/include -I$(M)/src/priv_include -I$(M)/../../../../common/eh_common/include
+ 
+-ifeq ($(MODULE_NAME), esp32_sdio)
++ifeq ($(MODULE_NAME), esp_hosted_mcu)
+ 	module_objects += src/sdio/esp_sdio.o src/sdio/esp_sdio_api.o
+ endif
+ 
+@@ -59,31 +62,31 @@
+ endif
+ 
+ ifneq ($(ESP_SLAVE), "")
+-EXTRA_CFLAGS += -D$(ESP_SLAVE)
++ccflags-y += -D$(ESP_SLAVE)
+ endif
+ 
+ ifeq ($(CONFIG_INFO_LOGS), y)
+-	EXTRA_CFLAGS += -DCONFIG_INFO_LOGS
++	ccflags-y += -DCONFIG_INFO_LOGS
+ endif
+ 
+ ifeq ($(CONFIG_DEBUG_LOGS), y)
+-	EXTRA_CFLAGS += -DCONFIG_INFO_LOGS
+-	EXTRA_CFLAGS += -DCONFIG_DEBUG_LOGS
++	ccflags-y += -DCONFIG_INFO_LOGS
++	ccflags-y += -DCONFIG_DEBUG_LOGS
