new file mode 100644
index 0000000..de30013
--- /dev/null
+++ b/linux/buildroot-external/package/https-get/https-get.mk
@@ -0,0 +1,89 @@
+################################################################################
+# https-get: validating HTTPS client on mbedTLS (Waveshare v2)
+################################################################################
+
+HTTPS_GET_VERSION = 1.0
+HTTPS_GET_SITE = $(BR2_EXTERNAL_STAMP_P4_PATH)/../waveshare/https-get
+HTTPS_GET_SITE_METHOD = local
+HTTPS_GET_LICENSE = Apache-2.0
+HTTPS_GET_DEPENDENCIES = mbedtls
+
+define HTTPS_GET_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) -std=gnu11 -Wall -Wextra -Os \
+		$(TARGET_LDFLAGS) -o $(@D)/https-get $(@D)/https-get.c \
+		-lmbedtls -lmbedx509 -lmbedcrypto
+endef
+
+# mbedTLS handshakes (RSA/ECDHE, X.509 chains) need more than the 4 KiB
+# default bFLT stack.
+define HTTPS_GET_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/https-get $(TARGET_DIR)/usr/bin/https-get
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 65536 $(TARGET_DIR)/usr/bin/https-get
+	rm -f $(TARGET_DIR)/usr/bin/https-get.gdb
+endef
+
+# Trim the Buildroot mbedTLS default configuration to what an HTTPS client
+# needs (TLS 1.2 + 1.3, RSA/ECDSA, P-256/384/521 + X25519, AES-GCM/CBC,
+# ChaCha20-Poly1305, X.509 parsing).  Every bFLT program is loaded whole into
+# RAM, so the unused parts cost memory in each https-get / micropython.
+# Appended to the mbedtls package from here (BR2_EXTERNAL is parsed later),
+# as a pre-configure hook so it runs after Buildroot's MBEDTLS_ENABLE_THREADING.
+HTTPS_GET_MBEDTLS_UNSET = \
+	MBEDTLS_SSL_PROTO_DTLS MBEDTLS_SSL_DTLS_ANTI_REPLAY \
+	MBEDTLS_SSL_DTLS_HELLO_VERIFY MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE \
+	MBEDTLS_SSL_DTLS_CONNECTION_ID MBEDTLS_SSL_DTLS_SRTP MBEDTLS_SSL_COOKIE_C \
+	MBEDTLS_SSL_SRV_C MBEDTLS_SSL_TICKET_C MBEDTLS_SSL_CACHE_C \
+	MBEDTLS_SSL_CONTEXT_SERIALIZATION MBEDTLS_SSL_EARLY_DATA \
+	MBEDTLS_CAMELLIA_C MBEDTLS_ARIA_C MBEDTLS_DES_C MBEDTLS_LMS_C \
+	MBEDTLS_PKCS7_C MBEDTLS_PKCS12_C MBEDTLS_X509_CRT_WRITE_C \
+	MBEDTLS_X509_CSR_WRITE_C MBEDTLS_X509_CREATE_C MBEDTLS_X509_CSR_PARSE_C \
+	MBEDTLS_X509_CRL_PARSE_C MBEDTLS_RIPEMD160_C MBEDTLS_ECJPAKE_C \
+	MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED MBEDTLS_DHM_C \
+	MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED \
+	MBEDTLS_KEY_EXCHANGE_PSK_ENABLED MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED \
+	MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED \
+	MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED \
+	MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED \
+	MBEDTLS_ECP_DP_SECP192R1_ENABLED MBEDTLS_ECP_DP_SECP224R1_ENABLED \
+	MBEDTLS_ECP_DP_SECP192K1_ENABLED MBEDTLS_ECP_DP_SECP224K1_ENABLED \
+	MBEDTLS_ECP_DP_SECP256K1_ENABLED MBEDTLS_ECP_DP_BP256R1_ENABLED \
+	MBEDTLS_ECP_DP_BP384R1_ENABLED MBEDTLS_ECP_DP_BP512R1_ENABLED \
+	MBEDTLS_ECP_DP_CURVE448_ENABLED MBEDTLS_PEM_WRITE_C MBEDTLS_CMAC_C \
+	MBEDTLS_NIST_KW_C MBEDTLS_SELF_TEST MBEDTLS_VERSION_FEATURES \
+	MBEDTLS_THREADING_C MBEDTLS_THREADING_PTHREAD MBEDTLS_TIMING_C \
+	MBEDTLS_SSL_PROTO_TLS1_3 MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE \
+	MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED MBEDTLS_HKDF_C \
+	MBEDTLS_USE_PSA_CRYPTO MBEDTLS_PSA_CRYPTO_C MBEDTLS_PSA_CRYPTO_STORAGE_C \
+	MBEDTLS_PSA_ITS_FILE_C MBEDTLS_CCM_C MBEDTLS_CHACHA20_C MBEDTLS_POLY1305_C \
+	MBEDTLS_CHACHAPOLY_C MBEDTLS_CIPHER_MODE_CFB MBEDTLS_CIPHER_MODE_CTR \
+	MBEDTLS_CIPHER_MODE_OFB MBEDTLS_CIPHER_MODE_XTS MBEDTLS_ECDSA_DETERMINISTIC \
+	MBEDTLS_HMAC_DRBG_C MBEDTLS_KEY_EXCHANGE_RSA_ENABLED \
+	MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED \
+	MBEDTLS_GENPRIME MBEDTLS_PKCS5_C MBEDTLS_SHA224_C MBEDTLS_SHA3_C \
+	MBEDTLS_SSL_RENEGOTIATION MBEDTLS_SSL_ENCRYPT_THEN_MAC \
+	MBEDTLS_SSL_MAX_FRAGMENT_LENGTH MBEDTLS_ERROR_C MBEDTLS_ECP_DP_SECP521R1_ENABLED \
+	MBEDTLS_PK_PARSE_EC_EXTENDED MBEDTLS_PK_PARSE_EC_COMPRESSED \
+	MBEDTLS_SSL_ALL_ALERT_MESSAGES MBEDTLS_SSL_KEEP_PEER_CERTIFICATE \
+	MBEDTLS_SSL_ALPN MBEDTLS_SSL_RECORD_SIZE_LIMIT MBEDTLS_ECP_NIST_OPTIM \
+	MBEDTLS_DEBUG_C
+# Minimal TLS 1.2 client (ECDHE-ECDSA/RSA, AES-GCM, P-256/P-384/X25519):
+# every exec copies the whole program into one RAM block, and https-get must
+# stay under 496 KB (#34).  TLS 1.3 needs the PSA core (+220 KB): left out.
+# SHA-1, MD5 and AES-CBC stay for MicroPython's hashlib/cryptolib.
+HTTPS_GET_MBEDTLS_SET = MBEDTLS_AES_FEWER_TABLES
+define HTTPS_GET_TRIM_MBEDTLS
+	for o in $(HTTPS_GET_MBEDTLS_UNSET); do \
+		$(HOST_DIR)/bin/python3 $(MBEDTLS_DIR)/scripts/config.py \
+			-f $(MBEDTLS_DIR)/include/mbedtls/mbedtls_config.h unset $$o || exit 1; \
+	done
+	for o in $(HTTPS_GET_MBEDTLS_SET); do \
+		$(HOST_DIR)/bin/python3 $(MBEDTLS_DIR)/scripts/config.py \
+			-f $(MBEDTLS_DIR)/include/mbedtls/mbedtls_config.h set $$o || exit 1; \
+	done
