@@ -0,0 +1,71 @@
+From: Waveshare ESP32-P4-WIFI6 port
+Subject: [PATCH] Linux host: build for uClibc/bFLT on NOMMU
+
+uClibc on a NOMMU target has no fork() and (with LinuxThreads) no
+pthread_setname_np().  The DHCP client/server spawn child only calls
+setpgid/open/dup2/execv, which is vfork-safe; thread names are skipped.
+elf2flt only uses its own linker script when no -T is given, so
+EH_LINUX_FLAT_LD lets the caller supply a complete flat script.
+---
+diff -ruN a/host/CMakeLists.txt b/host/CMakeLists.txt
+--- a/host/CMakeLists.txt
++++ b/host/CMakeLists.txt
+@@ -149,5 +149,12 @@
+         "${CMAKE_CURRENT_LIST_DIR}/eh_host_feat_descs_linux.ld.in"
+         "${_eh_host_descs_linux_ld}"
+         @ONLY)
+-    target_link_options(eh_host INTERFACE "-Wl,-T${_eh_host_descs_linux_ld}")
++    if(EH_LINUX_FLAT_LD)
++        # NOMMU bFLT (elf2flt): a -T script replaces elf2flt.ld, so the caller
++        # passes a complete flat script that already holds the descriptor
++        # section inside .data (see the Waveshare eh-wifi-sta package).
++        target_link_options(eh_host INTERFACE "-Wl,-T${EH_LINUX_FLAT_LD}")
++    else()
++        target_link_options(eh_host INTERFACE "-Wl,-T${_eh_host_descs_linux_ld}")
++    endif()
+ endif()
+diff -ruN a/port/idf_components/esp_netif/linux/esp_netif_dhcp_client_linux.c b/port/idf_components/esp_netif/linux/esp_netif_dhcp_client_linux.c
+--- a/port/idf_components/esp_netif/linux/esp_netif_dhcp_client_linux.c
++++ b/port/idf_components/esp_netif/linux/esp_netif_dhcp_client_linux.c
+@@ -186,9 +186,10 @@
+     default: return ESP_ERR_NOT_SUPPORTED;
+     }
+ 
+-    pid_t pid = fork();
++    /* NOMMU (uClibc, no fork): the child only redirects stdio and execs. */
++    pid_t pid = vfork();
+     if (pid < 0) {
+-        ESP_LOGE(TAG, "fork: %s", strerror(errno));
++        ESP_LOGE(TAG, "vfork: %s", strerror(errno));
+         return ESP_FAIL;
+     }
+     if (pid == 0) {
+diff -ruN a/port/idf_components/esp_netif/linux/esp_netif_dhcp_server_linux.c b/port/idf_components/esp_netif/linux/esp_netif_dhcp_server_linux.c
+--- a/port/idf_components/esp_netif/linux/esp_netif_dhcp_server_linux.c
++++ b/port/idf_components/esp_netif/linux/esp_netif_dhcp_server_linux.c
+@@ -243,9 +243,10 @@
+     default: return ESP_ERR_NOT_SUPPORTED;
+     }
+ 
+-    pid_t pid = fork();
++    /* NOMMU (uClibc, no fork): the child only redirects stdio and execs. */
++    pid_t pid = vfork();
+     if (pid < 0) {
+-        ESP_LOGE(TAG, "fork: %s", strerror(errno));
++        ESP_LOGE(TAG, "vfork: %s", strerror(errno));
+         return ESP_FAIL;
+     }
+     if (pid == 0) {
+diff -ruN a/port/os/posix/src/eh_host_port_task.c b/port/os/posix/src/eh_host_port_task.c
+--- a/port/os/posix/src/eh_host_port_task.c
++++ b/port/os/posix/src/eh_host_port_task.c
+@@ -104,7 +104,8 @@
+ 
+     t->created = 1;
+     if (cfg->name) {
+-#if defined(__linux__)
++/* uClibc LinuxThreads (NOMMU) has no pthread_setname_np. */
++#if defined(__linux__) && !defined(__UCLIBC__)
