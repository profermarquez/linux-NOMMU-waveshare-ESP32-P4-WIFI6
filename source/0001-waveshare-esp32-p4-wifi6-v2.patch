diff --git a/linux/waveshare/cxx-ejemplos/LEEME.md b/linux/waveshare/cxx-ejemplos/LEEME.md
new file mode 100644
index 0000000..55e6748
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/LEEME.md
@@ -0,0 +1,54 @@
+# C++ en la Waveshare ESP32-P4 (v2)
+
+Programas C++ (STL, excepciones, threads, sockets) para la placa. Se compilan
+en la Mac y se copian por SSH; la imagen no cambia (los programas son
+estáticos).
+
+## Una sola vez: el compilador C++
+
+La imagen se compila sin C++. El compilador va en un directorio aparte de la
+VM, armado con la misma configuración (GCC 13.4, uClibc-ng, LinuxThreads,
+elf2flt), unos 6 minutos:
+
+```bash
+orb -m rv32dev bash ~/esp32p4-linux/waveshare-port/src/linux/waveshare/sdk/build-cxx-toolchain.sh
+```
+
+Queda en `~/ws-out/cxx-toolchain` dentro de la VM.
+
+## Compilar, copiar y correr (desde la Mac)
+
+```bash
+cd ~/esp32p4-linux/waveshare-port/src/linux/waveshare/cxx-ejemplos
+make            # compila (make se vuelve a ejecutar dentro de la VM)
+make deploy     # copia a m5@192.168.100.41:/home/m5/bin
+make run        # copia y corre stl-demo y threads-demo
+```
+
+Otra placa o usuario: `make deploy PLACA=192.168.4.1 USUARIO=m5`.
+
+| Programa | Qué muestra |
+|---|---|
+| `stl-demo` | contenedores, algoritmos, `optional`, punteros inteligentes, excepciones propias y de la biblioteca, destructores durante el unwind |
+| `threads-demo` | `std::thread`, `mutex`, `condition_variable` (cola productor/consumidor) |
+| `sockets-demo get HOST [PUERTO] [RUTA]` | cliente HTTP con una clase `Socket` (RAII + excepciones) |
+| `sockets-demo eco [PUERTO] [MAX]` | servidor eco TCP, un thread por cliente; probar con `nc 192.168.100.41 7000` |
+
+Para HTTPS con verificación de certificados usar `https-get` (fase 5), no
+`sockets-demo`.
+
+## Un programa nuevo
+
+Escribir `NOMBRE.cpp` acá y agregar `NOMBRE` a `PROGS` en el `Makefile`.
+Las reglas de la placa están en `board.mk`; las importantes:
+
+- **Memoria por programa:** al ejecutar, el programa entero (código, datos y
+  pila) se copia a un solo bloque de RAM de 512 KB (496 KB útiles). `make`
+  muestra cuánto pide cada uno y avisa si se pasa (`STRICT=1` lo vuelve
+  error). Los ejemplos piden 280–310 KB.
+- **Usar `<cstdio>` (`printf`), no `<iostream>`:** sólo `iostream` lleva un
+  programa a ~543 KB; arranca únicamente cuando hay un bloque de 1 MB libre.
+- `-fPIC` es obligatorio (sin él las excepciones cuelgan el programa) y
+  `nommu-cxx.o` hace funcionar `std::thread`; `board.mk` ya los pone.
+- Pila de 64 KB (`STACK=` para cambiarla). La placa tiene 1 núcleo:
+  `hardware_concurrency()` da 1.
diff --git a/linux/waveshare/cxx-ejemplos/Makefile b/linux/waveshare/cxx-ejemplos/Makefile
new file mode 100644
index 0000000..de3147d
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/Makefile
@@ -0,0 +1,49 @@
+# C++ examples for the Waveshare ESP32-P4 v2 board.
+#
+# From the Mac (the compiler lives in the build VM; make re-runs itself there):
+#   make                 compile
+#   make deploy          copy to the board (scp -O) into $(DESTINO)
+#   make run             deploy and run stl-demo and threads-demo
+#   make clean
+# Variables: PLACA=192.168.100.41 USUARIO=m5 DESTINO=/home/m5/bin VM=rv32dev
+#
+# A new program: add its name to PROGS and write NAME.cpp next to this file.
+# Rules for the board (flags, size limit): board.mk.
+
+PROGS := stl-demo sockets-demo threads-demo
+
+PLACA ?= 192.168.100.41
+USUARIO ?= m5
+DESTINO ?= /home/$(USUARIO)/bin
+VM ?= rv32dev
+# The board makes a new SSH host key on every boot: do not record it.
+SSH_OPTS ?= -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR
+
+.PHONY: all clean deploy run
+
+ifeq ($(shell uname -s),Darwin)
+
+all:
+	orb -m $(VM) make -C "$(CURDIR)" all
+
+clean:
+	orb -m $(VM) make -C "$(CURDIR)" clean
+
+else
+
+include board.mk
+
+all: $(PROGS)
+
+clean:
+	rm -rf $(B) $(PROGS) $(addsuffix .gdb,$(PROGS))
+
+endif
+
+deploy: all
+	ssh $(SSH_OPTS) $(USUARIO)@$(PLACA) 'mkdir -p $(DESTINO)'
+	scp -O $(SSH_OPTS) $(PROGS) $(USUARIO)@$(PLACA):$(DESTINO)/
+	@echo "copied to $(USUARIO)@$(PLACA):$(DESTINO): $(PROGS)"
+
+run: deploy
+	ssh $(SSH_OPTS) $(USUARIO)@$(PLACA) 'cd $(DESTINO) && ./stl-demo && ./threads-demo'
diff --git a/linux/waveshare/cxx-ejemplos/board.mk b/linux/waveshare/cxx-ejemplos/board.mk
new file mode 100644
index 0000000..7ecfa42
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/board.mk
@@ -0,0 +1,70 @@
+# board.mk - rules for C++ programs on the Waveshare ESP32-P4 v2 image
+# (Linux NOMMU, static uClibc-ng + LinuxThreads, bFLT executables).
+#
+# Include it from a Makefile that runs where the C++ toolchain is (the build
+# VM), then a program is just:   PROGS += foo   (built from foo.cpp)
+#
+# Why each rule exists (all found on the board, phase 6):
+#   -fPIC            without it every C++ exception crashed (SIGSEGV in the
+#                    unwinder reading an unrelocated pointer)
+#   -Wl,-elf2flt=-r  the program is loaded whole into RAM (plain -elf2flt
+#                    segfaults on this kernel)
+#   string-inst.o    linked first: otherwise the linker takes std::string
+#                    from sstream-inst.o and drags in all of <locale>
+#                    (std::thread demo: 803 KB -> 274 KB)
+#   nommu-cxx.o      makes std::thread work with LinuxThreads
+#   flthdr -s        stack size (64 KB)
+#   size check       the program, its data and stack must fit one 512 KB
+#                    block at exec (496 KB usable).  <iostream> alone needs
+#                    ~543 KB: it only starts when a 1 MB block is free.  Use
+#                    <cstdio> (printf) instead.
+
+CXX_TOOLCHAIN ?= $(HOME)/ws-out/cxx-toolchain
+CROSS ?= $(CXX_TOOLCHAIN)/host/bin/riscv32-buildroot-linux-uclibc-
+CXX := $(CROSS)g++
+CC := $(CROSS)gcc
+AR := $(CROSS)ar
+FLTHDR := $(CROSS)flthdr
+
+CXXSTD ?= -std=c++17
+OPT ?= -Os
+WARN ?= -Wall -Wextra
+STACK ?= 65536
+# bss_end + stack must stay below this (one 512 KB block, kernel extras).
+RAM_LIMIT := 507904
+# STRICT=1: a program over the limit is an error instead of a warning.
+STRICT ?= 0
+
+BOARD_FLAGS := -fPIC -ffunction-sections -fdata-sections
+BOARD_LDFLAGS := -Wl,--gc-sections -pthread -Wl,-elf2flt=-r
+
+B := build
+SUPPORT := $(B)/string-inst.o $(B)/nommu-cxx.o
+BOARD_MK_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
+
+$(B):
+	mkdir -p $@
+
+$(B)/string-inst.o: | $(B)
+	@test -x "$(CXX)" || { echo "no C++ compiler at $(CXX): run sdk/build-cxx-toolchain.sh" >&2; exit 1; }
+	cd $(B) && $(AR) x "$$($(CXX) -print-file-name=libstdc++.a)" string-inst.o
+
+$(B)/nommu-cxx.o: $(BOARD_MK_DIR)nommu-cxx.c | $(B)
+	$(CC) $(OPT) -Wall -fPIC -c $< -o $@
+
+# bFLT header: bss_end at byte 20, stack size at 24 (big endian).
+define board_check
+	@need=$$(od -An -tu4 --endian=big -j 20 -N 8 $(1) | awk '{print $$1 + $$2}'); \
+	if [ $$need -lt $(RAM_LIMIT) ]; then \
+		echo "$(1): $$((need / 1024)) KB of RAM at exec (limit 496 KB)"; \
+	else \
+		echo "WARNING: $(1) needs $$((need / 1024)) KB at exec (over 496 KB): it only starts when a 1 MB block is free" >&2; \
+		[ "$(STRICT)" = 0 ] || { rm -f $(1); exit 1; }; \
+	fi
+endef
+
+%: %.cpp $(SUPPORT)
+	$(CXX) $(CXXSTD) $(OPT) $(WARN) $(BOARD_FLAGS) $(CXXFLAGS) -o $@ $< $(SUPPORT) $(BOARD_LDFLAGS) $(LDFLAGS) $(LDLIBS)
+	$(FLTHDR) -s $(STACK) $@
+	rm -f $@.gdb
+	$(call board_check,$@)
diff --git a/linux/waveshare/cxx-ejemplos/nommu-cxx.c b/linux/waveshare/cxx-ejemplos/nommu-cxx.c
new file mode 100644
index 0000000..a49cf87
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/nommu-cxx.c
@@ -0,0 +1,56 @@
+/* nommu-cxx.c - linked into every C++ program for this board (board.mk
+ * does it).  Static uClibc-ng + LinuxThreads quirks for libstdc++ threads:
+ *
+ * 1. libstdc++ decides whether threads exist by checking that the weak
+ *    symbol __pthread_key_create resolves (gthr-posix.h).  LinuxThreads only
+ *    has pthread_key_create, so std::thread threw "Enable multithreading to
+ *    use std::thread".  Provide the alias.
+ * 2. libstdc++ calls pthreads through weak references, and a weak reference
+ *    does not pull a member out of a static libc.a: pthread_create stayed 0
+ *    and std::thread jumped to address 0.  Reference them all strongly.
+ */
+#include <pthread.h>
+#include <sched.h>
+
+int __pthread_key_create(pthread_key_t *k, void (*d)(void *))
+{
+	return pthread_key_create(k, d);
+}
+
+__attribute__((used)) static void *const nommu_cxx_pthread_refs[] = {
+	(void *)pthread_attr_destroy,
+	(void *)pthread_attr_init,
+	(void *)pthread_attr_setdetachstate,
+	(void *)pthread_cancel,
+	(void *)pthread_cond_broadcast,
+	(void *)pthread_cond_destroy,
+	(void *)pthread_cond_init,
+	(void *)pthread_cond_signal,
+	(void *)pthread_cond_timedwait,
+	(void *)pthread_cond_wait,
+	(void *)pthread_create,
+	(void *)pthread_detach,
+	(void *)pthread_equal,
+	(void *)pthread_exit,
+	(void *)pthread_getschedparam,
+	(void *)pthread_getspecific,
+	(void *)pthread_join,
+	(void *)pthread_key_create,
+	(void *)pthread_key_delete,
+	(void *)pthread_mutexattr_destroy,
+	(void *)pthread_mutexattr_init,
+	(void *)pthread_mutexattr_settype,
+	(void *)pthread_mutex_destroy,
+	(void *)pthread_mutex_init,
+	(void *)pthread_mutex_lock,
+	(void *)pthread_mutex_timedlock,
+	(void *)pthread_mutex_trylock,
+	(void *)pthread_mutex_unlock,
+	(void *)pthread_once,
+	(void *)pthread_self,
+	(void *)pthread_setschedparam,
+	(void *)pthread_setspecific,
+	(void *)sched_get_priority_max,
+	(void *)sched_get_priority_min,
+	(void *)sched_yield,
+};
diff --git a/linux/waveshare/cxx-ejemplos/sockets-demo.cpp b/linux/waveshare/cxx-ejemplos/sockets-demo.cpp
new file mode 100644
index 0000000..54a8ec2
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/sockets-demo.cpp
@@ -0,0 +1,234 @@
+// sockets-demo - BSD sockets wrapped in C++ (RAII + exceptions) on the
+// Waveshare ESP32-P4 v2 board.
+//
+//   sockets-demo get HOST [PORT] [PATH]    plain HTTP GET (for HTTPS with
+//                                          certificate checks use https-get)
+//   sockets-demo eco [PORT] [MAX]          TCP echo server, one thread per
+//                                          client; stops after MAX clients
+//                                          (0 = never).  Default port 7000.
+//
+// Try the server from the Mac:   nc 192.168.100.41 7000
+#include <arpa/inet.h>
+#include <atomic>
+#include <cerrno>
+#include <csignal>
+#include <cstdio>
+#include <cstring>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <stdexcept>
+#include <string>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+#include <utility>
+
+// Network failure with the errno (or resolver) reason.
+struct NetError : std::runtime_error {
+	explicit NetError(const std::string &what) : std::runtime_error(what) {}
+	static NetError from_errno(const std::string &what)
+	{
+		return NetError(what + ": " + std::strerror(errno));
+	}
+};
+
+// Owns one file descriptor; closed by the destructor, also when an
+// exception unwinds.  Move-only.
+class Socket {
+public:
+	Socket() = default;
+	explicit Socket(int fd) : fd_(fd) {}
+	Socket(const Socket &) = delete;
+	Socket &operator=(const Socket &) = delete;
+	Socket(Socket &&o) noexcept : fd_(std::exchange(o.fd_, -1)) {}
+	Socket &operator=(Socket &&o) noexcept
+	{
+		if (this != &o) {
+			reset();
+			fd_ = std::exchange(o.fd_, -1);
+		}
+		return *this;
+	}
+	~Socket() { reset(); }
+
+	int fd() const { return fd_; }
+
+	static Socket connect_to(const std::string &host, const std::string &port, int timeout_s)
+	{
+		addrinfo hints{};
+		hints.ai_family = AF_INET;
+		hints.ai_socktype = SOCK_STREAM;
+		addrinfo *res = nullptr;
+		int rc = getaddrinfo(host.c_str(), port.c_str(), &hints, &res);
+		if (rc != 0)
+			throw NetError("cannot resolve " + host + ": " + gai_strerror(rc));
+		std::string last = "no address";
+		for (addrinfo *a = res; a; a = a->ai_next) {
+			Socket s(::socket(a->ai_family, a->ai_socktype, a->ai_protocol));
+			if (s.fd_ < 0) {
+				last = std::strerror(errno);
+				continue;
+			}
+			s.set_timeout(timeout_s);
+			if (::connect(s.fd_, a->ai_addr, a->ai_addrlen) == 0) {
+				freeaddrinfo(res);
+				return s;
+			}
+			last = std::strerror(errno);
+		}
+		freeaddrinfo(res);
+		throw NetError("cannot connect to " + host + ":" + port + ": " + last);
+	}
+
+	static Socket listen_on(int port)
+	{
+		Socket s(::socket(AF_INET, SOCK_STREAM, 0));
+		if (s.fd_ < 0)
+			throw NetError::from_errno("socket");
+		int one = 1;
+		setsockopt(s.fd_, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+		sockaddr_in a{};
+		a.sin_family = AF_INET;
+		a.sin_port = htons(static_cast<uint16_t>(port));
+		a.sin_addr.s_addr = htonl(INADDR_ANY);
+		if (::bind(s.fd_, reinterpret_cast<sockaddr *>(&a), sizeof(a)) < 0)
+			throw NetError::from_errno("bind port " + std::to_string(port));
+		if (::listen(s.fd_, 4) < 0)
+			throw NetError::from_errno("listen");
+		return s;
+	}
+
+	Socket accept_one(std::string &peer) const
+	{
+		sockaddr_in a{};
+		socklen_t len = sizeof(a);
+		int c = ::accept(fd_, reinterpret_cast<sockaddr *>(&a), &len);
+		if (c < 0)
+			throw NetError::from_errno("accept");
+		char ip[INET_ADDRSTRLEN] = "?";
+		inet_ntop(AF_INET, &a.sin_addr, ip, sizeof(ip));
+		peer = std::string(ip) + ":" + std::to_string(ntohs(a.sin_port));
+		return Socket(c);
+	}
+
+	void send_all(const std::string &data) const
+	{
+		size_t off = 0;
+		while (off < data.size()) {
+			ssize_t n = ::send(fd_, data.data() + off, data.size() - off, MSG_NOSIGNAL);
+			if (n < 0) {
+				if (errno == EINTR)
+					continue;
+				throw NetError::from_errno("send");
+			}
+			off += static_cast<size_t>(n);
+		}
+	}
+
+	// Empty string at end of stream.
+	std::string recv_some(size_t max = 1024) const
+	{
+		std::string buf(max, '\0');
+		for (;;) {
+			ssize_t n = ::recv(fd_, &buf[0], max, 0);
+			if (n >= 0) {
+				buf.resize(static_cast<size_t>(n));
+				return buf;
+			}
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				throw NetError("receive: timed out");
+			throw NetError::from_errno("receive");
+		}
+	}
+
+private:
+	void set_timeout(int s)
+	{
+		timeval tv{s, 0};
+		setsockopt(fd_, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+		setsockopt(fd_, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+	}
+	void reset()
+	{
+		if (fd_ >= 0)
+			::close(fd_);
+		fd_ = -1;
+	}
+	int fd_ = -1;
+};
+
+static int cmd_get(const std::string &host, const std::string &port, const std::string &path)
+{
+	Socket s = Socket::connect_to(host, port, 10);
+	s.send_all("GET " + path + " HTTP/1.0\r\nHost: " + host +
+		   "\r\nUser-Agent: sockets-demo\r\nConnection: close\r\n\r\n");
+	std::string resp, chunk;
+	while (!(chunk = s.recv_some(2048)).empty())
+		resp += chunk;
+	size_t eol = resp.find("\r\n");
+	size_t hdr_end = resp.find("\r\n\r\n");
+	if (eol == std::string::npos || hdr_end == std::string::npos)
+		throw std::runtime_error("not an HTTP response (" + std::to_string(resp.size()) + " bytes)");
+	std::printf("%s\n", resp.substr(0, eol).c_str());
+	std::printf("headers: %zu bytes, body: %zu bytes\n", hdr_end, resp.size() - hdr_end - 4);
+	return 0;
+}
+
+static int cmd_eco(int port, int max_clients)
+{
+	Socket srv = Socket::listen_on(port);
+	std::printf("echo server on port %d (%s)\n", port,
+		    max_clients ? ("stops after " + std::to_string(max_clients) + " clients").c_str()
+				: "Ctrl-C to stop");
+	std::fflush(stdout);
+	std::atomic<int> active{0};
+	for (int served = 0; max_clients == 0 || served < max_clients; served++) {
+		std::string peer;
+		Socket c = srv.accept_one(peer);
+		std::printf("client %s connected (%d active)\n", peer.c_str(), ++active);
+		std::fflush(stdout);
+		bool last = max_clients != 0 && served + 1 == max_clients;
+		std::thread t([&active](Socket cs, std::string who) {
+			try {
+				cs.send_all("eco de la placa: escribi algo\n");
+				std::string data;
+				while (!(data = cs.recv_some()).empty())
+					cs.send_all("eco: " + data);
+				std::printf("client %s closed\n", who.c_str());
+			} catch (const std::exception &e) {
+				std::printf("client %s: %s\n", who.c_str(), e.what());
+			}
+			--active;
+			std::fflush(stdout);
+		}, std::move(c), peer);
+		if (last)
+			t.join();	// let the final client finish before exiting
+		else
+			t.detach();
+	}
+	while (active > 0)
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	std::signal(SIGPIPE, SIG_IGN);
+	std::string cmd = argc > 1 ? argv[1] : "";
+	try {
+		if (cmd == "get" && argc >= 3)
+			return cmd_get(argv[2], argc > 3 ? argv[3] : "80", argc > 4 ? argv[4] : "/");
+		if (cmd == "eco")
+			return cmd_eco(argc > 2 ? std::stoi(argv[2]) : 7000, argc > 3 ? std::stoi(argv[3]) : 0);
+	} catch (const NetError &e) {
+		std::fprintf(stderr, "network error: %s\n", e.what());
+		return 2;
+	} catch (const std::exception &e) {
+		std::fprintf(stderr, "error: %s\n", e.what());
+		return 1;
+	}
+	std::fprintf(stderr, "usage: %s get HOST [PORT] [PATH] | eco [PORT] [MAX_CLIENTS]\n", argv[0]);
+	return 1;
+}
diff --git a/linux/waveshare/cxx-ejemplos/stl-demo.cpp b/linux/waveshare/cxx-ejemplos/stl-demo.cpp
new file mode 100644
index 0000000..d0102df
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/stl-demo.cpp
@@ -0,0 +1,125 @@
+// stl-demo - STL containers/algorithms, smart pointers and exceptions on the
+// Waveshare ESP32-P4 v2 board.  Output with <cstdio>: <iostream> alone needs
+// ~543 KB at exec, over the 496 KB block (see board.mk).
+#include <algorithm>
+#include <cstdio>
+#include <map>
+#include <memory>
+#include <numeric>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// An exception type of our own.
+struct SensorError : std::runtime_error {
+	int code;
+	SensorError(const std::string &what, int c) : std::runtime_error(what), code(c) {}
+};
+
+// RAII: the destructor must run while an exception unwinds the stack.
+struct Trace {
+	const char *name;
+	explicit Trace(const char *n) : name(n) { std::printf("  enter %s\n", name); }
+	~Trace() { std::printf("  leave %s (destructor)\n", name); }
+};
+
+static double read_sensor(int id)
+{
+	Trace t("read_sensor");
+	if (id < 0)
+		throw SensorError("sensor " + std::to_string(id) + " does not exist", 404);
+	return 20.0 + id * 0.5;
+}
+
+static std::optional<int> find_first_even(const std::vector<int> &v)
+{
+	auto it = std::find_if(v.begin(), v.end(), [](int x) { return x % 2 == 0; });
+	if (it == v.end())
+		return std::nullopt;
+	return *it;
+}
+
+int main()
+{
+	int failures = 0;
+	auto check = [&](bool ok, const char *what) {
+		std::printf("[%s] %s\n", ok ? "OK" : "FAIL", what);
+		failures += !ok;
+	};
+
+	// Containers and algorithms.
+	std::vector<int> v{42, 7, 19, 3, 88, 1};
+	std::sort(v.begin(), v.end());
+	check(std::is_sorted(v.begin(), v.end()) && v.front() == 1 && v.back() == 88, "vector + sort");
+	check(std::accumulate(v.begin(), v.end(), 0) == 160, "accumulate");
+	check(find_first_even({1, 3, 6, 9}).value_or(-1) == 6 && !find_first_even({1, 3}), "optional + find_if");
+
+	std::map<std::string, int> m{{"tres", 3}, {"uno", 1}, {"dos", 2}};
+	std::string keys;
+	for (const auto &[k, val] : m)
+		keys += k + "=" + std::to_string(val) + " ";
+	check(keys == "dos=2 tres=3 uno=1 ", "map (ordered) + structured bindings");
+
+	std::unordered_map<std::string, std::vector<double>> series;
+	for (int i = 0; i < 100; i++)
+		series["t" + std::to_string(i % 4)].push_back(i * 0.25);
+	check(series.size() == 4 && series["t3"].size() == 25, "unordered_map of vectors");
+
+	// Smart pointers.
+	auto shared = std::make_shared<std::string>("compartido");
+	std::weak_ptr<std::string> weak = shared;
+	{
+		auto copy = shared;
+		check(shared.use_count() == 2, "shared_ptr use_count");
+	}
+	auto owner = std::make_unique<std::vector<int>>(1000, 7);
+	check(owner->size() == 1000 && !weak.expired(), "unique_ptr + weak_ptr");
+	shared.reset();
+	check(weak.expired(), "weak_ptr expires");
+
+	// Exceptions: our own type, through a destructor.
+	try {
+		read_sensor(-3);
+		check(false, "exception expected");
+	} catch (const SensorError &e) {
+		std::printf("  caught SensorError: %s (code %d)\n", e.what(), e.code);
+		check(e.code == 404, "own exception type + unwinding");
+	}
+	// Thrown from inside libstdc++.
+	try {
+		v.at(100);
+		check(false, "out_of_range expected");
+	} catch (const std::out_of_range &) {
+		check(true, "std::out_of_range from vector::at");
+	}
+	try {
+		(void)std::stoi("no es un numero");
+		check(false, "invalid_argument expected");
+	} catch (const std::invalid_argument &e) {
+		check(true, "std::invalid_argument from std::stoi");
+	}
+	try {
+		std::vector<char> huge;
+		huge.reserve(static_cast<size_t>(-1) / 2);
+		check(false, "length_error/bad_alloc expected");
+	} catch (const std::length_error &) {
+		check(true, "std::length_error from reserve");
+	} catch (const std::bad_alloc &) {
+		check(true, "std::bad_alloc from reserve");
+	}
+	// Rethrow and catch by base class.
+	try {
+		try {
+			throw SensorError("anidada", 7);
+		} catch (...) {
+			throw;
+		}
+	} catch (const std::exception &e) {
+		check(std::string(e.what()) == "anidada", "rethrow, catch by std::exception");
+	}
+
+	std::printf("%s: %d failure(s)\n", failures ? "FAILED" : "ALL OK", failures);
+	return failures ? 1 : 0;
+}
diff --git a/linux/waveshare/cxx-ejemplos/threads-demo.cpp b/linux/waveshare/cxx-ejemplos/threads-demo.cpp
new file mode 100644
index 0000000..e47ab86
--- /dev/null
+++ b/linux/waveshare/cxx-ejemplos/threads-demo.cpp
@@ -0,0 +1,94 @@
+// threads-demo - std::thread, std::mutex and std::condition_variable on the
+// Waveshare ESP32-P4 v2 board (uClibc-ng LinuxThreads; see nommu-cxx.c).
+// A bounded queue with 2 producers and 2 consumers; the checksum proves no
+// item was lost or duplicated.
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class BoundedQueue {
+public:
+	explicit BoundedQueue(size_t cap) : cap_(cap) {}
+	void push(int v)
+	{
+		std::unique_lock<std::mutex> l(mu_);
+		not_full_.wait(l, [&] { return q_.size() < cap_; });
+		q_.push_back(v);
+		not_empty_.notify_one();
+	}
+	// false when closed and empty.
+	bool pop(int &v)
+	{
+		std::unique_lock<std::mutex> l(mu_);
+		not_empty_.wait(l, [&] { return !q_.empty() || closed_; });
+		if (q_.empty())
+			return false;
+		v = q_.front();
+		q_.pop_front();
+		not_full_.notify_one();
+		return true;
+	}
+	void close()
+	{
+		std::lock_guard<std::mutex> l(mu_);
+		closed_ = true;
+		not_empty_.notify_all();
+	}
+
+private:
+	std::mutex mu_;
+	std::condition_variable not_full_, not_empty_;
+	std::deque<int> q_;
+	size_t cap_;
+	bool closed_ = false;
+};
+
+int main()
+{
+	const int producers = 2, consumers = 2, per_producer = 5000;
+	BoundedQueue q(16);
+	std::mutex sum_mu;
+	long long sum = 0;
+	long count = 0;
+	auto t0 = std::chrono::steady_clock::now();
+
+	std::vector<std::thread> prod, cons;
+	for (int p = 0; p < producers; p++)
+		prod.emplace_back([&, p] {
+			for (int i = 1; i <= per_producer; i++)
+				q.push(p * per_producer + i);
+		});
+	for (int c = 0; c < consumers; c++)
+		cons.emplace_back([&] {
+			long long local = 0;
+			long n = 0;
+			int v;
+			while (q.pop(v)) {
+				local += v;
+				n++;
+			}
+			std::lock_guard<std::mutex> l(sum_mu);
+			sum += local;
+			count += n;
+		});
+	for (auto &t : prod)
+		t.join();
+	q.close();
+	for (auto &t : cons)
+		t.join();
+
+	long n = static_cast<long>(producers) * per_producer;
+	long long expect = n * (n + 1) / 2;
+	auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+		std::chrono::steady_clock::now() - t0).count();
+	std::printf("hardware_concurrency=%u\n", std::thread::hardware_concurrency());
+	std::printf("%d producers, %d consumers: %ld items, sum=%lld (expect %lld), %lld ms\n",
+		producers, consumers, count, sum, expect, static_cast<long long>(ms));
+	bool ok = count == n && sum == expect;
+	std::printf("%s\n", ok ? "ALL OK" : "FAILED");
+	return ok ? 0 : 1;
+}
