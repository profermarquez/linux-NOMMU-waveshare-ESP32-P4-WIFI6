diff --git a/linux/waveshare/gpio-ejemplo/gpio-parpadeo.c b/linux/waveshare/gpio-ejemplo/gpio-parpadeo.c
new file mode 100644
index 0000000..c16ef10
--- /dev/null
+++ b/linux/waveshare/gpio-ejemplo/gpio-parpadeo.c
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ * gpio-parpadeo - libgpiod 2.x example for the Waveshare ESP32-P4-WIFI6.
+ *
+ *   gpio-parpadeo GPIO [VECES [MS]]          blink a header GPIO (10 x 250 ms)
+ *   gpio-parpadeo -l GPIO [pullup|pulldown]  read it as an input once
+ *
+ * GPIO is the chip pin number printed on the board (2..52).  The P4 has two
+ * GPIO banks, each its own gpiochip: GPIO0..31 -> bank 0 (line = GPIO),
+ * GPIO32..56 -> bank 1 (line = GPIO - 32).  The gpiochip number Linux gives
+ * each bank depends on probe order, so it is looked up from sysfs.
+ *
+ * libgpiod 2 speaks the kernel's GPIO character-device ABI v2 (this kernel
+ * has no ABI v1: CONFIG_GPIO_CDEV_V1 is off, libgpiod 1.x gets EINVAL).
+ *
+ * Wiring for the LED test: GPIO -> 330 ohm -> LED anode, LED cathode -> GND.
+ */
+#include <dirent.h>
+#include <errno.h>
+#include <gpiod.h>
+#include <limits.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static volatile sig_atomic_t stop;
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	stop = 1;
+}
+
+/* "/dev/gpiochipN" of bank 0 or 1, from /sys/bus/platform/devices/... */
+static int bank_chip_path(int bank, char *path, size_t len)
+{
+	char dir[96];
+	struct dirent *e;
+	DIR *d;
+
+	snprintf(dir, sizeof(dir),
+		 "/sys/bus/platform/devices/500e0000.gpio-bank%d", bank);
+	d = opendir(dir);
+	if (!d)
+		return -1;
+	while ((e = readdir(d))) {
+		if (!strncmp(e->d_name, "gpiochip", 8)) {
+			snprintf(path, len, "/dev/%s", e->d_name);
+			closedir(d);
+			return 0;
+		}
+	}
+	closedir(d);
+	return -1;
+}
+
+/*
+ * Request one header GPIO as input (bias) or output (initial value 0).
+ * Returns the request (one line, offset in *line) or NULL.
+ */
+static struct gpiod_line_request *request_gpio(int gpio, int output,
+					       enum gpiod_line_bias bias,
+					       unsigned int *line)
+{
+	struct gpiod_line_request *req = NULL;
+	struct gpiod_request_config *rcfg = NULL;
+	struct gpiod_line_settings *ls = NULL;
+	struct gpiod_line_config *lcfg = NULL;
+	struct gpiod_chip *chip = NULL;
+	char path[PATH_MAX];
+	int bank = gpio >= 32;
+
+	if (gpio < 0 || gpio > 56) {
+		fprintf(stderr, "GPIO %d out of range (0..56)\n", gpio);
+		return NULL;
+	}
+	if (bank_chip_path(bank, path, sizeof(path))) {
+		fprintf(stderr, "GPIO bank %d is not registered (DTB without it?)\n", bank);
+		return NULL;
+	}
+	*line = gpio - 32 * bank;
+
+	chip = gpiod_chip_open(path);
+	if (!chip) {
+		fprintf(stderr, "%s: %s\n", path, strerror(errno));
+		return NULL;
+	}
+	ls = gpiod_line_settings_new();
+	lcfg = gpiod_line_config_new();
+	rcfg = gpiod_request_config_new();
+	if (!ls || !lcfg || !rcfg) {
+		fprintf(stderr, "out of memory\n");
+		goto out;
+	}
+	if (output) {
+		gpiod_line_settings_set_direction(ls, GPIOD_LINE_DIRECTION_OUTPUT);
+		gpiod_line_settings_set_output_value(ls, GPIOD_LINE_VALUE_INACTIVE);
+	} else {
+		gpiod_line_settings_set_direction(ls, GPIOD_LINE_DIRECTION_INPUT);
+		gpiod_line_settings_set_bias(ls, bias);
+	}
+	if (gpiod_line_config_add_line_settings(lcfg, line, 1, ls)) {
+		fprintf(stderr, "line config: %s\n", strerror(errno));
+		goto out;
+	}
+	gpiod_request_config_set_consumer(rcfg, "gpio-parpadeo");
+	req = gpiod_chip_request_lines(chip, rcfg, lcfg);
+	if (!req)
+		fprintf(stderr, "GPIO%d: %s (reserved or in use?)\n", gpio, strerror(errno));
+out:
+	if (rcfg)
+		gpiod_request_config_free(rcfg);
+	if (lcfg)
+		gpiod_line_config_free(lcfg);
+	if (ls)
+		gpiod_line_settings_free(ls);
+	gpiod_chip_close(chip);	/* the request keeps its own file descriptor */
+	return req;
+}
+
+int main(int argc, char **argv)
+{
+	struct gpiod_line_request *req;
+	unsigned int line;
+
+	if (argc >= 3 && !strcmp(argv[1], "-l")) {
+		enum gpiod_line_bias bias = GPIOD_LINE_BIAS_AS_IS;
+		enum gpiod_line_value v;
+
+		if (argc > 3 && !strcmp(argv[3], "pullup"))
+			bias = GPIOD_LINE_BIAS_PULL_UP;
+		else if (argc > 3 && !strcmp(argv[3], "pulldown"))
+			bias = GPIOD_LINE_BIAS_PULL_DOWN;
+		req = request_gpio(atoi(argv[2]), 0, bias, &line);
+		if (!req)
+			return 1;
+		v = gpiod_line_request_get_value(req, line);
+		gpiod_line_request_release(req);
+		if (v == GPIOD_LINE_VALUE_ERROR) {
+			fprintf(stderr, "read: %s\n", strerror(errno));
+			return 1;
+		}
+		printf("GPIO%s = %d\n", argv[2], v == GPIOD_LINE_VALUE_ACTIVE);
+		return 0;
+	}
+
+	if (argc < 2 || argc > 4) {
+		fprintf(stderr, "usage: %s GPIO [TIMES [MS]] | -l GPIO [pullup|pulldown]\n", argv[0]);
+		return 2;
+	}
+	int gpio = atoi(argv[1]);
+	int times = argc > 2 ? atoi(argv[2]) : 10;
+	int ms = argc > 3 ? atoi(argv[3]) : 250;
+
+	req = request_gpio(gpio, 1, GPIOD_LINE_BIAS_AS_IS, &line);
+	if (!req)
+		return 1;
+	signal(SIGINT, on_signal);
+	signal(SIGTERM, on_signal);
+	printf("blinking GPIO%d: %d times, %d ms (Ctrl-C stops)\n", gpio, times, ms);
+	for (int i = 0; i < times && !stop; i++) {
+		gpiod_line_request_set_value(req, line, GPIOD_LINE_VALUE_ACTIVE);
+		usleep(ms * 1000);
+		gpiod_line_request_set_value(req, line, GPIOD_LINE_VALUE_INACTIVE);
+		usleep(ms * 1000);
+	}
+	gpiod_line_request_release(req);	/* output stays low */
+	return 0;
+}
diff --git a/linux/waveshare/https-get/https-get.c b/linux/waveshare/https-get/https-get.c
new file mode 100644
index 0000000..2e40374
--- /dev/null
+++ b/linux/waveshare/https-get/https-get.c
@@ -0,0 +1,434 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * https-get — fetch an https:// URL with certificate validation (mbedTLS).
+ * Waveshare ESP32-P4-WIFI6 Linux v2.
+ *
+ *   https-get [-q] [-v] [-S] [-o FILE] [-c CAFILE] [-t SECONDS] URL
+ *
+ *   -o FILE   write the body to FILE ("-" = stdout, the default)
+ *   -q        quiet: no progress/diagnostics on stderr (errors still shown)
+ *   -v        verbose: TLS version, cipher suite, peer certificate
+ *   -S        print the response headers on stderr
+ *   -c FILE   CA bundle (default /etc/ssl/certs/ca-certificates.crt)
+ *   -t SECS   network timeout (default 15)
+ *
+ * The server certificate chain is always verified against the CA bundle and
+ * the host name (SNI + subjectAltName/CN).  There is no option to skip the
+ * check.  Redirects (301/302/303/307/308) to https:// are followed (max 5).
+ *
+ * Exit status: 0 OK, 1 usage, 2 network/DNS, 3 TLS or certificate,
+ *              4 HTTP error status (>= 400) or bad response, 5 output file.
+ */
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include "mbedtls/ctr_drbg.h"
+#include "mbedtls/entropy.h"
+#include "mbedtls/error.h"
+#include "mbedtls/net_sockets.h"
+#include "mbedtls/ssl.h"
+#include "mbedtls/version.h"
+#include "mbedtls/x509_crt.h"
+#include "psa/crypto.h"
+
+#define DEFAULT_CA	"/etc/ssl/certs/ca-certificates.crt"
+#define MAX_REDIRECTS	5
+
+static int quiet, verbose, show_headers;
+static unsigned timeout_ms = 15000;
+
+static void info(const char *fmt, ...)
+{
+	va_list ap;
+
+	if (quiet)
+		return;
+	va_start(ap, fmt);
+	fputs("https-get: ", stderr);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+}
+
+static void err(const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	fputs("https-get: ", stderr);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+}
+
+/* The image's mbedTLS is built without MBEDTLS_ERROR_C (size): name the
+ * errors a user actually meets here, give the code for the rest. */
+static const char *tls_reason(int rc)
+{
+	switch (rc) {
+	case MBEDTLS_ERR_NET_UNKNOWN_HOST: return "cannot resolve host name (DNS)";
+	case MBEDTLS_ERR_NET_CONNECT_FAILED: return "connection failed";
+	case MBEDTLS_ERR_NET_SOCKET_FAILED: return "cannot create socket";
+	case MBEDTLS_ERR_NET_RECV_FAILED: return "receive failed";
+	case MBEDTLS_ERR_NET_SEND_FAILED: return "send failed";
+	case MBEDTLS_ERR_NET_CONN_RESET: return "connection reset by peer";
+	case MBEDTLS_ERR_SSL_TIMEOUT: return "timed out";
+	case MBEDTLS_ERR_SSL_FATAL_ALERT_MESSAGE: return "server sent a fatal alert";
+	case MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE:
+		return "handshake failure (no common TLS 1.2 cipher/version?)";
+	case MBEDTLS_ERR_SSL_BAD_PROTOCOL_VERSION:
+		return "unsupported protocol version (server may need TLS 1.3)";
+	case MBEDTLS_ERR_SSL_ALLOC_FAILED: return "out of memory";
+	case MBEDTLS_ERR_X509_ALLOC_FAILED: return "out of memory";
+	case MBEDTLS_ERR_X509_FILE_IO_ERROR: return "cannot read file";
+	default: break;
+	}
+	return NULL;
+}
+
+static void tls_err(const char *what, int rc)
+{
+	char b[160];
+	const char *r = tls_reason(rc);
+
+	if (!r) {
+		mbedtls_strerror(rc, b, sizeof(b));
+		r = b[0] ? b : "mbedTLS error";
+	}
+	err("%s: %s (-0x%04x)\n", what, r, (unsigned)-rc);
+}
+
+struct url {
+	char host[256];
+	char port[8];
+	char path[1024];
+};
+
+static int parse_url(const char *u, struct url *o)
+{
+	const char *h, *p, *s;
+	size_t n;
+
+	if (strncasecmp(u, "https://", 8) != 0)
+		return -1;
+	h = u + 8;
+	s = strchr(h, '/');
+	if (!s)
+		s = h + strlen(h);
+	p = memchr(h, ':', s - h);
+	n = (p ? p : s) - h;
+	if (n == 0 || n >= sizeof(o->host))
+		return -1;
+	memcpy(o->host, h, n);
+	o->host[n] = '\0';
+	if (p) {
+		n = s - p - 1;
+		if (n == 0 || n >= sizeof(o->port))
+			return -1;
+		memcpy(o->port, p + 1, n);
+		o->port[n] = '\0';
+	} else {
+		strcpy(o->port, "443");
+	}
+	snprintf(o->path, sizeof(o->path), "%s", *s ? s : "/");
+	return 0;
+}
+
+static mbedtls_entropy_context entropy;
+static mbedtls_ctr_drbg_context drbg;
+static mbedtls_x509_crt cacert;
+static mbedtls_ssl_config conf;
+
+static int setup(const char *cafile)
+{
+	int rc;
+#if defined(MBEDTLS_SSL_PROTO_TLS1_3) || defined(MBEDTLS_USE_PSA_CRYPTO)
+	psa_status_t ps = psa_crypto_init();	/* TLS 1.3 / PSA builds only */
+
+	if (ps != PSA_SUCCESS) {
+		err("psa_crypto_init failed (%d)\n", (int)ps);
+		return 3;
+	}
+#endif
+	mbedtls_entropy_init(&entropy);
+	mbedtls_ctr_drbg_init(&drbg);
+	rc = mbedtls_ctr_drbg_seed(&drbg, mbedtls_entropy_func, &entropy,
+				   (const unsigned char *)"https-get", 9);
+	if (rc) {
+		tls_err("random generator", rc);
+		return 3;
+	}
+	mbedtls_x509_crt_init(&cacert);
+	rc = mbedtls_x509_crt_parse_file(&cacert, cafile);
+	if (rc < 0) {
+		tls_err(cafile, rc);
+		return 3;
+	}
+	if (verbose)
+		info("CA bundle %s loaded (%d certificate(s) skipped)\n", cafile, rc);
+	mbedtls_ssl_config_init(&conf);
+	rc = mbedtls_ssl_config_defaults(&conf, MBEDTLS_SSL_IS_CLIENT,
+					 MBEDTLS_SSL_TRANSPORT_STREAM,
+					 MBEDTLS_SSL_PRESET_DEFAULT);
+	if (rc) {
+		tls_err("ssl config", rc);
+		return 3;
+	}
+	mbedtls_ssl_conf_authmode(&conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+	mbedtls_ssl_conf_ca_chain(&conf, &cacert, NULL);
+	mbedtls_ssl_conf_rng(&conf, mbedtls_ctr_drbg_random, &drbg);
+	mbedtls_ssl_conf_read_timeout(&conf, timeout_ms);
+	return 0;
+}
+
+/* Read one header line (CRLF stripped).  Returns length, -1 on EOF/error. */
+static int read_line(mbedtls_ssl_context *ssl, char *buf, size_t cap)
+{
+	size_t n = 0;
+
+	for (;;) {
+		unsigned char c;
+		int r = mbedtls_ssl_read(ssl, &c, 1);
+
+		if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+		if (r <= 0)
+			return n ? (int)n : -1;
+		if (c == '\n')
+			break;
+		if (c != '\r' && n + 1 < cap)
+			buf[n++] = c;
+	}
+	buf[n] = '\0';
+	return (int)n;
+}
+
+/* One request.  *location gets a redirect target (malloc'ed) if any. */
+static int fetch(const struct url *u, FILE *out, char **location)
+{
+	mbedtls_net_context net;
+	mbedtls_ssl_context ssl;
+	char req[1400], line[2048];
+	unsigned flags;
+	int rc, status = 0, ret = 0;
+	long long got = 0, clen = -1;
+
+	*location = NULL;
+	mbedtls_net_init(&net);
+	mbedtls_ssl_init(&ssl);
+
+	info("connecting to %s:%s\n", u->host, u->port);
+	rc = mbedtls_net_connect(&net, u->host, u->port, MBEDTLS_NET_PROTO_TCP);
+	if (rc) {
+		tls_err(u->host, rc);
+		ret = 2;
+		goto out;
+	}
+	rc = mbedtls_ssl_setup(&ssl, &conf);
+	if (!rc)
+		rc = mbedtls_ssl_set_hostname(&ssl, u->host);	/* SNI + name check */
+	if (rc) {
+		tls_err("ssl setup", rc);
+		ret = 3;
+		goto out;
+	}
+	mbedtls_ssl_set_bio(&ssl, &net, mbedtls_net_send, NULL, mbedtls_net_recv_timeout);
+
+	while ((rc = mbedtls_ssl_handshake(&ssl)) != 0) {
+		if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+		flags = mbedtls_ssl_get_verify_result(&ssl);
+		if (rc == MBEDTLS_ERR_X509_CERT_VERIFY_FAILED && flags) {
+			char vb[512];
+
+			mbedtls_x509_crt_verify_info(vb, sizeof(vb), "  ", flags);
+			err("certificate verification FAILED for %s:\n%s", u->host, vb);
+		} else {
+			tls_err("TLS handshake", rc);
+		}
+		ret = 3;
+		goto out;
+	}
+	if (verbose) {
+		const mbedtls_x509_crt *peer = mbedtls_ssl_get_peer_cert(&ssl);
+
+		info("%s, %s, certificate verified for %s\n",
+		     mbedtls_ssl_get_version(&ssl), mbedtls_ssl_get_ciphersuite(&ssl),
+		     u->host);
+		if (peer) {
+			char cb[1024];
+
+			mbedtls_x509_crt_info(cb, sizeof(cb), "  ", peer);
+			fputs(cb, stderr);
+		}
+	}
+
+	snprintf(req, sizeof(req),
+		 "GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: https-get/1.0 (mbedTLS %s)\r\n"
+		 "Accept: */*\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n",
+		 u->path, u->host, MBEDTLS_VERSION_STRING);
+	for (size_t off = 0, len = strlen(req); off < len;) {
+		rc = mbedtls_ssl_write(&ssl, (unsigned char *)req + off, len - off);
+		if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+		if (rc < 0) {
+			tls_err("send", rc);
+			ret = 2;
+			goto out;
+		}
+		off += rc;
+	}
+
+	/* Status line and headers. */
+	if (read_line(&ssl, line, sizeof(line)) < 0 ||
+	    sscanf(line, "HTTP/%*s %d", &status) != 1) {
+		err("bad or empty HTTP response\n");
+		ret = 4;
+		goto out;
+	}
+	if (show_headers)
+		fprintf(stderr, "%s\n", line);
+	for (;;) {
+		int n = read_line(&ssl, line, sizeof(line));
+
+		if (n < 0) {
+			err("connection closed inside the headers\n");
+			ret = 4;
+			goto out;
+		}
+		if (n == 0)
+			break;
+		if (show_headers)
+			fprintf(stderr, "%s\n", line);
+		if (!strncasecmp(line, "Content-Length:", 15))
+			clen = atoll(line + 15);
+		else if (!strncasecmp(line, "Location:", 9)) {
+			char *v = line + 9;
+
+			while (*v == ' ' || *v == '\t')
+				v++;
+			free(*location);
+			*location = strdup(v);
+		}
+	}
+	info("HTTP %d\n", status);
+	if (status >= 300 && status < 400 && *location) {
+		ret = -1;		/* redirect */
+		goto out;
+	}
+	free(*location);
+	*location = NULL;
+
+	/* Body. */
+	for (;;) {
+		unsigned char b[1024];
+
+		rc = mbedtls_ssl_read(&ssl, b, sizeof(b));
+		if (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE)
+			continue;
+		if (rc == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY || rc == 0)
+			break;
+		if (rc < 0) {
+			/* Many servers just close TCP after the body. */
+			if (clen < 0 || got >= clen)
+				break;
+			tls_err("receive", rc);
+			ret = 2;
+			goto out;
+		}
+		if (fwrite(b, 1, rc, out) != (size_t)rc) {
+			err("write: %s\n", strerror(errno));
+			ret = 5;
+			goto out;
+		}
+		got += rc;
+		if (clen >= 0 && got >= clen)
+			break;
+	}
+	if (clen >= 0 && got < clen) {
+		err("short body: %lld of %lld bytes\n", got, clen);
+		ret = 2;
+	} else {
+		info("%lld bytes\n", got);
+	}
+	if (!ret && status >= 400)
+		ret = 4;
+	mbedtls_ssl_close_notify(&ssl);
+out:
+	mbedtls_ssl_free(&ssl);
+	mbedtls_net_free(&net);
+	return ret;
+}
+
+int main(int argc, char **argv)
+{
+	const char *cafile = DEFAULT_CA, *outname = "-";
+	struct url u;
+	FILE *out = stdout;
+	int o, rc;
+
+	while ((o = getopt(argc, argv, "qvSo:c:t:h")) != -1) {
+		switch (o) {
+		case 'q': quiet = 1; break;
+		case 'v': verbose = 1; break;
+		case 'S': show_headers = 1; break;
+		case 'o': outname = optarg; break;
+		case 'c': cafile = optarg; break;
+		case 't': timeout_ms = (unsigned)atoi(optarg) * 1000u; break;
+		default:
+			fprintf(stderr, "usage: %s [-q] [-v] [-S] [-o FILE] [-c CAFILE] [-t SECS] https://HOST[:PORT]/PATH\n", argv[0]);
+			return 1;
+		}
+	}
+	if (optind != argc - 1 || parse_url(argv[optind], &u) != 0) {
+		fprintf(stderr, "usage: %s [-q] [-v] [-S] [-o FILE] [-c CAFILE] [-t SECS] https://HOST[:PORT]/PATH\n", argv[0]);
+		return 1;
+	}
+	if (quiet && verbose)
+		quiet = 0;
+	rc = setup(cafile);
+	if (rc)
+		return rc;
+	if (strcmp(outname, "-") != 0) {
+		out = fopen(outname, "wb");
+		if (!out) {
+			err("%s: %s\n", outname, strerror(errno));
+			return 5;
+		}
+	}
+	for (int hop = 0;; hop++) {
+		char *loc = NULL;
+
+		rc = fetch(&u, out, &loc);
+		if (rc != -1)
+			break;
+		if (hop >= MAX_REDIRECTS) {
+			err("too many redirects\n");
+			free(loc);
+			rc = 4;
+			break;
+		}
+		if (loc[0] == '/') {
+			snprintf(u.path, sizeof(u.path), "%s", loc);
+		} else if (parse_url(loc, &u) != 0) {
+			err("redirect to a non-https URL refused: %s\n", loc);
+			free(loc);
+			rc = 4;
+			break;
+		}
+		info("redirect -> https://%s%s\n", u.host, u.path);
+		free(loc);
+	}
+	if (out != stdout && fclose(out) != 0 && !rc)
+		rc = 5;
+	if (rc && out != stdout)
+		unlink(outname);
+	mbedtls_x509_crt_free(&cacert);
+	mbedtls_ssl_config_free(&conf);
+	mbedtls_ctr_drbg_free(&drbg);
+	mbedtls_entropy_free(&entropy);
+	return rc;
+}
diff --git a/linux/waveshare/kernel.config.fragment b/linux/waveshare/kernel.config.fragment
new file mode 100644
index 0000000..b3f33d7
--- /dev/null
+++ b/linux/waveshare/kernel.config.fragment
@@ -0,0 +1,28 @@
+# Waveshare ESP32-P4-WIFI6 v2 additions (appended after the m3-lab fragment).
+#
+# microSD over a bit-banged SPI bus (spi-gpio + mmc_spi).  The SDMMC
+# controller's single active slot (dw_mmc snps,slot-id) belongs to the C6, so
+# the card slot (GPIO39..44) is driven through GPIOs instead.  See the
+# spi-gpio node in the DTS.
+CONFIG_SPI=y
+CONFIG_SPI_MASTER=y
+CONFIG_SPI_GPIO=y
+CONFIG_MMC_SPI=y
+# ext4 driver (also mounts ext2/ext3).  The board cannot create ext4 itself
+# (e2fsprogs needs an MMU); BusyBox mke2fs creates ext2.
+CONFIG_EXT4_FS=y
+# CONFIG_EXT4_FS_POSIX_ACL is not set
+# CONFIG_EXT4_FS_SECURITY is not set
+
+# v2 phase 7 (on hold, see build-m1.sh): with TSENS_LINUX=1 the LP-TSENS
+# thermal zone also appears as /sys/class/hwmon/hwmonN/temp1_input.  Has no
+# effect while CONFIG_THERMAL is off.
+CONFIG_THERMAL_HWMON=y
+
+# v2 phase 9: I2C and SPI for the header, bit-banged over the GPIO driver
+# (no ESP32-P4 I2C/SPI controller driver in this kernel).  Stock drivers:
+# i2c-gpio + /dev/i2c-N (i2c-tools), spidev (/dev/spidevB.C).
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_GPIO=y
+CONFIG_SPI_SPIDEV=y
diff --git a/linux/waveshare/post-build.sh b/linux/waveshare/post-build.sh
new file mode 100755
index 0000000..6f7d930
--- /dev/null
+++ b/linux/waveshare/post-build.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Waveshare ESP32-P4-WIFI6 post-build: runs after the Stamp-P4/m3-lab scripts.
+set -eu
+TARGET_DIR=$1
+for f in "${TARGET_DIR}/etc/init.d/S40network" "${TARGET_DIR}/usr/sbin/wifi-connect" "${TARGET_DIR}/usr/sbin/boot-save" "${TARGET_DIR}/etc/init.d/S06sd" "${TARGET_DIR}/etc/init.d/S07time" "${TARGET_DIR}/usr/sbin/time-sync" "${TARGET_DIR}/usr/share/udhcpc/default.script.d/50ntp" "${TARGET_DIR}"/usr/sbin/wifi-* "${TARGET_DIR}"/usr/sbin/ap-* "${TARGET_DIR}/usr/bin/wget" "${TARGET_DIR}/usr/bin/temperatura" "${TARGET_DIR}/usr/bin/pin"; do
+	[ -f "$f" ] && chmod 0755 "$f"
+done
+# Board identity for the login banner and scripts.
+mkdir -p "${TARGET_DIR}/etc/board"
+printf "%s\n" "Waveshare ESP32-P4-WIFI6" >"${TARGET_DIR}/etc/board/model"
+# v2: microSD mount point (S06sd).
+mkdir -p "${TARGET_DIR}/mnt/sd" "${TARGET_DIR}/mnt/archivos"
+# v2: time zone.  uClibc reads the POSIX TZ string from /etc/TZ; the rootfs
+# is read-only, so it points at /run/TZ (written by S07time / time-sync tz).
+ln -sfn ../run/TZ "${TARGET_DIR}/etc/TZ"
diff --git a/linux/waveshare/rootfs-overlay/etc/init.d/S06sd b/linux/waveshare/rootfs-overlay/etc/init.d/S06sd
new file mode 100755
index 0000000..238cace
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/init.d/S06sd
@@ -0,0 +1,176 @@
+#!/bin/sh
+# Waveshare ESP32-P4-WIFI6 v2: microSD persistence.
+#
+# The card is reached over a bit-banged SPI bus (spi-gpio + mmc_spi).  Only a
+# filesystem labelled WSDATA is used, so a card with someone else's data is
+# never mounted read-write by accident.  Layout on the card:
+#
+#   /mnt/sd/persist/config/   credentials.txt authorized_keys
+#                             root_authorized_keys wifi-sta.conf
+#                             config.txt (ntp_server=, timezone=, ...)
+#                             wifi-networks.conf ap.conf (Wi-Fi, v2)
+#   /mnt/sd/persist/home/m5/  bind-mounted on /home/m5 (ext2/ext4 only)
+#
+# A FAT32 partition labelled WSFILES is mounted on /mnt/archivos (owner m5,
+# no access for other users: wifi.txt there holds Wi-Fi passphrases) for files
+# to share with a computer.
+#
+# start: mount the card, make the card's copy of the config files the one in
+#        effect (seed the card from /boot the first time), apply passwords and
+#        SSH keys, bind /home/m5.
+# stop:  sync and unmount (run from inittab ::shutdown).
+#
+# Runs after S05tmpfs (which applies /boot first) and before S40network /
+# S85ssh, which then pick up the card's Wi-Fi file and keys.
+
+LABEL=WSDATA
+FILES_LABEL=WSFILES
+FILES_MNT=/mnt/archivos
+MNT=/mnt/sd
+P=$MNT/persist
+CFG_FILES="credentials.txt authorized_keys root_authorized_keys wifi-sta.conf config.txt wifi-networks.conf ap.conf"
+WAIT_S=8
+
+log() { echo "WS-SD: $*"; }
+es_log() { echo "$1"; }
+
+# Read filesystem type and label straight from the partition: the BusyBox
+# blkid on this image is built without volume-id support.
+#   ext2/3/4: magic 0xEF53 at 1080, label (16 bytes) at 1144
+#   FAT32:    "FAT32" at 82, volume label (11 bytes) at 71
+part_info() {
+	d=$1
+	magic=$(dd if="$d" bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
+	if [ "$magic" = "53ef" ]; then
+		lbl=$(dd if="$d" bs=1 skip=1144 count=16 2>/dev/null | tr -d '\000')
+		echo "ext $lbl"
+		return 0
+	fi
+	fat=$(dd if="$d" bs=1 skip=82 count=5 2>/dev/null)
+	if [ "$fat" = "FAT32" ]; then
+		lbl=$(dd if="$d" bs=1 skip=71 count=11 2>/dev/null | tr -d '\000' | sed 's/ *$//')
+		echo "vfat $lbl"
+		return 0
+	fi
+	echo "unknown"
+}
+
+# find_dev LABEL -> "/dev/mmcblkXpN type"
+find_dev() {
+	for sys in /sys/block/mmcblk*/mmcblk*p*; do
+		[ -e "$sys" ] || continue
+		dev=/dev/${sys##*/}
+		set -- $(part_info "$dev")
+		if [ "${2:-}" = "$want" ]; then
+			echo "$dev $1"
+			return 0
+		fi
+	done
+}
+
+mount_boot() {
+	grep -q '^[^ ]* /boot ' /proc/mounts && return 0
+	[ -f /tmp/boot.img ] || return 1
+	mount -t vfat -o loop,rw,sync,umask=0077 /tmp/boot.img /boot
+}
+
+start() {
+	n=0
+	while [ "$n" -lt "$WAIT_S" ] && ! ls /sys/block 2>/dev/null | grep -q '^mmcblk'; do
+		n=$((n + 1)); sleep 1
+	done
+	want=$LABEL
+	set -- $(find_dev)
+	dev=${1:-}; fstype=${2:-}
+	if [ -z "$dev" ]; then
+		if ls /sys/block 2>/dev/null | grep -q '^mmcblk'; then
+			log "card present but no $LABEL filesystem: not mounted (see GUIA-DE-USO)"
+		else
+			log "no microSD card detected"
+		fi
+		return 0
+	fi
+	mkdir -p "$MNT"
+	case "$fstype" in
+		ext|ext2|ext3|ext4) opts=noatime; mt=ext4 ;;
+		vfat) opts=noatime,uid=0,gid=0,fmask=0077,dmask=0077; mt=vfat ;;
+		*) log "unsupported filesystem '$fstype' on $dev"; return 1 ;;
+	esac
+	if ! grep -q " $MNT " /proc/mounts; then
+		mount -t "$mt" -o "$opts" "$dev" "$MNT" || { log "ERROR: mount $dev failed"; return 1; }
+	fi
+	log "mounted $dev ($fstype) on $MNT"
+	umask 077
+	mkdir -p "$P/config" "$P/home"
+
+	# The card holds the configuration in effect; /boot (flash) is the
+	# fallback when there is no card.  Seed the card from /boot once.
+	if mount_boot; then
+		for f in $CFG_FILES; do
+			if [ -s "$P/config/$f" ]; then
+				cp -f "$P/config/$f" "/boot/$f"
+			elif [ -s "/boot/$f" ]; then
+				cp -f "/boot/$f" "$P/config/$f"
+			fi
+		done
+		sync
+	else
+		log "WARNING: /boot not available; card config not applied"
+	fi
+
+	# Home directory (needs POSIX ownership: ext2/ext4 only).
+	if [ "$mt" = ext4 ]; then
+		if [ ! -d "$P/home/m5" ]; then
+			mkdir -p "$P/home/m5"
+			[ -d /home/m5 ] && cp -a /home/m5/. "$P/home/m5/" 2>/dev/null
+			chown -R 1000:1000 "$P/home/m5"
+			chmod 755 "$P/home/m5"
+		fi
+		if ! grep -q ' /home/m5 ' /proc/mounts; then
+			mount --bind "$P/home/m5" /home/m5 && log "/home/m5 is on the card"
+		fi
+	else
+		log "FAT card: /home/m5 stays in RAM (no file ownership on FAT)"
+	fi
+
+	want=$FILES_LABEL
+	set -- $(find_dev)
+	if [ -n "${1:-}" ] && [ "${2:-}" = vfat ] && ! grep -q " $FILES_MNT " /proc/mounts; then
+		mkdir -p "$FILES_MNT"
+		if mount -t vfat -o noatime,uid=1000,gid=1000,fmask=0077,dmask=0077 "$1" "$FILES_MNT"; then
+			log "mounted $1 ($FILES_LABEL) on $FILES_MNT"
+			# Template for wifi.txt, visible from a computer.
+			[ -f "$FILES_MNT/wifi-ejemplo.txt" ] ||
+				cp /usr/share/board/wifi-ejemplo.txt "$FILES_MNT/" 2>/dev/null
+		fi
+	fi
+
+	if [ -r /usr/lib/board/credentials.sh ]; then
+		. /usr/lib/board/credentials.sh
+		apply_password /boot/credentials.txt || true
+		apply_root_password /boot/credentials.txt || true
+		install_keys /boot/authorized_keys || true
+		install_root_keys /boot/root_authorized_keys || true
+	fi
+}
+
+stop() {
+	sync
+	grep -q " $FILES_MNT " /proc/mounts && umount "$FILES_MNT" 2>/dev/null
+	grep -q " $MNT " /proc/mounts || return 0
+	grep -q ' /home/m5 ' /proc/mounts && umount /home/m5 2>/dev/null
+	if umount "$MNT" 2>/dev/null; then
+		log "unmounted $MNT"
+	else
+		mount -o remount,ro "$MNT" 2>/dev/null
+		log "WARNING: $MNT busy; remounted read-only"
+	fi
+}
+
+case "${1:-start}" in
+	start) start ;;
+	stop) stop ;;
+	restart) stop; start ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
+exit 0
diff --git a/linux/waveshare/rootfs-overlay/etc/init.d/S07time b/linux/waveshare/rootfs-overlay/etc/init.d/S07time
new file mode 100755
index 0000000..01bf9a6
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/init.d/S07time
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Waveshare v2: apply the time zone (/etc/TZ -> /run/TZ) after S06sd has put
+# the card's config.txt in /boot.  The clock itself is set by time-sync when
+# Wi-Fi gets a lease (udhcpc hook 50ntp).
+case "${1:-start}" in
+	start|restart|reload) /usr/sbin/time-sync tz ;;
+	stop) ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
+exit 0
diff --git a/linux/waveshare/rootfs-overlay/etc/init.d/S40network b/linux/waveshare/rootfs-overlay/etc/init.d/S40network
new file mode 100755
index 0000000..473f4ce
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/init.d/S40network
@@ -0,0 +1,161 @@
+#!/bin/sh
+# Waveshare ESP32-P4-WIFI6 network bring-up (replaces the Stamp-P4 m3-lab
+# NG/wpa_supplicant script).
+#
+# The on-board ESP32-C6 runs ESP-Hosted-MCU 3.0.10.  Linux side:
+#   esp_hosted_mcu.ko  -> ethsta0 (802.3 netdev) + /dev/esps0 (RPC channel)
+#   eh-wifid           -> v2 Wi-Fi manager, the only user of /dev/esps0:
+#                         station (known networks in priority order), scan,
+#                         soft-AP on ethap0 (192.168.4.1, udhcpd) as fallback
+#                         when no known network is reachable, control socket
+#                         /run/eh-wifid.sock (wifi-*, ap-* via eh-wifictl)
+#   udhcpc             -> IPv4 on ethsta0
+#
+# Networks, in priority order:
+#   /mnt/archivos/wifi.txt     edited on a computer (microSD FAT partition)
+#   /boot/wifi-networks.conf   wifi-connect / wifi-forget (also on the card)
+# The v1 /boot/wifi-sta.conf is imported into wifi-networks.conf once.
+# Soft-AP: /boot/ap.conf (created with a random passphrase the first time).
+# Nothing here prints a passphrase.
+#
+# No "set -e": every step handles its own failure (see the Stamp-P4 #41 note).
+
+if [ -z "${ES_SYSMARK:-}" ] && [ -x /usr/sbin/run-system ]; then
+	ES_SYSMARK=1 exec /usr/sbin/run-system "$0" "$@"
+fi
+
+IFACE=ethsta0
+MOD=esp_hosted_mcu
+V1_CONF=/boot/wifi-sta.conf
+NETS=/boot/wifi-networks.conf
+APCONF=/boot/ap.conf
+WIFI_TXT=/mnt/archivos/wifi.txt
+STA_PID=/run/eh-wifid.pid
+STA_SUP=/run/.eh-wifid-sup
+DHCP_PID=/run/udhcpc.ethsta0.pid
+LOG=/run/eh-wifid.log
+
+log() { echo "WS-NET: $*"; }
+
+load_module() {
+	if grep -q "^$MOD " /proc/modules; then
+		return 0
+	fi
+	krel=""
+	read -r krel < /proc/sys/kernel/osrelease
+	ko=""
+	for d in updates extra; do
+		[ -f "/lib/modules/$krel/$d/$MOD.ko" ] && ko="/lib/modules/$krel/$d/$MOD.ko" && break
+	done
+	[ -n "$ko" ] || { log "ERROR: $MOD.ko not found under /lib/modules/$krel"; return 1; }
+	mhz=5
+	[ -r /etc/board/sdio-clock-mhz ] && read -r mhz < /etc/board/sdio-clock-mhz
+	if insmod "$ko" "clockspeed=$mhz"; then
+		log "loaded $MOD clockspeed=${mhz}MHz"
+	else
+		log "ERROR: insmod $ko failed rc=$?"
+		return 1
+	fi
+	# Nothing loads lazily later (Stamp-P4 #40): no /sbin/modprobe forks.
+	echo > /proc/sys/kernel/modprobe 2>/dev/null || true
+}
+
+# The m3-lab S05 mounts /tmp/boot.img on /boot, reads it and unmounts it again
+# (ES_BOOT_FS SYNC_UMOUNT) so the Stamp-P4 can export it as a USB drive.  The
+# Waveshare has no USB drive for it, so keep the RAM copy mounted on /boot:
+# wifi-connect, boot-save and the user edit it there.
+mount_boot() {
+	grep -q '^[^ ]* /boot ' /proc/mounts && return 0
+	[ -f /tmp/boot.img ] || { log "ERROR: /tmp/boot.img missing"; return 1; }
+	if mount -t vfat -o loop,rw,sync,umask=0077 /tmp/boot.img /boot; then
+		log "mounted /tmp/boot.img on /boot"
+	else
+		log "ERROR: cannot mount /tmp/boot.img on /boot"
+		return 1
+	fi
+}
+
+wait_iface() {
+	n=0
+	while [ "$n" -lt 30 ]; do
+		[ -d "/sys/class/net/$IFACE" ] && return 0
+		n=$((n + 1))
+		sleep 1
+	done
+	return 1
+}
+
+stop_sta() {
+	if [ -f "$STA_SUP" ]; then
+		read -r p < "$STA_SUP" 2>/dev/null && kill "$p" 2>/dev/null
+		rm -f "$STA_SUP"
+	fi
+	if [ -f "$STA_PID" ]; then
+		read -r p < "$STA_PID" 2>/dev/null && kill "$p" 2>/dev/null
+		rm -f "$STA_PID"
+	fi
+	if [ -f "$DHCP_PID" ]; then
+		read -r p < "$DHCP_PID" 2>/dev/null && kill "$p" 2>/dev/null
+		rm -f "$DHCP_PID"
+	fi
+	sleep 1
+}
+
+start_sta() {
+	mount_boot
+	umask 077
+	. /usr/lib/board/wifi-lib.sh
+	if [ ! -f "$NETS" ] && [ -s "$V1_CONF" ]; then
+		wl_boot_rw && cp -f "$V1_CONF" "$NETS" && wl_boot_done &&
+			log "imported $V1_CONF into $NETS"
+	fi
+	if [ ! -s "$APCONF" ]; then
+		wl_boot_rw && wl_ap_init && wl_boot_done && log "created $APCONF (see ap-config)"
+	fi
+	[ -f "$WIFI_TXT" ] && log "using $WIFI_TXT from the microSD"
+	ifconfig "$IFACE" up 2>/dev/null || true
+	# The log names networks: private.  The daemons themselves run with
+	# the usual umask, or udhcpc writes resolv.conf 0600 and only root can
+	# resolve names.
+	: >>"$LOG"
+	umask 022
+	# eh-wifid must stay resident; respawn restarts it if it exits.
+	respawn -d 5 -p "$STA_PID" -- /usr/sbin/eh-wifid -n "$WIFI_TXT" -n "$NETS" \
+		-a "$APCONF" >>"$LOG" 2>&1 &
+	echo $! > "$STA_SUP"
+	# -f keeps udhcpc in the foreground of its own background job (NOMMU
+	# BusyBox would otherwise re-exec to daemonize); it retries until the
+	# C6 has associated and then renews the lease.  eh-wifid tells it to
+	# renew (release first on a network change) on each association.
+	udhcpc -f -i "$IFACE" -t 0 -T 3 -A 5 -p "$DHCP_PID" >/dev/null 2>&1 &
+	log "Wi-Fi manager started (log: $LOG; wifi-status)"
+}
+
+case "${1:-start}" in
+	start)
+		[ -r /etc/hostname ] && read -r h < /etc/hostname && hostname "$h" 2>/dev/null
+		ifconfig lo 127.0.0.1 up 2>/dev/null || true
+		load_module || exit 1
+		# Do not hold up the console login while the C6 comes up.
+		(
+			if wait_iface; then
+				log "$IFACE appeared"
+				start_sta
+			else
+				log "ERROR: $IFACE did not appear (check dmesg for esp_hosted_mcu)"
+			fi
+		) &
+		;;
+	stop)
+		stop_sta
+		;;
+	restart|reload)
+		stop_sta
+		start_sta
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}" >&2
+		exit 1
+		;;
+esac
+exit 0
diff --git a/linux/waveshare/rootfs-overlay/etc/inittab b/linux/waveshare/rootfs-overlay/etc/inittab
new file mode 100644
index 0000000..8144fc4
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/etc/inittab
@@ -0,0 +1,11 @@
+::sysinit:/etc/init.d/rcS
+# Waveshare ESP32-P4-WIFI6: the USB-C serial port (CH343) is UART0 = ttyS0.
+ttyS0::askfirst:-/bin/sh
+# Supervised daemons (#29): init restarts them if they exit.
+::respawn:/usr/sbin/bootsyncd
+::respawn:/usr/sbin/mdnsd -i ethsta0
+::restart:/sbin/init
+::ctrlaltdel:/sbin/reboot
+# v2: unmount the microSD cleanly on reboot/poweroff.
+::shutdown:/etc/init.d/S06sd stop
+::shutdown:/bin/sync
diff --git a/linux/waveshare/rootfs-overlay/usr/bin/pin b/linux/waveshare/rootfs-overlay/usr/bin/pin
new file mode 100755
index 0000000..99b6f7f
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/bin/pin
@@ -0,0 +1,79 @@
+#!/bin/sh
+# pin - header GPIOs of the Waveshare ESP32-P4-WIFI6 by their board number.
+#
+#   pin lista                       header pins: line name, in use, direction
+#   pin N                           read GPIO N (as input, pull as it was)
+#   pin N leer [pullup|pulldown]    read with an internal pull resistor
+#   pin N 1 | pin N 0               drive GPIO N high / low (stays set)
+#   pin N parpadear [VECES [MS]]    blink (gpio-parpadeo)
+#
+# N is the GPIO number printed next to the pin (2..52).  The P4 has two GPIO
+# banks, each its own gpiochip: GPIO0..31 -> bank 0, GPIO32..56 -> bank 1
+# (line = N - 32).  Reserved lines (C6 SDIO, audio, USB 24/25) are refused by
+# the kernel.  See PINES-GPIO.md for the full table.
+
+chip_of() {	# bank -> gpiochipN
+	for c in /sys/bus/platform/devices/500e0000.gpio-bank"$1"/gpiochip*; do
+		[ -e "$c" ] && { basename "$c"; return 0; }
+	done
+	echo "pin: GPIO bank $1 is not registered (DTB without it?)" >&2
+	exit 1
+}
+
+locate() {	# N -> sets chip, line
+	case "$1" in
+		''|*[!0-9]*) echo "pin: '$1' is not a GPIO number" >&2; exit 2 ;;
+	esac
+	if [ "$1" -gt 56 ]; then
+		echo "pin: GPIO$1 does not exist (0..56)" >&2; exit 2
+	fi
+	if [ "$1" -lt 32 ]; then
+		chip=$(chip_of 0) || exit 1; line=$1
+	else
+		chip=$(chip_of 1) || exit 1; line=$(($1 - 32))
+	fi
+}
+
+case "${1:-}" in
+	lista)
+		c0=$(chip_of 0) || exit 1
+		c1=$(chip_of 1) || exit 1
+		echo "bank 0 ($c0):"
+		gpioinfo -c "$c0" | grep 'HDR'
+		# Bank 1 has no line names (left as validated with the microSD):
+		# print its header lines with their GPIO number.
+		echo "bank 1 ($c1):"
+		gpioinfo -c "$c1" | awk '$1 != "line" { next }
+			{ n = $2; sub(":", "", n); n += 0 }
+			n == 0 || n == 1 || (n >= 14 && n <= 20) {
+				$1 = ""; $2 = ""; printf "\tGPIO%d (line %2d):%s\n", n + 32, n, $0 }'
+		exit 0
+		;;
+	''|-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
+esac
+
+locate "$1"
+case "${2:-}" in
+	"")
+		gpioget -c "$chip" --numeric "$line"
+		;;
+	leer)
+		case "${3:-}" in
+			pullup) gpioget -c "$chip" --numeric -b pull-up "$line" ;;
+			pulldown) gpioget -c "$chip" --numeric -b pull-down "$line" ;;
+			''|sin) gpioget -c "$chip" --numeric -b disabled "$line" ;;
+			*) echo "pin: pull must be pullup, pulldown or sin" >&2; exit 2 ;;
+		esac
+		;;
+	0|1)
+		# -t0: set the value and exit (libgpiod 2); the level stays.
+		gpioset -c "$chip" -t0 "$line=$2"
+		;;
+	parpadear)
+		exec gpio-parpadeo "$1" ${3:+"$3"} ${4:+"$4"}
+		;;
+	*)
+		echo "usage: pin lista | pin N [leer [pullup|pulldown] | 0 | 1 | parpadear [VECES [MS]]]" >&2
+		exit 2
+		;;
+esac
diff --git a/linux/waveshare/rootfs-overlay/usr/bin/temperatura b/linux/waveshare/rootfs-overlay/usr/bin/temperatura
new file mode 100755
index 0000000..49d7098
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/bin/temperatura
@@ -0,0 +1,48 @@
+#!/bin/sh
+# temperatura - ESP32-P4 chip temperature (LP-TSENS, thermal zone
+# "esp32p4-tsens"; also /sys/class/hwmon/hwmonN/temp1_input).
+#
+#   temperatura            one reading, e.g. "41.2 °C"
+#   temperatura -m         millidegrees only (for scripts)
+#   temperatura -w [SEG]   one reading every SEG seconds (default 2), Ctrl-C
+#
+# This is the die temperature, not the room: it runs well above ambient.
+
+zone=
+for z in /sys/class/thermal/thermal_zone*; do
+	[ -r "$z/type" ] || continue
+	if [ "$(cat "$z/type")" = esp32p4-tsens ]; then
+		zone=$z
+		break
+	fi
+done
+if [ -z "$zone" ]; then
+	echo "temperatura: no esp32p4-tsens thermal zone (kernel without CONFIG_ESP32P4_TSENS?)" >&2
+	exit 1
+fi
+
+read_mc() {
+	mc=$(cat "$zone/temp" 2>/dev/null) || { echo "temperatura: cannot read $zone/temp" >&2; exit 1; }
+}
+
+show() {
+	read_mc
+	# integer millidegrees -> one decimal, sign-safe
+	if [ "$mc" -lt 0 ]; then s=-; a=$((-mc)); else s=; a=$mc; fi
+	printf '%s%d.%d °C\n' "$s" $((a / 1000)) $(((a % 1000) / 100))
+}
+
+case "${1:-}" in
+	"") show ;;
+	-m) read_mc; echo "$mc" ;;
+	-w)
+		every=${2:-2}
+		while :; do
+			printf '%s  ' "$(date +%H:%M:%S)"
+			show
+			sleep "$every"
+		done
+		;;
+	-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
+	*) echo "usage: temperatura [-m | -w [SECONDS]]" >&2; exit 2 ;;
+esac
diff --git a/linux/waveshare/rootfs-overlay/usr/bin/wget b/linux/waveshare/rootfs-overlay/usr/bin/wget
new file mode 100755
index 0000000..18c84c7
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/bin/wget
@@ -0,0 +1,37 @@
+#!/bin/sh
+# wget — Waveshare v2 front end.
+#   https:// URLs -> https-get (mbedTLS, certificate and host name verified;
+#                    BusyBox wget has no TLS on this image)
+#   anything else -> BusyBox wget, unchanged
+# Supported with https://: -O FILE, -O -, -q, -T SECONDS, -S.  Without -O
+# the file name is taken from the URL, like wget.
+case " $* " in
+	*" https://"*|*"=https://"*) ;;
+	*) exec /bin/busybox-tools wget "$@" ;;
+esac
+out="" q="" t="" s="" url=""
+while [ $# -gt 0 ]; do
+	case "$1" in
+		-O) out=$2; shift ;;
+		-O*) out=${1#-O} ;;
+		--output-document=*) out=${1#*=} ;;
+		-q|--quiet) q=-q ;;
+		-T) t="-t $2"; shift ;;
+		-T*) t="-t ${1#-T}" ;;
+		--timeout=*) t="-t ${1#*=}" ;;
+		-S|--server-response) s=-S ;;
+		--no-check-certificate)
+			echo "wget: --no-check-certificate is not supported: certificates are always verified" >&2
+			exit 1 ;;
+		https://*) url=$1 ;;
+		-*) echo "wget: option $1 is not supported for https:// (use https-get)" >&2; exit 1 ;;
+		*) echo "wget: only one https:// URL per call" >&2; exit 1 ;;
+	esac
+	shift
+done
+if [ -z "$out" ]; then
+	f=${url#https://}; f=${f%%\?*}; f=${f##*/}
+	out=${f:-index.html}
+fi
+[ -z "$q" ] && echo "Connecting to $url (TLS, certificate verified by https-get)" >&2
+exec /usr/bin/https-get $q $s $t -o "$out" "$url"
diff --git a/linux/waveshare/rootfs-overlay/usr/lib/board/wifi-lib.sh b/linux/waveshare/rootfs-overlay/usr/lib/board/wifi-lib.sh
new file mode 100644
index 0000000..be66b89
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/lib/board/wifi-lib.sh
@@ -0,0 +1,87 @@
+# Waveshare v2 Wi-Fi helpers, sourced by wifi-* and ap-* (root only).
+#
+# Files (the microSD copy is the one in effect; S06sd/boot-save keep them in
+# sync with /boot):
+#   /boot/wifi-networks.conf  saved networks: "ssid=" then "psk=", priority
+#                             order (written by wifi-connect / wifi-forget)
+#   /boot/ap.conf             soft-AP: ssid=, psk=, channel=
+#   /mnt/archivos/wifi.txt    optional, edited on a computer (FAT partition
+#                             WSFILES); read first, never modified here
+# Passphrases are never printed except by "ap-config" for the AP itself.
+
+NETS=/boot/wifi-networks.conf
+APCONF=/boot/ap.conf
+WIFI_TXT=/mnt/archivos/wifi.txt
+
+wl_need_root() {
+	[ -w /run ] || { echo "$0: run as root (su -)" >&2; exit 1; }
+}
+
+# Mount /boot read-write (the RAM image; boot-save writes it to flash).
+WL_WAS_RO=0
+wl_boot_rw() {
+	if ! grep -q '^[^ ]* /boot ' /proc/mounts; then
+		mount -t vfat -o loop,rw,sync,umask=0077 /tmp/boot.img /boot ||
+			{ echo "$0: cannot mount /boot" >&2; return 1; }
+	fi
+	if grep -qE '^[^ ]+ /boot [^ ]+ ro[, ]' /proc/mounts; then
+		WL_WAS_RO=1
+		mount -o remount,rw /boot || { echo "$0: cannot remount /boot rw" >&2; return 1; }
+	fi
+	umask 077
+}
+
+wl_boot_done() {
+	sync
+	if [ -x /usr/sbin/boot-save ]; then
+		/usr/sbin/boot-save >/dev/null 2>&1 ||
+			echo "$0: not saved to flash yet (run boot-save)" >&2
+	fi
+	[ "$WL_WAS_RO" -eq 1 ] && mount -o remount,ro /boot 2>/dev/null
+	return 0
+}
+
+# Print FILE without the network SSID (its ssid= line and the psk line after
+# it).  Values are copied byte for byte (read -r, no echo interpretation).
+wl_drop_ssid() {
+	_skip=0
+	[ -f "$1" ] || return 0
+	while IFS= read -r _l || [ -n "$_l" ]; do
+		_l=${_l%"$(printf '\r')"}
+		case "$_l" in
+			ssid=*)
+				if [ "${_l#ssid=}" = "$2" ]; then _skip=1; continue; fi
+				_skip=0 ;;
+			psk=*|clave=*)
+				[ "$_skip" -eq 1 ] && { _skip=0; continue; } ;;
+		esac
+		printf '%s\n' "$_l"
+	done < "$1"
+}
+
+# SSIDs in a network file, one per line.
+wl_ssids() {
+	[ -f "$1" ] || return 0
+	sed -n -e "s/$(printf '\r')\$//" -e "s/^$(printf '\357\273\277')//" \
+		-e 's/^[[:space:]]*[sS][sS][iI][dD][[:space:]]*[=:][[:space:]]*//p' "$1"
+}
+
+wl_daemon_up() {
+	[ -S /run/eh-wifid.sock ] && eh-wifictl status >/dev/null 2>&1
+}
+
+# Create /boot/ap.conf once: SSID from the AP MAC, random 12-char passphrase.
+wl_ap_init() {
+	[ -s "$APCONF" ] && return 0
+	# ethap0 reads 00:00:00:00:00:00 until the AP has been started once.
+	mac=$(cat /sys/class/net/ethsta0/address 2>/dev/null)
+	suf=$(echo "$mac" | tr -d ':' | tr 'a-f' 'A-F' | cut -c9-12)
+	pw=$(tr -dc 'A-HJ-NP-Za-km-z2-9' < /dev/urandom 2>/dev/null | head -c 12)
+	[ ${#pw} -eq 12 ] || return 1
+	umask 077
+	{ echo "# Soft-AP for the Waveshare ESP32-P4 (see ap-config)"
+	  echo "ssid=WS-P4-${suf:-0000}"
+	  echo "psk=$pw"
+	  echo "channel=6"; } > "$APCONF.new" && mv -f "$APCONF.new" "$APCONF"
+	pw=""
+}
diff --git a/linux/waveshare/rootfs-overlay/usr/lib/micropython/gpio.py b/linux/waveshare/rootfs-overlay/usr/lib/micropython/gpio.py
new file mode 100644
index 0000000..1ef4187
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/lib/micropython/gpio.py
@@ -0,0 +1,85 @@
+# gpio - header GPIOs for MicroPython on the Waveshare ESP32-P4-WIFI6 (v2).
+#
+#   from gpio import Pin
+#   led = Pin(20, Pin.OUT)          # GPIO number printed on the board
+#   led.on(); led.off(); led.value(1)
+#   boton = Pin(47, Pin.IN, Pin.PULL_UP)
+#   boton.value()                   # 0 / 1
+#
+# This MicroPython has no ffi/ioctl, so each operation runs the libgpiod
+# tools (gpioset/gpioget): about tens of ms per call, fine for LEDs, relays
+# and buttons, not for fast signals or bit-banging.  An output keeps its
+# level after the call.  Reserved pins (C6 SDIO, audio, USB 24/25) fail
+# with OSError.  Table: PINES-GPIO.md.
+import os
+
+_TMP = "/tmp/.gpio-py"
+
+
+def _chip(bank):
+    d = "/sys/bus/platform/devices/500e0000.gpio-bank%d" % bank
+    try:
+        for n in os.listdir(d):
+            if n.startswith("gpiochip"):
+                return n
+    except OSError:
+        pass
+    raise OSError("GPIO bank %d is not registered (DTB without it?)" % bank)
+
+
+def _run(cmd):
+    rc = os.system(cmd + " >%s 2>&1" % _TMP)
+    try:
+        with open(_TMP) as f:
+            out = f.read().strip()
+    except OSError:
+        out = ""
+    if rc != 0:
+        raise OSError(out or "%s failed (rc=%d)" % (cmd.split()[0], rc))
+    return out
+
+
+class Pin:
+    IN = 0
+    OUT = 1
+    PULL_UP = 1
+    PULL_DOWN = 2
+
+    def __init__(self, gpio, mode=IN, pull=None, value=None):
+        if not 0 <= gpio <= 56:
+            raise ValueError("GPIO %d does not exist (0..56)" % gpio)
+        self.gpio = gpio
+        if gpio < 32:
+            self._chip, self._line = _chip(0), gpio
+        else:
+            self._chip, self._line = _chip(1), gpio - 32
+        self.mode = mode
+        self.pull = pull
+        self._out = 0
+        if mode == Pin.OUT:
+            self.value(0 if value is None else value)
+        else:
+            self.value()
+
+    def value(self, v=None):
+        if v is None:
+            if self.mode == Pin.OUT:
+                return self._out        # reading would turn it into an input
+            bias = {Pin.PULL_UP: "-b pull-up ", Pin.PULL_DOWN: "-b pull-down "}.get(self.pull, "")
+            return int(_run("gpioget -c %s --numeric %s%d" % (self._chip, bias, self._line)))
+        self._out = 1 if v else 0
+        # -t0: set and exit (libgpiod 2); the output keeps its level.
+        _run("gpioset -c %s -t0 %d=%d" % (self._chip, self._line, self._out))
+        return None
+
+    def on(self):
+        self.value(1)
+
+    def off(self):
+        self.value(0)
+
+    def toggle(self):
+        self.value(1 - self._out)
+
+    def __repr__(self):
+        return "Pin(%d, %s)" % (self.gpio, "OUT" if self.mode == Pin.OUT else "IN")
diff --git a/linux/waveshare/rootfs-overlay/usr/lib/micropython/https.py b/linux/waveshare/rootfs-overlay/usr/lib/micropython/https.py
new file mode 100644
index 0000000..80710f4
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/lib/micropython/https.py
@@ -0,0 +1,108 @@
+# https - HTTPS GET for MicroPython with certificate verification
+# (Waveshare ESP32-P4-WIFI6 Linux v2, ssl module on mbedTLS 3.6, TLS 1.2).
+#
+# Needs the micropython-tls interpreter: the plain micropython has no ssl
+# (it must fit one 512 KB block; ssl adds ~200 KB).
+#
+#   micropython-tls
+#   >>> import https
+#   status, headers, body = https.get("https://example.com/")
+#   https.get(url, timeout=15, max_redirects=5)
+#
+# The server certificate chain is verified against the system CA bundle and
+# the host name (CERT_REQUIRED + server_hostname).  A bad certificate raises
+# OSError("certificate verification failed for HOST: <mbedTLS reason>").
+#
+# Note: a bare ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT) in MicroPython 1.22
+# does NOT verify by default; use context() below or set
+# verify_mode = ssl.CERT_REQUIRED and load_verify_locations() yourself.
+import socket
+
+try:
+    import ssl
+except ImportError:
+    raise ImportError("no ssl in this interpreter: run micropython-tls")
+
+CA_BUNDLE = "/etc/ssl/certs/ca-certificates.crt"
+_ctx = None
+
+
+def context():
+    """Shared client SSLContext that verifies certificates."""
+    global _ctx
+    if _ctx is None:
+        c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+        c.verify_mode = ssl.CERT_REQUIRED
+        c.load_verify_locations(cafile=CA_BUNDLE)
+        _ctx = c
+    return _ctx
+
+
+def _split(url):
+    if not url.startswith("https://"):
+        raise ValueError("only https:// URLs: " + url)
+    rest = url[8:]
+    i = rest.find("/")
+    hostport, path = (rest, "/") if i < 0 else (rest[:i], rest[i:])
+    port = 443
+    if ":" in hostport:
+        hostport, p = hostport.split(":", 1)
+        port = int(p)
+    return hostport, port, path
+
+
+def _fetch(host, port, path, timeout):
+    # IPv4 only: the image has no IPv6 route, and an AF_INET6 result in an
+    # AF_INET socket fails with EAFNOSUPPORT.
+    addr = socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM)[0][-1]
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    try:
+        s.settimeout(timeout)
+        s.connect(addr)
+        try:
+            ss = context().wrap_socket(s, server_hostname=host)
+        except ValueError as e:
+            # MicroPython's modssl reports a rejected certificate as
+            # ValueError; give callers one exception type for "no TLS".
+            raise OSError("certificate verification failed for %s: %s"
+                          % (host, str(e).strip()))
+        ss.write(b"GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: micropython-https/1.0\r\n"
+                 b"Accept-Encoding: identity\r\nConnection: close\r\n\r\n"
+                 % (path.encode(), host.encode()))
+        data = b""
+        while True:
+            try:
+                chunk = ss.read(1024)
+            except OSError as e:
+                if data and b"\r\n\r\n" in data:  # peer closed without close_notify
+                    break
+                raise
+            if not chunk:
+                break
+            data += chunk
+        ss.close()
+    finally:
+        s.close()
+    head, _, body = data.partition(b"\r\n\r\n")
+    lines = head.split(b"\r\n")
+    status = int(lines[0].split()[1])
+    headers = {}
+    for l in lines[1:]:
+        k, _, v = l.partition(b":")
+        headers[k.strip().lower().decode()] = v.strip().decode()
+    return status, headers, body
+
+
+def get(url, timeout=15, max_redirects=5):
+    host, port, path = _split(url)
+    for _ in range(max_redirects + 1):
+        status, headers, body = _fetch(host, port, path, timeout)
+        loc = headers.get("location")
+        if 300 <= status < 400 and loc:
+            if loc.startswith("/"):
+                path = loc
+            else:
+                host, port, path = _split(loc)
+            continue
+        return status, headers, body
+    raise OSError("too many redirects")
diff --git a/linux/waveshare/rootfs-overlay/usr/lib/micropython/temperatura.py b/linux/waveshare/rootfs-overlay/usr/lib/micropython/temperatura.py
new file mode 100644
index 0000000..21bdbeb
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/lib/micropython/temperatura.py
@@ -0,0 +1,46 @@
+# temperatura - ESP32-P4 chip temperature for MicroPython (Waveshare v2).
+#
+#   import temperatura
+#   temperatura.leer()      # 41.234  (degrees Celsius, float)
+#   temperatura.leer_mc()   # 41234   (millidegrees, int)
+#
+# Reads the kernel thermal zone "esp32p4-tsens" (LP-TSENS driver), so it
+# works in the plain micropython and in micropython-tls.  It is the die
+# temperature, not the room.
+
+_zone = None
+
+
+def _find():
+    global _zone
+    if _zone is None:
+        import os
+        base = "/sys/class/thermal"
+        try:
+            names = os.listdir(base)
+        except OSError:
+            names = []
+        for n in names:
+            if not n.startswith("thermal_zone"):
+                continue
+            try:
+                with open(base + "/" + n + "/type") as f:
+                    if f.read().strip() == "esp32p4-tsens":
+                        _zone = base + "/" + n + "/temp"
+                        break
+            except OSError:
+                pass
+        if _zone is None:
+            raise OSError("no esp32p4-tsens thermal zone (kernel without the driver?)")
+    return _zone
+
+
+def leer_mc():
+    """Chip temperature in millidegrees Celsius (int)."""
+    with open(_find()) as f:
+        return int(f.read())
+
+
+def leer():
+    """Chip temperature in degrees Celsius (float)."""
+    return leer_mc() / 1000
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/ap-config b/linux/waveshare/rootfs-overlay/usr/sbin/ap-config
new file mode 100755
index 0000000..348c77a
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/ap-config
@@ -0,0 +1,44 @@
+#!/bin/sh
+# ap-config — show or change the soft-AP settings (Waveshare v2).
+#
+#   ap-config                       show SSID, channel and passphrase
+#   ap-config ssid=NAME             change the SSID
+#   ap-config canal=N               change the channel (1..13)
+#   ap-config clave                 ask for a new passphrase (not echoed)
+#   ap-config clave=random          generate a new random passphrase
+#
+# Saved in /boot/ap.conf (also on the microSD); applied at once if the AP is on.
+. /usr/lib/board/wifi-lib.sh
+wl_need_root
+wl_boot_rw || exit 1
+wl_ap_init
+if [ $# -eq 0 ]; then
+	[ "$WL_WAS_RO" -eq 1 ] && mount -o remount,ro /boot 2>/dev/null
+	sed -n 's/^ssid=/SSID:       /p; s/^channel=/channel:    /p; s/^psk=/passphrase: /p' "$APCONF"
+	exit 0
+fi
+ssid=$(sed -n 's/^ssid=//p' "$APCONF"); ch=$(sed -n 's/^channel=//p' "$APCONF")
+psk=$(sed -n 's/^psk=//p' "$APCONF")
+for a in "$@"; do
+	case "$a" in
+		ssid=*) ssid=${a#ssid=}
+			[ -n "$ssid" ] && [ ${#ssid} -le 32 ] || { echo "SSID: 1..32 bytes" >&2; exit 1; } ;;
+		canal=*|channel=*) ch=${a#*=}
+			case "$ch" in [1-9]|1[0-3]) ;; *) echo "channel: 1..13" >&2; exit 1 ;; esac ;;
+		clave=random|psk=random)
+			psk=$(tr -dc 'A-HJ-NP-Za-km-z2-9' < /dev/urandom | head -c 12) ;;
+		clave|psk)
+			stty -echo 2>/dev/null; printf 'New AP passphrase (8..63, not shown): '
+			IFS= read -r psk; stty echo 2>/dev/null; echo
+			[ ${#psk} -ge 8 ] && [ ${#psk} -le 63 ] || { psk=""; echo "8..63 characters" >&2; exit 1; } ;;
+		*) echo "unknown option '$a' (see: head -12 $0)" >&2; exit 1 ;;
+	esac
+done
+{ echo "# Soft-AP for the Waveshare ESP32-P4 (see ap-config)"
+  echo "ssid=$ssid"; echo "psk=$psk"; echo "channel=$ch"; } > "$APCONF.new" &&
+	mv -f "$APCONF.new" "$APCONF"
+psk=""
+wl_boot_done
+echo "Saved: SSID $ssid, channel $ch"
+wl_daemon_up && eh-wifictl ap-reload
+exit 0
