new file mode 100644
index 0000000..26fbed7
--- /dev/null
+++ b/linux/buildroot-external/package/gpio-ejemplo/gpio-ejemplo.mk
@@ -0,0 +1,64 @@
+################################################################################
+# gpio-ejemplo: libgpiod C example (Waveshare v2 phase 8)
+################################################################################
+
+GPIO_EJEMPLO_VERSION = 1.0
+GPIO_EJEMPLO_SITE = $(BR2_EXTERNAL_STAMP_P4_PATH)/../waveshare/gpio-ejemplo
+GPIO_EJEMPLO_SITE_METHOD = local
+GPIO_EJEMPLO_LICENSE = Apache-2.0
+GPIO_EJEMPLO_DEPENDENCIES = libgpiod2
+
+define GPIO_EJEMPLO_BUILD_CMDS
+	$(TARGET_CC) $(TARGET_CFLAGS) -std=gnu11 -Wall -Wextra -Os \
+		$(TARGET_LDFLAGS) -o $(@D)/gpio-parpadeo $(@D)/gpio-parpadeo.c -lgpiod
+endef
+
+define GPIO_EJEMPLO_INSTALL_TARGET_CMDS
+	$(INSTALL) -D -m 0755 $(@D)/gpio-parpadeo $(TARGET_DIR)/usr/bin/gpio-parpadeo
+	$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 16384 $(TARGET_DIR)/usr/bin/gpio-parpadeo
+	rm -f $(TARGET_DIR)/usr/bin/gpio-parpadeo.gdb
+endef
+
+# The m3-lab profile requires a bFLT stack of at least 16000 bytes in every
+# program; Buildroot's libgpiod2 tools keep elf2flt's 4 KiB default.
+LIBGPIOD2_TOOLS_PROGS = gpiodetect gpioget gpioinfo gpiomon gpionotify gpioset
+define GPIO_EJEMPLO_LIBGPIOD_STACK
+	for p in $(LIBGPIOD2_TOOLS_PROGS); do \
+		if [ -f $(TARGET_DIR)/usr/bin/$$p ]; then \
+			$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 16384 $(TARGET_DIR)/usr/bin/$$p || exit 1; \
+			rm -f $(TARGET_DIR)/usr/bin/$$p.gdb; \
+		fi; \
+	done
+endef
+ifeq ($(BR2_PACKAGE_GPIO_EJEMPLO),y)
+LIBGPIOD2_POST_INSTALL_TARGET_HOOKS += GPIO_EJEMPLO_LIBGPIOD_STACK
+endif
+
+# Same rule for the phase 9 bus tools (i2c-tools, spidev_test).
+define GPIO_EJEMPLO_SBIN_STACK
+	for p in $(1); do \
+		if [ -f $(TARGET_DIR)/usr/sbin/$$p ]; then \
+			$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 16384 $(TARGET_DIR)/usr/sbin/$$p || exit 1; \
+			rm -f $(TARGET_DIR)/usr/sbin/$$p.gdb; \
+		fi; \
+	done
+endef
+# i2c-tools also installs eeprog and Perl scripts (decode-*, ddcmon,
+# i2c-stub-from-dump); there is no Perl on the board and no EEPROM work in
+# scope, so they are dropped (space: the rootfs partition is 7 MB).
+define GPIO_EJEMPLO_I2C_TOOLS_STACK
+	rm -f $(TARGET_DIR)/usr/sbin/eeprog $(TARGET_DIR)/usr/sbin/eeprog.gdb \
+		$(TARGET_DIR)/usr/sbin/i2c-stub-from-dump \
+		$(TARGET_DIR)/usr/bin/ddcmon $(TARGET_DIR)/usr/bin/decode-dimms \
+		$(TARGET_DIR)/usr/bin/decode-edid $(TARGET_DIR)/usr/bin/decode-vaio
+	$(call GPIO_EJEMPLO_SBIN_STACK,i2cdetect i2cdump i2cget i2cset i2ctransfer)
+endef
+define GPIO_EJEMPLO_SPIDEV_TEST_STACK
+	$(call GPIO_EJEMPLO_SBIN_STACK,spidev_test)
+endef
+ifeq ($(BR2_PACKAGE_GPIO_EJEMPLO),y)
+I2C_TOOLS_POST_INSTALL_TARGET_HOOKS += GPIO_EJEMPLO_I2C_TOOLS_STACK
+SPIDEV_TEST_POST_INSTALL_TARGET_HOOKS += GPIO_EJEMPLO_SPIDEV_TEST_STACK
+endif
+
+$(eval $(generic-package))
