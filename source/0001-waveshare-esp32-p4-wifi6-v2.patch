diff --git a/linux/waveshare/eh-wifi-sta/main/eh-wifictl.c b/linux/waveshare/eh-wifi-sta/main/eh-wifictl.c
new file mode 100644
index 0000000..7c43e68
--- /dev/null
+++ b/linux/waveshare/eh-wifi-sta/main/eh-wifictl.c
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * eh-wifictl — send one command to eh-wifid and print the reply.
+ *
+ *   eh-wifictl status|scan|reload|connect SSID|ap-on|ap-off [force]|ap-reload
+ *
+ * Small on purpose (no ESP-Hosted code): every exec on NOMMU loads the whole
+ * program into RAM.  Exit status 1 when the daemon answers "error:".
+ */
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+	struct sockaddr_un a = { .sun_family = AF_UNIX };
+	char cmd[96] = "", buf[512];
+	int s, first = 1, err = 0;
+	ssize_t n;
+
+	if (argc < 2) {
+		fprintf(stderr, "usage: %s COMMAND [ARG]\n", argv[0]);
+		return 2;
+	}
+	for (int i = 1; i < argc; i++) {
+		if (strlen(cmd) + strlen(argv[i]) + 2 >= sizeof(cmd)) {
+			fprintf(stderr, "%s: command too long\n", argv[0]);
+			return 2;
+		}
+		if (i > 1)
+			strcat(cmd, " ");
+		strcat(cmd, argv[i]);
+	}
+	strcat(cmd, "\n");
+	snprintf(a.sun_path, sizeof(a.sun_path), "%s", "/run/eh-wifid.sock");
+	s = socket(AF_UNIX, SOCK_STREAM, 0);
+	if (s < 0 || connect(s, (struct sockaddr *)&a, sizeof(a)) < 0) {
+		fprintf(stderr, "eh-wifid is not running (see /run/eh-wifid.log)\n");
+		return 3;
+	}
+	if (write(s, cmd, strlen(cmd)) < 0) {
+		perror("write");
+		return 3;
+	}
+	shutdown(s, SHUT_WR);
+	while ((n = read(s, buf, sizeof(buf))) > 0) {
+		if (first && n >= 6 && !memcmp(buf, "error:", 6))
+			err = 1;
+		first = 0;
+		fwrite(buf, 1, n, stdout);
+	}
+	close(s);
+	return err;
+}
diff --git a/linux/waveshare/eh-wifi-sta/main/eh-wifid.c b/linux/waveshare/eh-wifi-sta/main/eh-wifid.c
new file mode 100644
index 0000000..2a96e9e
--- /dev/null
+++ b/linux/waveshare/eh-wifi-sta/main/eh-wifid.c
@@ -0,0 +1,778 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * eh-wifid — Wi-Fi manager for the Waveshare ESP32-P4-WIFI6 on-board
+ * ESP32-C6 (ESP-Hosted-MCU 3.0.10).
+ *
+ * /dev/esps0 (the RPC channel to the C6) accepts a single opener, so this
+ * one resident process does everything: station, scan, soft-AP and the
+ * fallback policy.  Shell commands (wifi-scan, wifi-status, ap-on, ...) talk
+ * to it through eh-wifictl over a root-only Unix socket.
+ *
+ *   eh-wifid -n NETFILE [-n NETFILE ...] -a APFILE [-s SOCKET]
+ *
+ * NETFILE: plain text, one network per "ssid=" line followed by its
+ *   "psk=" (or "clave=" / "password=") line.  Order is priority.  CRLF,
+ *   a UTF-8 BOM, blank lines, "#" comments and "quoted" values are accepted.
+ *   A missing file is not an error (re-read on "reload").
+ * APFILE: ssid=, psk=, channel= for the soft-AP.
+ *
+ * Policy:
+ *   - scan, then try the known networks that are visible, in file order
+ *     (each for CONNECT_TIMEOUT_S); hidden ones are tried after those;
+ *   - none works (or none known) -> soft-AP on (AP+STA) and keep scanning
+ *     every RESCAN_S; when a known network appears, join it and turn the
+ *     fallback AP off again;
+ *   - a manual "ap-on" keeps the AP up until "ap-off".
+ * IPv4 on the station is the system udhcpc's job (S40network); it is told to
+ * renew (and to release first when the network changed) on association.
+ *
+ * Passphrases are never printed, logged or sent over the socket.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "esp_event.h"
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "esp_wifi.h"
+#include "esp_hosted_examples_common.h"
+
+#define MAX_NETS		16
+#define MAX_NETFILES		4
+#define SCAN_MAX		24
+#define CONNECT_TIMEOUT_S	20
+#define RECONNECT_GRACE_S	30
+#define RESCAN_S		60
+#define UDHCPC_PIDFILE		"/run/udhcpc.ethsta0.pid"
+
+static const char *TAG = "eh-wifid";
+
+struct net {
+	char ssid[33];
+	char psk[65];
+	bool seen;	/* in the last scan */
+	int rssi;
+};
+
+enum sta_state { ST_IDLE, ST_CONNECTING, ST_CONNECTED, ST_FAILED };
+static const char *const st_name[] = { "idle", "connecting", "connected", "failed" };
+
+static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+
+/* Written by the event handlers (under lk), read by the main loop. */
+static volatile bool ev_connected, ev_disconnected, ev_got_ip;
+static int ev_reason;
+static int ap_clients;
+
+/* Main-loop state. */
+static struct net nets[MAX_NETS];
+static int n_nets;
+static const char *netfiles[MAX_NETFILES];
+static int n_netfiles;
+static const char *apfile;
+
+static enum sta_state st = ST_IDLE;
+static int cur = -1;			/* index in nets[] being tried/used */
+static char cur_ssid[33];
+static char bound_ssid[33];		/* network udhcpc last got a lease on */
+static int last_reason;
+static time_t st_since;
+static bool have_ip;
+
+static bool ap_on, ap_manual;
+static char ap_ssid[33];
+static int ap_channel;
+static esp_netif_t *ap_netif;
+static time_t ap_dhcps_check;
+
+static int order[MAX_NETS], n_order, order_pos;	/* candidates this round */
+static time_t next_scan;
+static char prefer[33];			/* "connect SSID" asks for this one first */
+
+static void wipe(void *p, size_t n)
+{
+	volatile unsigned char *v = p;
+	while (n--)
+		*v++ = 0;
+}
+
+static time_t now_s(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec;
+}
+
+/* ------------------------------------------------------------ files ---- */
+
+static char *trim(char *s)
+{
+	char *e;
+
+	while (*s == ' ' || *s == '\t')
+		s++;
+	e = s + strlen(s);
+	while (e > s && (e[-1] == '\r' || e[-1] == '\n' || e[-1] == ' ' || e[-1] == '\t'))
+		*--e = '\0';
+	if (e - s >= 2 && s[0] == '"' && e[-1] == '"') {
+		e[-1] = '\0';
+		s++;
+	}
+	return s;
+}
+
+/* key=value; returns value or NULL.  Key compare is case-insensitive. */
+static char *kv(char *line, const char *key)
+{
+	size_t k = strlen(key);
+	char *p = line;
+
+	while (*p == ' ' || *p == '\t')
+		p++;
+	if (strncasecmp(p, key, k) != 0)
+		return NULL;
+	p += k;
+	while (*p == ' ' || *p == '\t')
+		p++;
+	if (*p != '=' && *p != ':')
+		return NULL;
+	return trim(p + 1);
+}
+
+static int find_net(const char *ssid)
+{
+	for (int i = 0; i < n_nets; i++)
+		if (strcmp(nets[i].ssid, ssid) == 0)
+			return i;
+	return -1;
+}
+
+static void load_netfile(const char *path)
+{
+	char line[256];
+	FILE *f = fopen(path, "r");
+	int last = -1;
+	bool first = true;
+
+	if (!f)
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		char *l = line, *v;
+
+		if (first && (unsigned char)l[0] == 0xEF &&
+		    (unsigned char)l[1] == 0xBB && (unsigned char)l[2] == 0xBF)
+			l += 3;
+		first = false;
+		while (*l == ' ' || *l == '\t')
+			l++;
+		if (*l == '#' || *l == ';' || *l == '\r' || *l == '\n' || !*l)
+			continue;
+		if ((v = kv(l, "ssid")) != NULL) {
+			if (!*v || strlen(v) > 32) {
+				ESP_LOGW(TAG, "%s: bad ssid line skipped", path);
+				last = -1;
+				continue;
+			}
+			last = find_net(v);
+			if (last < 0 && n_nets < MAX_NETS) {
+				last = n_nets++;
+				memset(&nets[last], 0, sizeof(nets[last]));
+				strcpy(nets[last].ssid, v);
+			} else if (last >= 0) {
+				last = -1;	/* already known from a higher-priority file */
+			}
+		} else if ((v = kv(l, "psk")) || (v = kv(l, "clave")) ||
+			   (v = kv(l, "password")) || (v = kv(l, "pass"))) {
+			size_t n = strlen(v);
+
+			if (last >= 0) {
+				if (n == 0 || (n >= 8 && n <= 64))
+					strcpy(nets[last].psk, v);
+				else
+					ESP_LOGW(TAG, "%s: \"%s\": passphrase must have 8..63 characters",
+						 path, nets[last].ssid);
+			}
+		}
+		wipe(line, sizeof(line));
+	}
+	wipe(line, sizeof(line));
+	fclose(f);
+}
+
+static void load_nets(void)
+{
+	for (int i = 0; i < n_nets; i++)
+		wipe(nets[i].psk, sizeof(nets[i].psk));
+	n_nets = 0;
+	for (int i = 0; i < n_netfiles; i++)
+		load_netfile(netfiles[i]);
+	ESP_LOGI(TAG, "%d known network(s)", n_nets);
+}
+
+static bool load_ap(char *psk, size_t psk_cap)
+{
+	char line[160];
+	FILE *f = fopen(apfile, "r");
+
+	ap_ssid[0] = '\0';
+	psk[0] = '\0';
+	ap_channel = 6;
+	if (!f)
+		return false;
+	while (fgets(line, sizeof(line), f)) {
+		char *v;
+
+		if ((v = kv(line, "ssid")) && strlen(v) <= 32)
+			strcpy(ap_ssid, v);
+		else if (((v = kv(line, "psk")) || (v = kv(line, "clave"))) && strlen(v) < psk_cap)
+			strcpy(psk, v);
+		else if ((v = kv(line, "channel")) || (v = kv(line, "canal")))
+			ap_channel = atoi(v);
+	}
+	wipe(line, sizeof(line));
+	fclose(f);
+	if (ap_channel < 1 || ap_channel > 13)
+		ap_channel = 6;
+	return ap_ssid[0] != '\0';
+}
+
+/* ----------------------------------------------------------- events ---- */
+
+static void on_wifi(void *arg, esp_event_base_t base, int32_t id, void *data)
+{
+	(void)arg; (void)base;
+	pthread_mutex_lock(&lk);
+	switch (id) {
+	case WIFI_EVENT_STA_CONNECTED:
+		ev_connected = true;
+		break;
+	case WIFI_EVENT_STA_DISCONNECTED: {
+		wifi_event_sta_disconnected_t *e = data;
+
+		ev_reason = e ? e->reason : 0;
+		ev_disconnected = true;
+		break;
+	}
+	case WIFI_EVENT_AP_STACONNECTED:
+		ap_clients++;
+		break;
+	case WIFI_EVENT_AP_STADISCONNECTED:
+		if (ap_clients > 0)
+			ap_clients--;
+		break;
+	default:
+		break;
+	}
+	pthread_mutex_unlock(&lk);
+}
+
+static void on_ip(void *arg, esp_event_base_t base, int32_t id, void *data)
+{
+	(void)arg; (void)base; (void)data;
+	pthread_mutex_lock(&lk);
+	if (id == IP_EVENT_STA_GOT_IP)
+		ev_got_ip = true;
+	pthread_mutex_unlock(&lk);
+}
+
+/* -------------------------------------------------------------- wifi ---- */
+
+static void udhcpc_kick(bool release)
+{
+	FILE *f = fopen(UDHCPC_PIDFILE, "r");
+	int pid = 0;
+
+	if (!f)
+		return;
+	if (fscanf(f, "%d", &pid) != 1)
+		pid = 0;
+	fclose(f);
+	if (pid <= 1)
+		return;
+	if (release)
+		kill(pid, SIGUSR2);
+	kill(pid, SIGUSR1);
+}
+
+static esp_err_t set_mode(void)
+{
+	return esp_wifi_set_mode(ap_on ? WIFI_MODE_APSTA : WIFI_MODE_STA);
+}
+
+static esp_err_t ap_start(bool manual)
+{
+	char psk[65];
+	wifi_config_t c = { 0 };
+	esp_err_t err;
+
+	if (!load_ap(psk, sizeof(psk))) {
+		ESP_LOGE(TAG, "%s: no ssid=; soft-AP not started (run ap-config)", apfile);
+		wipe(psk, sizeof(psk));
+		return ESP_ERR_INVALID_ARG;
+	}
+	c.ap.ssid_len = strlen(ap_ssid);
+	memcpy(c.ap.ssid, ap_ssid, c.ap.ssid_len);
+	c.ap.channel = ap_channel;
+	c.ap.max_connection = 4;
+	if (strlen(psk) >= 8) {
+		memcpy(c.ap.password, psk, strlen(psk));
+		c.ap.authmode = WIFI_AUTH_WPA2_PSK;
+	} else {
+		c.ap.authmode = WIFI_AUTH_OPEN;
+	}
+	wipe(psk, sizeof(psk));
+	ap_on = true;
+	err = set_mode();
+	if (err == ESP_OK)
+		err = esp_wifi_set_config(WIFI_IF_AP, &c);
+	wipe(&c, sizeof(c));
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "soft-AP start: %s", esp_err_to_name(err));
+		ap_on = false;
+		set_mode();
+		return err;
+	}
+	ap_manual = manual;
+	ap_dhcps_check = now_s() + 2;
+	ESP_LOGI(TAG, "soft-AP \"%s\" on channel %d (%s)", ap_ssid, ap_channel,
+		 manual ? "manual" : "fallback");
+	return ESP_OK;
+}
+
+static void ap_stop(void)
+{
+	if (!ap_on)
+		return;
+	ap_on = false;
+	ap_manual = false;
+	set_mode();
+	pthread_mutex_lock(&lk);
+	ap_clients = 0;
+	pthread_mutex_unlock(&lk);
+	ESP_LOGI(TAG, "soft-AP off");
+}
+
+static void sta_try(int i)
+{
+	wifi_config_t c = { 0 };
+	esp_err_t err;
+
+	esp_wifi_disconnect();
+	memcpy(c.sta.ssid, nets[i].ssid, strlen(nets[i].ssid));
+	if (nets[i].psk[0]) {
+		memcpy(c.sta.password, nets[i].psk, strlen(nets[i].psk));
+		c.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+	} else {
+		c.sta.threshold.authmode = WIFI_AUTH_OPEN;
+	}
+	err = esp_wifi_set_config(WIFI_IF_STA, &c);
+	wipe(&c, sizeof(c));
+	cur = i;
+	strcpy(cur_ssid, nets[i].ssid);
+	st = ST_CONNECTING;
+	st_since = now_s();
+	have_ip = false;
+	if (err == ESP_OK)
+		err = esp_wifi_connect();
+	if (err != ESP_OK && err != ESP_ERR_WIFI_CONN)
+		ESP_LOGW(TAG, "connect \"%s\": %s", cur_ssid, esp_err_to_name(err));
+	else
+		ESP_LOGI(TAG, "trying \"%s\"", cur_ssid);
+}
+
+/* Scan; fills seen/rssi of known nets.  Returns the number of records. */
+static int do_scan(wifi_ap_record_t *rec, uint16_t cap)
+{
+	wifi_scan_config_t sc = { .show_hidden = true, .scan_type = WIFI_SCAN_TYPE_ACTIVE };
+	uint16_t n = cap;
+	esp_err_t err;
+
+	for (int i = 0; i < n_nets; i++) {
+		nets[i].seen = false;
+		nets[i].rssi = -127;
+	}
+	err = esp_wifi_scan_start(&sc, true);
+	if (err != ESP_OK) {
+		ESP_LOGW(TAG, "scan: %s", esp_err_to_name(err));
+		return -1;
+	}
+	if (esp_wifi_scan_get_ap_records(&n, rec) != ESP_OK)
+		return -1;
+	for (int r = 0; r < n; r++) {
+		int i = find_net((const char *)rec[r].ssid);
+
+		if (i >= 0 && rec[r].rssi > nets[i].rssi) {
+			nets[i].seen = true;
+			nets[i].rssi = rec[r].rssi;
+		}
+	}
+	return n;
+}
+
+/* New round: visible known networks in priority order, then hidden ones. */
+static void plan_round(void)
+{
+	static wifi_ap_record_t rec[SCAN_MAX];
+	int p;
+
+	n_order = 0;
+	order_pos = 0;
+	if (n_nets == 0)
+		return;
+	do_scan(rec, SCAN_MAX);
+	p = prefer[0] ? find_net(prefer) : -1;
+	if (p >= 0)
+		order[n_order++] = p;
+	for (int i = 0; i < n_nets; i++)
+		if (nets[i].seen && i != p)
+			order[n_order++] = i;
+	/* Hidden networks only when nothing known is in sight and no AP yet. */
+	if (n_order == 0 && !ap_on)
+		for (int i = 0; i < n_nets; i++)
+			if (i != p)
+				order[n_order++] = i;
+	prefer[0] = '\0';
+}
+
+static void next_candidate(void)
+{
+	if (order_pos < n_order) {
+		sta_try(order[order_pos++]);
+		return;
+	}
+	esp_wifi_disconnect();
+	st = n_nets ? ST_FAILED : ST_IDLE;
+	st_since = now_s();
+	cur = -1;
+	if (!ap_on) {
+		ESP_LOGW(TAG, "no known network reachable: starting the fallback soft-AP");
+		ap_start(false);
+	}
+	next_scan = now_s() + RESCAN_S;
+}
+
+static void new_round(void)
+{
+	plan_round();
+	next_candidate();
+}
+
+static void tick(void)
+{
+	bool conn, disc, ip;
+	int reason;
+	time_t t = now_s();
+
+	/* esp_netif kills udhcpd when the AP stops but does not always reap
+	 * it (a [udhcpd] zombie per AP cycle, seen on the board). */
+	while (waitpid(-1, NULL, WNOHANG) > 0)
+		;
+	pthread_mutex_lock(&lk);
+	conn = ev_connected; disc = ev_disconnected; ip = ev_got_ip;
+	reason = ev_reason;
+	ev_connected = ev_disconnected = ev_got_ip = false;
+	pthread_mutex_unlock(&lk);
+
+	if (disc) {
+		last_reason = reason;
+		have_ip = false;
+		if (st == ST_CONNECTED) {
+			ESP_LOGW(TAG, "lost \"%s\" (reason %d), reconnecting", cur_ssid, reason);
+			st = ST_CONNECTING;
+			st_since = t;
+		}
+		if (st == ST_CONNECTING)
+			esp_wifi_connect();
+	}
+	if (conn && st == ST_CONNECTING) {
+		ESP_LOGI(TAG, "associated to \"%s\"", cur_ssid);
+		udhcpc_kick(strcmp(bound_ssid, cur_ssid) != 0);
+		strcpy(bound_ssid, cur_ssid);
+		st = ST_CONNECTED;
+		st_since = t;
+	}
+	if (ip) {
+		have_ip = true;
+		if (st == ST_CONNECTED && ap_on && !ap_manual)
+			ap_stop();
+	}
+	if (st == ST_CONNECTING && t - st_since >=
+	    (cur >= 0 && strcmp(bound_ssid, cur_ssid) == 0 ? RECONNECT_GRACE_S : CONNECT_TIMEOUT_S)) {
+		ESP_LOGW(TAG, "\"%s\" did not connect (reason %d)", cur_ssid, last_reason);
+		next_candidate();
+	}
+	/* Applying the AP config restarts the C6 soft-AP (AP_STOP, AP_START).
+	 * esp_netif stops udhcpd on AP_STOP and then treats it as stopped by
+	 * the application, so it is not started again on AP_START (seen on
+	 * the board: "DHCP server stopped on ethap0" one second after the
+	 * spawn).  Start it here whenever the AP is up without it. */
+	if (ap_on && ap_netif && t >= ap_dhcps_check) {
+		esp_netif_dhcp_status_t ds = ESP_NETIF_DHCP_INIT;
+
+		ap_dhcps_check = t + 5;
+		if (esp_netif_dhcps_get_status(ap_netif, &ds) == ESP_OK &&
+		    ds != ESP_NETIF_DHCP_STARTED) {
+			esp_err_t e = esp_netif_dhcps_start(ap_netif);
+
+			ESP_LOGI(TAG, "soft-AP DHCP server (re)started: %s", esp_err_to_name(e));
+		}
+	}
+	if ((st == ST_FAILED || st == ST_IDLE) && n_nets && t >= next_scan) {
+		new_round();
+		if (st != ST_CONNECTING)
+			next_scan = t + RESCAN_S;
+	}
+}
+
+/* ------------------------------------------------------------ socket ---- */
+
+static void out(int fd, const char *fmt, ...)
+{
+	char b[256];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(b, sizeof(b), fmt, ap);
+	va_end(ap);
+	if (n > 0)
+		(void)!write(fd, b, n < (int)sizeof(b) ? n : (int)sizeof(b) - 1);
+}
+
+static const char *auth_name(wifi_auth_mode_t a)
+{
+	switch (a) {
+	case WIFI_AUTH_OPEN: return "open";
+	case WIFI_AUTH_WEP: return "wep";
+	case WIFI_AUTH_WPA_PSK: return "wpa";
+	case WIFI_AUTH_WPA2_PSK: return "wpa2";
+	case WIFI_AUTH_WPA_WPA2_PSK: return "wpa/wpa2";
+	case WIFI_AUTH_WPA3_PSK: return "wpa3";
+	case WIFI_AUTH_WPA2_WPA3_PSK: return "wpa2/wpa3";
+	case WIFI_AUTH_WPA2_ENTERPRISE: return "enterprise";
+	default: return "other";
+	}
+}
+
+static void cmd_status(int fd)
+{
+	wifi_ap_record_t ai;
+	int clients;
+
+	pthread_mutex_lock(&lk);
+	clients = ap_clients;
+	pthread_mutex_unlock(&lk);
+	out(fd, "mode=%s\n", ap_on ? "ap+sta" : "sta");
+	out(fd, "sta=%s\n", st_name[st]);
+	out(fd, "sta_ssid=%s\n", st == ST_IDLE || st == ST_FAILED ? "" : cur_ssid);
+	if (st == ST_CONNECTED && esp_wifi_sta_get_ap_info(&ai) == ESP_OK) {
+		out(fd, "sta_rssi=%d\n", ai.rssi);
+		out(fd, "sta_channel=%d\n", ai.primary);
+	}
+	out(fd, "sta_ip=%s\n", have_ip ? "yes" : "no");
+	out(fd, "last_reason=%d\n", last_reason);
+	out(fd, "known_networks=%d\n", n_nets);
+	out(fd, "ap=%s\n", ap_on ? (ap_manual ? "on" : "fallback") : "off");
+	if (ap_on) {
+		out(fd, "ap_ssid=%s\n", ap_ssid);
+		out(fd, "ap_channel=%d\n", ap_channel);
+		out(fd, "ap_clients=%d\n", clients);
+	}
+}
+
+static void cmd_scan(int fd)
+{
+	static wifi_ap_record_t rec[SCAN_MAX];
+	int n;
+
+	if (st == ST_CONNECTING) {
+		out(fd, "error: busy connecting to \"%s\", try again in a few seconds\n", cur_ssid);
+		return;
+	}
+	n = do_scan(rec, SCAN_MAX);
+	if (n < 0) {
+		out(fd, "error: scan failed\n");
+		return;
+	}
+	for (int i = 0; i < n; i++)
+		out(fd, "%d\t%d\t%s\t%s\t%s\n", rec[i].rssi, rec[i].primary,
+		    auth_name(rec[i].authmode),
+		    find_net((const char *)rec[i].ssid) >= 0 ? "saved" : "-",
+		    rec[i].ssid[0] ? (const char *)rec[i].ssid : "(hidden)");
+}
+
+static void handle(int fd)
+{
+	char cmd[96];
+	ssize_t n = read(fd, cmd, sizeof(cmd) - 1);
+	char *arg;
+
+	if (n <= 0)
+		return;
+	cmd[n] = '\0';
+	cmd[strcspn(cmd, "\r\n")] = '\0';
+	arg = strchr(cmd, ' ');
+	if (arg)
+		*arg++ = '\0';
+
+	if (!strcmp(cmd, "status")) {
+		cmd_status(fd);
+	} else if (!strcmp(cmd, "scan")) {
+		cmd_scan(fd);
+	} else if (!strcmp(cmd, "reload") || !strcmp(cmd, "connect")) {
+		/* Re-read the network files; "connect SSID" tries that one first. */
+		load_nets();
+		if (arg && *arg) {
+			if (find_net(arg) < 0) {
+				out(fd, "error: \"%s\" is not a saved network\n", arg);
+				return;
+			}
+			snprintf(prefer, sizeof(prefer), "%s", arg);
+		}
+		if (arg && *arg) {
+			new_round();
+			out(fd, "ok: trying \"%s\"\n", cur_ssid);
+		} else if (st == ST_CONNECTED && find_net(cur_ssid) >= 0) {
+			out(fd, "ok: %d network(s); staying on \"%s\"\n", n_nets, cur_ssid);
+		} else {
+			new_round();
+			out(fd, "ok: %d network(s)\n", n_nets);
+		}
+	} else if (!strcmp(cmd, "ap-on")) {
+		if (ap_on) {
+			ap_manual = true;
+			out(fd, "ok: soft-AP already on\n");
+		} else {
+			esp_err_t e = ap_start(true);
+
+			out(fd, e == ESP_OK ? "ok\n" : "error: %s\n", esp_err_to_name(e));
+		}
+	} else if (!strcmp(cmd, "ap-off")) {
+		if (st != ST_CONNECTED) {
+			out(fd, "error: the station is not connected; turning the AP off "
+				"would leave the board unreachable (use 'ap-off force')\n");
+			if (!(arg && !strcmp(arg, "force")))
+				return;
+		}
+		ap_stop();
+		out(fd, "ok\n");
+	} else if (!strcmp(cmd, "ap-reload")) {
+		if (ap_on) {
+			bool m = ap_manual;
+			esp_err_t e = ap_start(m);
+
+			out(fd, e == ESP_OK ? "ok\n" : "error: %s\n", esp_err_to_name(e));
+		} else {
+			out(fd, "ok: soft-AP is off; new settings apply next time\n");
+		}
+	} else {
+		out(fd, "error: unknown command '%s'\n", cmd);
+	}
+}
+
+static int open_sock(const char *path)
+{
+	struct sockaddr_un a = { .sun_family = AF_UNIX };
+	int s = socket(AF_UNIX, SOCK_STREAM, 0);
+
+	if (s < 0)
+		return -1;
+	snprintf(a.sun_path, sizeof(a.sun_path), "%s", path);
+	unlink(path);
+	umask(077);
+	if (bind(s, (struct sockaddr *)&a, sizeof(a)) < 0 || listen(s, 4) < 0) {
+		close(s);
+		return -1;
+	}
+	fcntl(s, F_SETFD, FD_CLOEXEC);
+	chmod(path, 0600);
+	return s;
+}
+
+int main(int argc, char **argv)
+{
+	const char *sock = "/run/eh-wifid.sock";
+	esp_err_t err;
+	int s, o;
+
+	while ((o = getopt(argc, argv, "n:a:s:")) != -1) {
+		switch (o) {
+		case 'n':
+			if (n_netfiles < MAX_NETFILES)
+				netfiles[n_netfiles++] = optarg;
+			break;
+		case 'a': apfile = optarg; break;
+		case 's': sock = optarg; break;
+		default:
+			fprintf(stderr, "usage: %s -n NETFILE [-n ...] -a APFILE [-s SOCKET]\n", argv[0]);
+			return 2;
+		}
+	}
+	if (!apfile) {
+		fprintf(stderr, "%s: -a APFILE is required\n", argv[0]);
+		return 2;
+	}
+	signal(SIGPIPE, SIG_IGN);
+
+	err = eh_example_init();
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "init: %s", esp_err_to_name(err));
+		return 1;
+	}
+	ap_netif = esp_netif_create_default_wifi_ap();
+	if (!esp_netif_create_default_wifi_sta() || !ap_netif) {
+		ESP_LOGE(TAG, "cannot create the netifs");
+		return 1;
+	}
+	esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, on_wifi, NULL);
+	esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, on_ip, NULL);
+
+	err = esp_wifi_set_mode(WIFI_MODE_STA);
+	if (err == ESP_OK)
+		err = esp_wifi_start();
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "wifi start: %s", esp_err_to_name(err));
+		return 1;
+	}
+
+	s = open_sock(sock);
+	if (s < 0) {
+		ESP_LOGE(TAG, "%s: %s", sock, strerror(errno));
+		return 1;
+	}
+	load_nets();
+	new_round();
+
+	for (;;) {
+		struct pollfd p = { .fd = s, .events = POLLIN };
+
+		if (poll(&p, 1, 1000) > 0 && (p.revents & POLLIN)) {
+			int c = accept(s, NULL, NULL);
+
+			if (c >= 0) {
+				struct timeval tv = { .tv_sec = 2 };
+
+				setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+				handle(c);
+				close(c);
+			}
+		}
+		tick();
+	}
+	return 0;
+}
diff --git a/linux/waveshare/eh-wifi-sta/main/main.c b/linux/waveshare/eh-wifi-sta/main/main.c
new file mode 100644
index 0000000..70da4a6
--- /dev/null
+++ b/linux/waveshare/eh-wifi-sta/main/main.c
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * eh-wifi-sta — keep the Waveshare on-board ESP32-C6 (ESP-Hosted-MCU 3.0.10)
+ * associated as a Wi-Fi station.
+ *
+ *   eh-wifi-sta [CONFIG_FILE]          (default /etc/wifi/sta.conf)
+ *
+ * CONFIG_FILE holds two lines, "ssid=..." and "psk=...", and must not be
+ * readable by group/other.  The SSID is case-sensitive.  The passphrase is
+ * never printed, logged or passed on a command line.  The process stays
+ * resident (the link is torn down when it exits); IPv4 is configured by the
+ * system DHCP client on ethsta0.
+ */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "esp_log.h"
+#include "esp_wifi.h"
+#include "esp_hosted_examples_common.h"
+
+static const char *TAG = "eh-wifi-sta";
+
+static void wipe(void *p, size_t n)
+{
+	volatile unsigned char *v = p;
+	while (n--)
+		*v++ = 0;
+}
+
+static int read_value(const char *line, const char *key, char *out, size_t cap)
+{
+	size_t k = strlen(key);
+	size_t n;
+
+	if (strncmp(line, key, k) != 0 || line[k] != '=')
+		return 0;
+	line += k + 1;
+	n = strcspn(line, "\r\n");
+	if (n >= cap)
+		return -1;
+	memcpy(out, line, n);
+	out[n] = '\0';
+	return 1;
+}
+
+static int load_config(const char *path, char *ssid, size_t ssid_cap,
+		       char *psk, size_t psk_cap)
+{
+	struct stat st;
+	char line[160];
+	FILE *f;
+	int have_ssid = 0;
+
+	if (stat(path, &st) != 0) {
+		ESP_LOGE(TAG, "%s: %s (run wifi-connect first)", path, strerror(errno));
+		return -1;
+	}
+	if (st.st_mode & 077) {
+		ESP_LOGE(TAG, "%s must not be readable by group/other (chmod 600)", path);
+		return -1;
+	}
+	f = fopen(path, "r");
+	if (!f) {
+		ESP_LOGE(TAG, "%s: %s", path, strerror(errno));
+		return -1;
+	}
+	psk[0] = '\0';
+	while (fgets(line, sizeof(line), f)) {
+		int r = read_value(line, "ssid", ssid, ssid_cap);
+
+		if (r > 0)
+			have_ssid = 1;
+		if (r == 0)
+			r = read_value(line, "psk", psk, psk_cap);
+		if (r < 0) {
+			ESP_LOGE(TAG, "%s: value too long", path);
+			wipe(line, sizeof(line));
+			fclose(f);
+			return -1;
+		}
+	}
+	wipe(line, sizeof(line));
+	fclose(f);
+	if (!have_ssid || !ssid[0]) {
+		ESP_LOGE(TAG, "%s: no ssid= line", path);
+		return -1;
+	}
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *path = argc > 1 ? argv[1] : "/etc/wifi/sta.conf";
+	char ssid[33];	/* 802.11 SSID: up to 32 bytes */
+	char psk[65];	/* WPA2 passphrase 8..63, or 64 hex digits */
+	esp_err_t err;
+
+	if (load_config(path, ssid, sizeof(ssid), psk, sizeof(psk)) != 0)
+		return 1;
+
+	ESP_LOGI(TAG, "starting station for SSID \"%s\"", ssid);
+	err = eh_example_sta_start(ssid, psk);
+	wipe(psk, sizeof(psk));
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "station start failed: %s", esp_err_to_name(err));
+		return 1;
+	}
+	err = esp_wifi_connect();
+	if (err != ESP_OK) {
+		ESP_LOGE(TAG, "esp_wifi_connect: %s", esp_err_to_name(err));
+		return 1;
+	}
+	/* Reconnects are driven by the disconnect handler; stay resident. */
+	for (;;)
+		sleep(3600);
+	return 0;
+}
