+# Redes Wi-Fi para la Waveshare ESP32-P4 (Linux v2).
+#
+# Copia este archivo como  wifi.txt  (en esta misma carpeta raiz de la
+# microSD) y escribi una red por cada par de lineas  ssid= / clave= .
+# La primera red tiene prioridad.  Mayusculas y minusculas importan.
+# Red abierta: deja  clave=  vacio.  Las lineas con # se ignoran.
+# Guardalo como texto plano (TextEdit: Formato > Convertir a texto normal).
+# La placa lo lee al encender (o con: wifi-reload) y nunca lo modifica.
+#
+# ssid=MiRed
+# clave=MiClaveSecreta
+#
+# ssid=OtraRed
+# clave=OtraClave
diff --git a/linux/waveshare/rootfs-overlay/usr/share/udhcpc/default.script.d/50ntp b/linux/waveshare/rootfs-overlay/usr/share/udhcpc/default.script.d/50ntp
new file mode 100755
index 0000000..f5acac8
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/share/udhcpc/default.script.d/50ntp
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Waveshare v2: set the clock from NTP on every DHCP lease and renewal.
+# Sourced by default.script (#40); do not "exit" here.  Use $ACTION, not $1:
+# all hooks share one shell, and 01status runs update-status with
+# "set -- CONNECTED ...", so $1 is no longer the udhcpc action by the time
+# this hook is reached (seen on the board: the hook never fired).
+# time-sync runs in the background so the lease is never held up; it skips
+# itself if a sync is already running.
+case "${ACTION:-$1}" in
+	bound|renew)
+		# A plain "cmd &", not "[ ] && cmd &": a backgrounded list would
+		# need a re-exec'ed subshell on NOMMU ash.
+		if [ -x /usr/sbin/time-sync ]; then
+			/usr/sbin/time-sync >/dev/null 2>&1 &
+		fi
+		;;
+esac
diff --git a/linux/waveshare/sdk/build-cxx-toolchain.sh b/linux/waveshare/sdk/build-cxx-toolchain.sh
new file mode 100755
index 0000000..7bd22c4
--- /dev/null
+++ b/linux/waveshare/sdk/build-cxx-toolchain.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# build-cxx-toolchain.sh - C++ cross toolchain for the Waveshare v2 image.
+#
+# The image is built without C++ (no g++).  This builds a second Buildroot
+# toolchain, in its own output directory, from the image's own .config with
+# BR2_TOOLCHAIN_BUILDROOT_CXX=y: same GCC, uClibc-ng configuration, LinuxThreads
+# and elf2flt, so the static C++ programs it makes run on the board.  The
+# image build directory is only read, never changed.
+#
+# Run inside the build VM (orb -m rv32dev):
+#   bash build-cxx-toolchain.sh [IMAGE_OUTPUT] [CXX_OUTPUT]
+# defaults: ~/ws-out/buildroot  ~/ws-out/cxx-toolchain   (about 6 minutes)
+#
+# Then cxx-ejemplos/Makefile uses CXX_OUTPUT/host/bin/riscv32-...-g++.
+set -euo pipefail
+
+img=${1:-$HOME/ws-out/buildroot}
+out=${2:-$HOME/ws-out/cxx-toolchain}
+src=${BUILDROOT_SRC:-$HOME/ws-out/buildroot-source}
+ext=${BUILDROOT_EXTERNAL:-$HOME/ws-out/buildroot-external}
+dl=${BR2_DL_DIR:-$HOME/src-cache/buildroot/dl}
+
+for d in "$img/.config" "$src/Makefile" "$ext/external.desc"; do
+	[[ -e "$d" ]] || { echo "missing $d (build the image first)" >&2; exit 1; }
+done
+
+mkdir -p "$out"
+cp "$img/.config" "$out/.config"
+sed -i 's/^# BR2_TOOLCHAIN_BUILDROOT_CXX is not set$/BR2_TOOLCHAIN_BUILDROOT_CXX=y/' "$out/.config"
+make -C "$src" O="$out" BR2_EXTERNAL="$ext" BR2_DL_DIR="$dl" olddefconfig >/dev/null
+grep -qx 'BR2_TOOLCHAIN_BUILDROOT_CXX=y' "$out/.config" || {
+	echo "BR2_TOOLCHAIN_BUILDROOT_CXX did not stick in $out/.config" >&2
+	exit 1
+}
+make -C "$src" O="$out" BR2_EXTERNAL="$ext" BR2_DL_DIR="$dl" \
+	BR2_JLEVEL="$(nproc)" toolchain
+
+gxx="$out/host/bin/riscv32-buildroot-linux-uclibc-g++"
+[[ -x "$gxx" ]] || { echo "no $gxx after the build" >&2; exit 1; }
+"$gxx" --version | head -1
+echo "C++ toolchain ready: $gxx"
