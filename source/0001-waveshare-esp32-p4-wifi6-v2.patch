+From: Waveshare ESP32-P4-WIFI6 port
+Subject: [PATCH] extmod: option to link the system mbedTLS 3.x
+
+MICROPY_SSL_MBEDTLS_SYSTEM=1 builds modssl/hashlib/cryptolib against the
+Buildroot mbedTLS (3.6) instead of the bundled 2.28 sources.
+---
+--- a/extmod/extmod.mk
++++ b/extmod/extmod.mk
+@@ -226,6 +226,16 @@
+ 	crypto/rsa.c \
+ 	crypto/sha1.c \
+ 	)
++else ifeq ($(MICROPY_SSL_MBEDTLS_SYSTEM),1)
++# Waveshare v2: link the system mbedTLS 3.x (Buildroot staging) instead of
++# compiling the bundled 2.28 copy; its headers and libraries are found in
++# the cross toolchain sysroot.  The port's own 2.x mbedtls/mbedtls_config.h
++# (found first through -I.) must not be used: name the system one by path.
++CFLAGS_EXTMOD += -DMICROPY_SSL_MBEDTLS=1
++ifneq ($(MICROPY_SSL_MBEDTLS_SYSTEM_CONFIG),)
++CFLAGS_EXTMOD += -DMBEDTLS_CONFIG_FILE='"$(MICROPY_SSL_MBEDTLS_SYSTEM_CONFIG)"'
++endif
++LDFLAGS_MOD += -lmbedtls -lmbedx509 -lmbedcrypto
+ else ifeq ($(MICROPY_SSL_MBEDTLS),1)
+ MBEDTLS_DIR = lib/mbedtls
+ MBEDTLS_CONFIG_FILE ?= \"mbedtls/mbedtls_config.h\"
