diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/boot-save b/linux/waveshare/rootfs-overlay/usr/sbin/boot-save
new file mode 100755
index 0000000..7c86480
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/boot-save
@@ -0,0 +1,39 @@
+#!/bin/sh
+# boot-save — write the /boot drive (config, Wi-Fi network, SSH keys, your
+# programs) to flash so it survives a reboot.  On the Stamp-P4 this happened
+# when the USB host released the drive; the Waveshare has no USB drive, so
+# run this after editing files in /boot.  Uses boot-commit (A/B slots with
+# CRC; the active slot is never erased).
+IMG=/tmp/boot.img
+SNAP=/run/.boot-save.img
+[ -w /run ] || { echo "boot-save: run as root" >&2; exit 1; }
+[ -f "$IMG" ] || { echo "boot-save: $IMG missing" >&2; exit 1; }
+umask 077
+sync
+# Snapshot with /boot read-only so the FAT image is consistent; afterwards
+# restore whatever mode /boot was in (the m3-lab init leaves it ro).
+was_rw=0
+grep -qE '^[^ ]+ /boot [^ ]+ rw[, ]' /proc/mounts && was_rw=1
+if [ "$was_rw" -eq 1 ]; then
+	mount -o remount,ro /boot 2>/dev/null || { echo "boot-save: /boot busy (close open files)" >&2; exit 1; }
+fi
+cp -f "$IMG" "$SNAP"; rc=$?
+[ "$was_rw" -eq 1 ] && mount -o remount,rw /boot 2>/dev/null
+[ "$rc" -eq 0 ] || { rm -f "$SNAP"; echo "boot-save: snapshot failed" >&2; exit 1; }
+rc=0
+/usr/sbin/boot-commit "$SNAP" || rc=$?
+rm -f "$SNAP"
+# v2: with a WSDATA microSD mounted, the card's copy is the one applied at
+# boot (S06sd), so mirror the configuration files there too.
+if grep -q ' /mnt/sd ' /proc/mounts && [ -d /mnt/sd/persist/config ]; then
+	for f in credentials.txt authorized_keys root_authorized_keys wifi-sta.conf config.txt wifi-networks.conf ap.conf; do
+		[ -f "/boot/$f" ] && cp -f "/boot/$f" "/mnt/sd/persist/config/$f"
+	done
+	sync
+	echo "boot-save: configuration copied to the microSD"
+fi
+case "$rc" in
+	0) echo "boot-save: saved to flash" ;;
+	2) echo "boot-save: staged; it is written to flash at the next reboot" ;;
+	*) echo "boot-save: FAILED (rc=$rc), nothing saved" >&2; exit 1 ;;
+esac
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/time-sync b/linux/waveshare/rootfs-overlay/usr/sbin/time-sync
new file mode 100755
index 0000000..d12d229
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/time-sync
@@ -0,0 +1,106 @@
+#!/bin/sh
+# time-sync — Waveshare ESP32-P4-WIFI6 v2: clock and time zone.
+#
+# The board has no RTC: at boot S05tmpfs sets the clock to the build date.
+# This sets it from NTP once (ntpd -q, nothing stays resident).  It runs from
+# the udhcpc hook (default.script.d/50ntp) on every lease and renewal, and by
+# hand:
+#
+#   time-sync          sync now (prints the result)
+#   time-sync status   last result
+#   time-sync tz       apply the time zone (run at boot by S07time)
+#
+# /boot/config.txt (also kept on the microSD by S06sd):
+#   ntp_server=pool.ntp.org             one or more, space separated; "none"
+#                                       disables NTP
+#   timezone=America/Argentina/Cordoba  a name from the table below, or a POSIX
+#                                       TZ string such as <-03>3 or UTC0
+#
+# There is no zoneinfo database on the board: uClibc reads the POSIX string
+# from /etc/TZ (a link to /run/TZ).
+
+CFG=/boot/config.txt
+STATUS=/run/time-sync.status
+PIDF=/run/time-sync.pid
+DEFAULT_SERVER=pool.ntp.org
+DEFAULT_TZ='<-03>3'
+TIMEOUT_S=60
+
+# First "key=" value in config.txt (CRLF and blanks around it allowed).
+conf_get() {
+	[ -r "$CFG" ] || return 0
+	sed -n -e "s/$(printf '\r')\$//" \
+		-e "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CFG" |
+		sed -e 's/[[:space:]]*$//' | head -n 1
+}
+
+tz_posix() {
+	case "$1" in
+		"") echo "$DEFAULT_TZ" ;;
+		America/Argentina/*|America/Buenos_Aires|America/Cordoba|America/Montevideo|America/Sao_Paulo)
+			echo '<-03>3' ;;
+		America/Santiago) echo '<-04>4<-03>,M9.1.6/24,M4.1.6/24' ;;
+		America/Asuncion|America/La_Paz|America/Caracas) echo '<-04>4' ;;
+		America/Bogota|America/Lima) echo '<-05>5' ;;
+		America/Mexico_City) echo 'CST6' ;;
+		America/New_York) echo 'EST5EDT,M3.2.0,M11.1.0' ;;
+		Europe/Madrid|Europe/Paris|Europe/Berlin|Europe/Rome)
+			echo 'CET-1CEST,M3.5.0,M10.5.0/3' ;;
+		Europe/London|Europe/Lisbon) echo 'GMT0BST,M3.5.0/1,M10.5.0' ;;
+		UTC|Etc/UTC|GMT) echo 'UTC0' ;;
+		*/*) return 1 ;;
+		*) echo "$1" ;;
+	esac
+}
+
+apply_tz() {
+	name=$(conf_get timezone)
+	if ! tz=$(tz_posix "$name"); then
+		echo "time-sync: unknown time zone '$name', using $DEFAULT_TZ" >&2
+		tz=$DEFAULT_TZ
+	fi
+	umask 022
+	printf '%s\n' "$tz" > /run/TZ.new && mv -f /run/TZ.new /run/TZ
+	echo "time-sync: time zone ${name:-default} -> $tz"
+}
+
+do_sync() {
+	if [ -f "$PIDF" ] && read -r p < "$PIDF" && kill -0 "$p" 2>/dev/null; then
+		echo "time-sync: already running (pid $p)"
+		return 0
+	fi
+	echo $$ > "$PIDF"
+	srv=$(conf_get ntp_server)
+	[ -n "$srv" ] || srv=$DEFAULT_SERVER
+	if [ "$srv" = none ]; then
+		echo "disabled $(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$STATUS"
+		rm -f "$PIDF"
+		echo "time-sync: ntp_server=none, not syncing"
+		return 0
+	fi
+	peers=""
+	for s in $srv; do peers="$peers -p $s"; done
+	before=$(date +%s)
+	# -q: set the clock once and exit.  timeout: an unreachable server must
+	# not leave ntpd retrying forever.
+	# rc is taken right after the command: BusyBox ash reports 0 for $? read
+	# inside the else branch of "if cmd" (seen on the board).
+	timeout "$TIMEOUT_S" ntpd -n -q $peers >/dev/null 2>&1
+	rc=$?
+	if [ "$rc" -eq 0 ]; then
+		after=$(date +%s)
+		echo "ok $(date -u '+%Y-%m-%dT%H:%M:%SZ') step=$((after - before))s server=$srv" > "$STATUS"
+	else
+		echo "fail $(date -u '+%Y-%m-%dT%H:%M:%SZ') rc=$rc server=$srv" > "$STATUS"
+	fi
+	rm -f "$PIDF"
+	cat "$STATUS"
+	return $rc
+}
+
+case "${1:-sync}" in
+	sync|now) do_sync ;;
+	status) cat "$STATUS" 2>/dev/null || echo "never synced (clock = build date)"; date ;;
+	tz) apply_tz ;;
+	*) echo "Usage: $0 [sync|status|tz]" >&2; exit 1 ;;
+esac
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect
new file mode 100755
index 0000000..84cf445
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-connect
@@ -0,0 +1,46 @@
+#!/bin/sh
+# wifi-connect [SSID] — save a Wi-Fi network and join it (Waveshare v2).
+#
+# Asks for the SSID (unless given; case-sensitive) and the passphrase, which
+# is read without echo and never printed.  The network goes first in
+# /boot/wifi-networks.conf (also kept on the microSD), so it has the highest
+# priority; then eh-wifid is told to join it.  Leave the passphrase empty
+# for an open network.
+#
+# Without a keyboard: write ssid=/clave= lines in wifi.txt on the microSD
+# (FAT partition WSFILES) from a computer instead.
+. /usr/lib/board/wifi-lib.sh
+wl_need_root
+ssid=$1
+if [ -z "$ssid" ]; then
+	printf 'SSID (case-sensitive): '
+	IFS= read -r ssid || exit 1
+fi
+[ -n "$ssid" ] || { echo "empty SSID" >&2; exit 1; }
+[ ${#ssid} -le 32 ] || { echo "an SSID has at most 32 bytes" >&2; exit 1; }
+stty -echo 2>/dev/null
+printf 'Passphrase (not shown, empty = open network): '
+IFS= read -r psk
+rc=$?
+stty echo 2>/dev/null
+echo
+[ "$rc" -eq 0 ] || exit 1
+n=${#psk}
+if [ "$n" -ne 0 ] && { [ "$n" -lt 8 ] || [ "$n" -gt 64 ]; }; then
+	psk=""
+	echo "wifi-connect: a WPA2 passphrase has 8..63 characters" >&2
+	exit 1
+fi
+wl_boot_rw || { psk=""; exit 1; }
+{ printf 'ssid=%s\n' "$ssid"; printf 'psk=%s\n' "$psk"; wl_drop_ssid "$NETS" "$ssid"; } > "$NETS.new" ||
+	{ psk=""; exit 1; }
+psk=""
+mv -f "$NETS.new" "$NETS" || exit 1
+wl_boot_done
+echo "Saved network \"$ssid\" (first in priority)"
+if wl_daemon_up; then
+	eh-wifictl connect "$ssid"
+	echo "Follow it with: wifi-status"
+else
+	/etc/init.d/S40network restart
+fi
diff --git a/linux/waveshare/rootfs-overlay/usr/sbin/wifi-forget b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-forget
new file mode 100755
index 0000000..9a608f8
--- /dev/null
+++ b/linux/waveshare/rootfs-overlay/usr/sbin/wifi-forget
@@ -0,0 +1,19 @@
+#!/bin/sh
+# wifi-forget SSID — remove a saved Wi-Fi network (Waveshare v2).
+. /usr/lib/board/wifi-lib.sh
+wl_need_root
+[ -n "$1" ] || { echo "usage: wifi-forget SSID   (saved: wifi-status)" >&2; exit 1; }
+if ! wl_ssids "$NETS" | grep -qxF -- "$1"; then
+	echo "wifi-forget: \"$1\" is not in $NETS" >&2
+	wl_ssids "$WIFI_TXT" | grep -qxF -- "$1" &&
+		echo "It is in $WIFI_TXT: remove it there (from the computer or as m5)." >&2
+	exit 1
+fi
+wl_boot_rw || exit 1
+wl_drop_ssid "$NETS" "$1" > "$NETS.new" && mv -f "$NETS.new" "$NETS" || exit 1
+wl_boot_done
+echo "Forgot \"$1\""
+wl_ssids "$WIFI_TXT" | grep -qxF -- "$1" &&
+	echo "Note: \"$1\" is still in $WIFI_TXT and will keep being used."
+wl_daemon_up && eh-wifictl reload
+exit 0
