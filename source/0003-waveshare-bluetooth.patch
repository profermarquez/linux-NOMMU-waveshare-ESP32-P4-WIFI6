+}
+
+int main(int argc, char **argv)
+{
+	int reset_only = (argc > 1);
+
+	say("ble_scan: open AF_BLUETOOTH/HCI socket\n");
+	sk = socket(AF_BLUETOOTH, SOCK_RAW, BTPROTO_HCI);
