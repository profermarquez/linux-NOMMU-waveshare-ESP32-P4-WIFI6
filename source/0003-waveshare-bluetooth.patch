+	 * burst wedged cold boots): request it, then wait out ENODEV while
+	 * the kernel registers hci0 over the C6 SDIO link (a few seconds). */
+	c6_bt_on();
+	int kfd = open("/sys/module/esp_hosted_mcu/parameters/bt_enable", O_WRONLY);
