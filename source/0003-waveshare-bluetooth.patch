diff --git a/linux/waveshare/ble-tools/LEEME.md b/linux/waveshare/ble-tools/LEEME.md
new file mode 100644
index 0000000..b7d3309
--- /dev/null
+++ b/linux/waveshare/ble-tools/LEEME.md
@@ -0,0 +1,41 @@
+# ble-tools (Waveshare ESP32-P4-WIFI6)
+
+`hci_up`, `ble_scan` y `ble_adv`, tomados de linux-waveshare-xc (GPL-2.0-only),
+y `ble_server` con sus scripts `ble-ap` y `ble-server`, hechos para esta placa.
+Hablan HCI directo con el controlador BLE del C6 por un socket
+`HCI_CHANNEL_USER`: no usan BlueZ, que necesita MMU.
+
+Cada uno hace dos cosas antes de usar `hci0`:
+1. Enciende el controlador BT del C6 con `bt-on`, que le pide a `eh-wifid`.
+   Si `hci0` se registra con el controlador apagado, el primer HCI Reset del
+   kernel falla (-110) y `hci0` queda ocupado hasta reiniciar.
+2. Pide el registro de `hci0` escribiendo 1 en
+   `/sys/module/esp_hosted_mcu/parameters/bt_enable`.
+
+Si el kernel ya levanto `hci0`, los programas lo bajan
+(`HCIDEVDOWN`) y lo toman. Si el firmware del C6 no trae Bluetooth, avisan
+que no hay `hci0`.
+
+- `ble_scan` escanea 20 s y muestra dirección, RSSI y nombre. `ble_scan reset`
+  solo prueba la ida y vuelta con el controlador.
+- `ble_adv [NOMBRE]` anuncia la placa hasta que se lo corta (no se puede
+  conectar).
+- `ble_server [NOMBRE]` anuncia la placa **conectable** y atiende un servidor
+  GATT propio (HCI, L2CAP, ATT y SMP escritos aca):
+  - Nordic UART Service: el celular escribe en RX y recibe en TX. `info` y
+    `uptime` tienen respuesta; el resto vuelve como `echo: ...`. Lo escrito en
+    la entrada estandar va al celular. Nada de lo que llega se ejecuta.
+  - Device Information: fabricante y modelo.
+  - Una conexion por vez; despues de desconectar vuelve a anunciar.
+  - Emparejamiento "Just Works" (sin PIN, sin proteccion MITM, no guarda
+    claves): el enlace va cifrado, pero cualquiera cerca se puede conectar.
+- `ble-ap [NOMBRE]`, `ble-ap stop`, `ble-ap status`: `ble_server` en segundo
+  plano, con log en `/run/ble-ap.log`.
+- `ble-server [NOMBRE]`: `ble_server` en primer plano, para probar a mano.
+- `hci_up` registra `hci0` y hace `HCIDEVUP`, el camino del kernel. Es para
+  diagnóstico.
+
+No pueden correr dos a la vez: el segundo recibe `EBUSY`.
+
+El C6 solo tiene BLE: no hay Bluetooth clasico (A2DP, parlante, SPP) ni LE
+Audio.
diff --git a/linux/waveshare/ble-tools/ble-ap b/linux/waveshare/ble-tools/ble-ap
new file mode 100755
index 0000000..19ad575
--- /dev/null
+++ b/linux/waveshare/ble-tools/ble-ap
@@ -0,0 +1,58 @@
+#!/bin/sh
+# ble-ap — leave the BLE server running in the background: the board
+# advertises as a connectable BLE device (Nordic UART Service) that a phone
+# can connect to.  Log in /run/ble-ap.log.
+#
+#   ble-ap [NAME]     start (NAME defaults to the hostname)
+#   ble-ap stop       stop it
+#   ble-ap status     running or not, and the last log lines
+#
+# Only one BLE tool can use the controller at a time: stop it before
+# ble_scan, ble_adv or ble-server.  Pairing is "Just Works" (no PIN):
+# anyone nearby can connect, so do not send secrets.
+PID=/run/ble-ap.pid
+LOG=/run/ble-ap.log
+
+running() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }
+
+case "${1:-}" in
+	stop)
+		if running; then
+			kill "$(cat "$PID")"
+			n=0
+			while running && [ "$n" -lt 20 ]; do sleep 0.2; n=$((n + 1)); done
+			echo "ble-ap: stopped"
+		else
+			echo "ble-ap: not running"
+		fi
+		rm -f "$PID"
+		;;
+	status)
+		if running; then echo "ble-ap: running (pid $(cat "$PID"))"; else echo "ble-ap: not running"; fi
+		[ -f "$LOG" ] && tail -n 8 "$LOG"
+		;;
+	-h|--help)
+		sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
+		;;
+	*)
+		if running; then
+			echo "ble-ap: already running (pid $(cat "$PID")); 'ble-ap stop' first"
+			exit 1
+		fi
+		ble_server "$@" </dev/null >"$LOG" 2>&1 &
+		echo $! > "$PID"
+		n=0
+		while [ "$n" -lt 40 ] && ! grep -q "advertising as\|failed\|no hci0\|bind" "$LOG" 2>/dev/null; do
+			sleep 0.25; n=$((n + 1))
+		done
+		if running && grep -q "advertising as" "$LOG"; then
+			grep "advertising as" "$LOG"
+			echo "ble-ap: log in $LOG ('ble-ap status', 'ble-ap stop')"
+		else
+			cat "$LOG"
+			echo "ble-ap: did not start"
+			rm -f "$PID"
+			exit 1
+		fi
+		;;
+esac
diff --git a/linux/waveshare/ble-tools/ble-server b/linux/waveshare/ble-tools/ble-server
new file mode 100755
index 0000000..890a531
--- /dev/null
+++ b/linux/waveshare/ble-tools/ble-server
@@ -0,0 +1,13 @@
+#!/bin/sh
+# ble-server — interactive BLE test server in the foreground.  The board
+# advertises as NAME (default: hostname); connect from a phone app that
+# knows the Nordic UART Service (nRF Connect, Serial Bluetooth Terminal).
+# What the phone writes appears here; lines you type go to the phone.
+# The phone can also send 'info' or 'uptime'.  Ctrl-C to stop.
+#
+#   ble-server [NAME]
+if [ -f /run/ble-ap.pid ] && kill -0 "$(cat /run/ble-ap.pid)" 2>/dev/null; then
+	echo "ble-server: ble-ap is running in the background; 'ble-ap stop' first"
+	exit 1
+fi
+exec ble_server "$@"
