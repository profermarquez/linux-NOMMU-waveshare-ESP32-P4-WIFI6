+# The C6 SDIO link sometimes fails at boot (about 1 in 9 soft reboots,
+# 2026-11-27): mmc1 enumerates the C6, then the C6 stops answering and the
+# esp_hosted_mcu probe fails with -110, so no ethsta0.  Re-enumerating mmc1
+# from Linux (dw_mmc unbind/bind plus a GPIO54 C6 reset) does not bring it
+# back and the kernel cannot unload modules, but a full reboot does (the
+# boot shim sets up the slot and resets the C6).  So reboot, at most
+# SDIO_RETRY_MAX times in a row.  The count survives the reboot in the
+# previous boot's console log (pstore console-ramoops, kept across a warm
+# reboot); a boot that comes up fine leaves no mark, so the count restarts.
+SDIO_FUNC=/sys/bus/sdio/devices/mmc1:0001:1
+SDIO_RETRY_MAX=2
+SDIO_MARK="WS-NET: SDIO retry reboot"
+
+sdio_check() {
+	n=0
+	while [ ! -e "$SDIO_FUNC/driver" ] && [ "$n" -lt 5 ]; do
+		n=$((n + 1))
+		sleep 1
+	done
+	[ -e "$SDIO_FUNC/driver" ] && return 0
+	prev=0
+	for f in /sys/fs/pstore/console-ramoops-*; do
+		[ -r "$f" ] || continue
+		p=$(sed -n "s/.*$SDIO_MARK \([0-9][0-9]*\).*/\1/p" "$f" | tail -n 1)
+		[ -n "$p" ] && prev=$p
+	done
+	if [ "$prev" -ge "$SDIO_RETRY_MAX" ]; then
+		log "ERROR: C6 SDIO link still down after $prev retry reboots; not retrying (dmesg | grep mmc1)"
+		return 1
+	fi
+	n=$((prev + 1))
+	# Level 3 so it reaches the console and therefore the pstore record.
+	echo "<3>$SDIO_MARK $n of $SDIO_RETRY_MAX: the C6 did not answer on SDIO" > /dev/kmsg
+	log "C6 SDIO link down: rebooting (retry $n of $SDIO_RETRY_MAX)"
+	sync
+	reboot
+	sleep 30
+}
