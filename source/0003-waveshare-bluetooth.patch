diff --git a/linux/buildroot-external/package/ble-tools/ble-tools.mk b/linux/buildroot-external/package/ble-tools/ble-tools.mk
new file mode 100644
index 0000000..e4ff6ec
--- /dev/null
+++ b/linux/buildroot-external/package/ble-tools/ble-tools.mk
@@ -0,0 +1,32 @@
+################################################################################
+# ble-tools: hci_up, ble_scan, ble_adv, ble_server + ble-ap, ble-server
+# (Waveshare BLE, WS_BT=1)
+################################################################################
+
+BLE_TOOLS_VERSION = 1.0
+BLE_TOOLS_SITE = $(BR2_EXTERNAL_STAMP_P4_PATH)/../waveshare/ble-tools
+BLE_TOOLS_SITE_METHOD = local
+BLE_TOOLS_LICENSE = GPL-2.0-only
+BLE_TOOLS_PROGS = hci_up ble_scan ble_adv ble_server
+BLE_TOOLS_SCRIPTS = ble-ap ble-server
+
+define BLE_TOOLS_BUILD_CMDS
+	for p in $(BLE_TOOLS_PROGS); do \
+		$(TARGET_CC) $(TARGET_CFLAGS) -std=gnu11 -Wall -Os \
+			$(TARGET_LDFLAGS) -o $(@D)/$$p $(@D)/$$p.c || exit 1; \
+	done
+endef
+
+# m3-lab: every program needs a bFLT stack of at least 16000 bytes.
+define BLE_TOOLS_INSTALL_TARGET_CMDS
+	for p in $(BLE_TOOLS_PROGS); do \
+		$(INSTALL) -D -m 0755 $(@D)/$$p $(TARGET_DIR)/usr/bin/$$p || exit 1; \
+		$(HOST_DIR)/bin/$(GNU_TARGET_NAME)-flthdr -s 16384 $(TARGET_DIR)/usr/bin/$$p || exit 1; \
+		rm -f $(TARGET_DIR)/usr/bin/$$p.gdb; \
+	done
+	for s in $(BLE_TOOLS_SCRIPTS); do \
+		$(INSTALL) -D -m 0755 $(@D)/$$s $(TARGET_DIR)/usr/bin/$$s || exit 1; \
+	done
+endef
+
+$(eval $(generic-package))
diff --git a/linux/buildroot-external/package/eh-wifi-sta/0003-linux-host-no-bt-stack-adapter.patch b/linux/buildroot-external/package/eh-wifi-sta/0003-linux-host-no-bt-stack-adapter.patch
new file mode 100644
index 0000000..08ea489
--- /dev/null
+++ b/linux/buildroot-external/package/eh-wifi-sta/0003-linux-host-no-bt-stack-adapter.patch
@@ -0,0 +1,22 @@
+From: Waveshare ESP32-P4-WIFI6 port
+Subject: [PATCH] Linux host: no BT host-stack adapter with FEAT_BT
+
+CONFIG_ESP_HOSTED_HOST_FEAT_BT pulled in esp_hosted_bt_host_stack, the
+NimBLE/Bluedroid adapter for MCU hosts, which needs FreeRTOS headers and
+does not build for a POSIX host.  On Linux the HCI traffic goes through
+the kernel module (hci0); eh-wifid only needs the controller RPCs
+(eh_host_bt_controller_*) from eh_host_feat_bt.
+---
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -106,7 +106,9 @@
+     add_subdirectory("${EH_PATH}/host"         ${CMAKE_BINARY_DIR}/host)
+ endif()
+ 
+-if(CONFIG_ESP_HOSTED_HOST_FEAT_BT)
++# The NimBLE/Bluedroid adapter is for MCU hosts (FreeRTOS).  A Linux host
++# reaches the controller through the kernel module's hci0 instead.
++if(CONFIG_ESP_HOSTED_HOST_FEAT_BT AND NOT CONFIG_ESP_HOSTED_HOST_PORT_TYPE_POSIX)
+     add_subdirectory("${EH_PATH}/examples/common_components/esp_hosted_bt_host_stack"
+                      ${CMAKE_BINARY_DIR}/esp_hosted_bt_host_stack)
+ endif()
diff --git a/linux/buildroot-external/package/esp-hosted-mcu/0002-bt-hci-on-demand.patch b/linux/buildroot-external/package/esp-hosted-mcu/0002-bt-hci-on-demand.patch
new file mode 100644
index 0000000..3ff19f3
--- /dev/null
+++ b/linux/buildroot-external/package/esp-hosted-mcu/0002-bt-hci-on-demand.patch
@@ -0,0 +1,138 @@
+From: Waveshare ESP32-P4-WIFI6 port
+Subject: [PATCH] eh_host_linux_kmod: register the BT HCI device on demand
+
+With CONFIG_BT_ENABLED the module registered hci0 as soon as the
+co-processor reported BT over SDIO, while the SDIO link was still coming
+up.  The earlier linux-waveshare-xc port of this board saw that burst
+wedge the kernel (its patches 0030/0035), and nothing uses BT at boot.
+
+New parameter bt_enable (default 0): writing 1 to
+/sys/module/esp_hosted_mcu/parameters/bt_enable registers the HCI device
+from a work item, once the link is up and only if the co-processor
+reports BT; otherwise it logs why not.  Registration and teardown are
+serialised by a mutex.  A co-processor reset tears hci0 down as before;
+with bt_enable still 1 it is registered again after the new boot-up event.
+---
+--- a/host/linux/eh_host_linux_kmod/driver/src/main.c
++++ b/host/linux/eh_host_linux_kmod/driver/src/main.c
+@@ -29,6 +29,7 @@
+ #include <linux/netdevice.h>
+ #include <linux/gpio.h>
+ #include <linux/workqueue.h>
++#include <linux/mutex.h>
+ /* Linux 7.x warns unless a bound workqueue names WQ_PERCPU explicitly. */
+ #include <linux/version.h>
+ /* WQ_PERCPU is an enum constant, not a macro: test the kernel version. */
+@@ -124,6 +125,69 @@
+ MODULE_PARM_DESC(spi_dataready, "SPI: Data Ready GPIO number");
+ 
+ struct esp_adapter adapter;
++
++/*
++ * Waveshare ESP32-P4-WIFI6: HCI registration on demand.
++ *
++ * Registering the HCI device while the SDIO link is still coming up is
++ * what wedged the kernel in the earlier linux-waveshare-xc port of this
++ * board (its patches 0030/0035).  Nothing needs BT at boot, so the device
++ * is registered only when someone asks for it:
++ *
++ *   echo 1 > /sys/module/esp_hosted_mcu/parameters/bt_enable
++ *
++ * (hci_up / ble_scan / ble_adv do it themselves).  It is one-way until the
++ * co-processor resets; with a co-processor that reports no BT over SDIO
++ * the request only logs that.
++ */
++static DEFINE_MUTEX(esp_bt_lock);
++static bool esp_bt_enable;
++
++static bool esp_bt_cap(u32 cap)
++{
++	return (cap & ESP_BT_SPI_SUPPORT) || (cap & ESP_BT_SDIO_SUPPORT);
++}
++
++static void esp_bt_enable_work_fn(struct work_struct *work)
++{
++	int ret;
++
++	mutex_lock(&esp_bt_lock);
++	if (!esp_bt_enable || adapter.hcidev) {
++		/* nothing to do */
++	} else if (!adapter.if_context ||
++		   atomic_read(&adapter.state) != ESP_CONTEXT_READY) {
++		esp_info("bt_enable: co-processor link not ready yet\n");
++	} else if (!esp_bt_cap(adapter.capabilities)) {
++		esp_info("bt_enable: co-processor firmware has no BT over SDIO "
++			 "(capabilities 0x%x)\n", adapter.capabilities);
++	} else {
++		esp_info("bt_enable: registering the HCI device\n");
++		ret = esp_init_bt(&adapter);
++		if (ret)
++			esp_err("Failed to init BT: %d\n", ret);
++	}
++	mutex_unlock(&esp_bt_lock);
++}
++static DECLARE_WORK(esp_bt_enable_work, esp_bt_enable_work_fn);
++
++static int esp_bt_enable_set(const char *val, const struct kernel_param *kp)
++{
++	int ret = param_set_bool(val, kp);
++
++	if (ret)
++		return ret;
++	if (esp_bt_enable)
++		schedule_work(&esp_bt_enable_work);
++	return 0;
++}
++
++static const struct kernel_param_ops esp_bt_enable_ops = {
++	.set = esp_bt_enable_set,
++	.get = param_get_bool,
++};
++module_param_cb(bt_enable, &esp_bt_enable_ops, &esp_bt_enable, 0644);
++MODULE_PARM_DESC(bt_enable, "1 = register the HCI device (BLE) now; nothing at boot by default");
+ volatile u8 stop_data = 0;
+ 
+ 
+@@ -557,7 +621,6 @@
+ void process_capabilities(u8 cap)
+ {
+ 	struct esp_adapter *adapter = esp_get_adapter();
+-	int ret;
+ 
+ 	if (!adapter) {
+ 		esp_err("NULL adapter\n");
+@@ -568,14 +631,18 @@
+ 	adapter->capabilities = cap;
+ 
+ 	/* Reset BT */
++	mutex_lock(&esp_bt_lock);
+ 	esp_deinit_bt(adapter);
++	mutex_unlock(&esp_bt_lock);
+ 	msleep(200);
+ 
+-	if ((cap & ESP_BT_SPI_SUPPORT) || (cap & ESP_BT_SDIO_SUPPORT)) {
+-		ret = esp_init_bt(adapter);
+-		if (ret) {
+-			esp_err("Failed to init BT: %d\n", ret);
+-		}
++	if (esp_bt_cap(cap)) {
++		/* Waveshare: register the HCI device only on request (bt_enable). */
++		if (esp_bt_enable)
++			schedule_work(&esp_bt_enable_work);
++		else
++			esp_info("BT available on the co-processor; HCI registration deferred "
++				 "(echo 1 > /sys/module/esp_hosted_mcu/parameters/bt_enable)\n");
+ 	} else if (cap & ESP_BT_UART_SUPPORT) {
+ 		// do nothing
+ 	} else {
+@@ -1320,7 +1387,10 @@
+ 
+ 	esp_serial_cleanup();
+ 
++	cancel_work_sync(&esp_bt_enable_work);
++	mutex_lock(&esp_bt_lock);
+ 	esp_deinit_bt(&adapter);
++	mutex_unlock(&esp_bt_lock);
+ 	msleep(200);
+ 
+ #if TEST_RAW_TP
