diff --git a/linux/kernel-patches/0094-esp32p4-waveshare-audio.patch b/linux/kernel-patches/0094-esp32p4-waveshare-audio.patch
new file mode 100644
index 0000000..2968d7b
--- /dev/null
+++ b/linux/kernel-patches/0094-esp32p4-waveshare-audio.patch
@@ -0,0 +1,785 @@
+Waveshare ESP32-P4-WIFI6: ES8311 PCM device /dev/ws-audio (capture + playback).
+
+Adapted from linux-waveshare-xc's esp32p4-xc-audio (patch 0043 there).
+The boot shim (ws_audio.c) configures the codec and I2S1.
+
+--- a/drivers/misc/Kconfig
++++ b/drivers/misc/Kconfig
+@@ -655,6 +655,15 @@
+ 	  boot shim, which turns the C6 off and puts the chip into Deep
+ 	  Sleep until a timer or LP GPIO wakes it.
+ 
++config ESP32P4_WS_AUDIO
++	bool "Waveshare ESP32-P4-WIFI6: ES8311 PCM device (/dev/ws-audio)"
++	depends on SOC_ESP32P4 && !MMU
++	help
++	  Minimal read/write PCM device for the ES8311 codec of the Waveshare
++	  ESP32-P4-WIFI6: 16 kHz, S16_LE, two channels; read() records the
++	  microphone, write() plays on the speaker.  The boot shim configures
++	  the codec and I2S1; Linux runs DMA rings on AHB-GDMA channel 2.
++
+ source "drivers/misc/c2port/Kconfig"
+ source "drivers/misc/eeprom/Kconfig"
+ source "drivers/misc/cb710/Kconfig"
+--- a/drivers/misc/Makefile
++++ b/drivers/misc/Makefile
+@@ -76,3 +76,4 @@
+ obj-$(CONFIG_MISC_RP1)		+= rp1/
+ obj-$(CONFIG_ESP32P4_BOOTFLASH)	+= esp32p4-bootflash.o
+ obj-$(CONFIG_ESP32P4_SLEEP)	+= esp32p4-sleep.o
++obj-$(CONFIG_ESP32P4_WS_AUDIO)	+= esp32p4-ws-audio.o
+--- /dev/null
++++ b/drivers/misc/esp32p4-ws-audio.c
+@@ -0,0 +1,752 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * Lightweight PCM driver for the Waveshare ESP32-P4-WIFI6 (ES8311 codec).
++ *
++ * Started from linux-waveshare-xc's esp32p4-xc-audio.  On the WIFI6 board
++ * the ES8311 alone does both directions: the analog microphone comes back on
++ * I2S DIN (GPIO11), the DAC drives the on-board amplifier (enable: GPIO53)
++ * and the SPK header.
++ *
++ * The ESP-IDF boot shim (ws_audio.c) configures the pins, I2S1 (full duplex:
++ * TX master, RX a slave sharing BCLK/LRCK) and the codec, then disables its
++ * channels before the jump.  Linux keeps that configuration and owns I2S1,
++ * AHB-GDMA channel pair 2 and the amplifier GPIO.
++ *
++ * Userspace ABI: /dev/ws-audio, S16_LE, 16000 Hz, two interleaved channels.
++ *   read():  microphone (left channel; right repeats it)
++ *   write(): speaker (the ES8311 DAC mixes both channels to the mono output)
++ * One reader and one writer may have it open at the same time.
++ *
++ * While the device is open the "engine" runs: a circular ring of WS_RING_N
++ * TX DMA descriptors (4080 bytes = 63.75 ms each) plays continuously --
++ * silence when nothing is queued -- because in full duplex RX only gets a
++ * clock while TX runs.  A reader adds a circular RX ring; read() hands out
++ * completed blocks found through the DMA's "last EOF descriptor" register.
++ * write() stages data into whole blocks and queues them ahead of the
++ * hardware; a 30 ms work item zeroes blocks that have been played, so the
++ * ring falls back to silence when the writer stops.  The amplifier is
++ * switched on with the first queued block and off after the writer's last
++ * block has played.  No interrupt: waits sleep in 2-4 ms steps.
++ *
++ * If a reader falls more than the ring behind, the oldest audio is lost:
++ * read() resynchronises and counts an overrun (logged at close).  If a
++ * writer is late, silence is played in between (counted as an underrun).
++ */
++
++#include <linux/atomic.h>
++#include <linux/bitops.h>
++#include <linux/delay.h>
++#include <linux/fs.h>
++#include <linux/gpio/consumer.h>
++#include <linux/io.h>
++#include <linux/iopoll.h>
++#include <linux/jiffies.h>
++#include <linux/miscdevice.h>
++#include <linux/module.h>
++#include <linux/mutex.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/sched/signal.h>
++#include <linux/slab.h>
++#include <linux/uaccess.h>
++#include <linux/workqueue.h>
++
++#define WS_AUDIO_RATE		16000
++#define WS_AUDIO_CHANNELS	2
++#define WS_AUDIO_BITS		16
++#define WS_BLOCK		4080	/* bytes per DMA block: 63.75 ms */
++
++#define I2S_RX_CONF		0x020
++#define I2S_TX_CONF		0x024
++#define I2S_RX_EOF_NUM		0x064
++#define I2S_CONF_RESET		BIT(0)
++#define I2S_CONF_FIFO_RESET	BIT(1)
++#define I2S_CONF_START		BIT(2)
++#define I2S_TX_STOP_EN		BIT(4)
++#define I2S_CONF_UPDATE		BIT(8)
++
++#define DMA_IN_INT_RAW_CH2	0x020
++#define DMA_IN_INT_CLR_CH2	0x02c
++#define DMA_OUT_INT_RAW_CH2	0x050
++#define DMA_OUT_INT_CLR_CH2	0x05c
++#define DMA_MISC_CONF		0x064
++#define DMA_IN_CONF0_CH2	0x1f0
++#define DMA_IN_CONF1_CH2	0x1f4
++#define DMA_IN_LINK_CH2		0x200
++#define DMA_IN_SUC_EOF_DES_ADDR_CH2	0x208
++#define DMA_IN_PERI_SEL_CH2	0x220
++#define DMA_OUT_CONF0_CH2	0x250
++#define DMA_OUT_CONF1_CH2	0x254
++#define DMA_OUT_LINK_CH2	0x260
++#define DMA_OUT_EOF_DES_ADDR_CH2	0x268
++#define DMA_OUT_PERI_SEL_CH2	0x280
++#define DMA_IN_LINK_ADDR_CH2	0x3b4
++#define DMA_OUT_LINK_ADDR_CH2	0x3c0
++#define DMA_ARB_CONF		0x404
++
++#define DMA_IN_SUC_EOF		BIT(1)
++#define DMA_OUT_EOF		BIT(1)
++#define DMA_CONF_RESET		BIT(0)
++#define DMA_OUT_EOF_MODE	BIT(3)
++#define DMA_IN_LINK_STOP	BIT(1)
++#define DMA_IN_LINK_START	BIT(2)
++#define DMA_OUT_LINK_STOP	BIT(0)
++#define DMA_OUT_LINK_START	BIT(1)
++#define DMA_I2S1_TRIGGER	4
++
++#define DESC_SUC_EOF		BIT(30)
++#define DESC_OWNER_DMA		BIT(31)
++
++#define CLKRST_SOC_CLK_CTRL1	0x018
++#define CLKRST_SOC_CLK_CTRL2	0x01c
++#define CLKRST_PERI_CLK_CTRL14	0x050
++#define CLKRST_PERI_CLK_CTRL15	0x054
++#define CLKRST_AHB_PDMA_CLK	BIT(3)
++#define CLKRST_I2S1_APB_CLK	BIT(15)
++#define CLKRST_I2S1_RX_CLK	BIT(20)
++#define CLKRST_I2S1_TX_CLK	BIT(28)
++
++/* P4 ROM cache helpers: Cache_WriteBack_Addr / Cache_Invalidate_Addr, the
++ * same address in esp32p4.rom.ld and esp32p4.rom.eco5.ld (chip v3.x). */
++#define ESP32P4_CACHE_MAP_L1D_L2 0x30
++typedef int (*esp32p4_cache_op_t)(u32 map, u32 addr, u32 size);
++#define esp32p4_cache_writeback ((esp32p4_cache_op_t)0x4fc003f4)
++#define esp32p4_cache_invalidate ((esp32p4_cache_op_t)0x4fc003e4)
++
++struct ws_dma_desc {
++	u32 control;
++	u32 buffer;
++	u32 next;
++};
++
++/* 8 x 63.75 ms = 510 ms per ring. */
++#define WS_RING_N		8
++#define WS_RING_STRIDE		4096	/* cache-line aligned slots */
++#define WS_BLOCK_JIFFIES	msecs_to_jiffies(64)
++#define WS_JANITOR_MS		30
++
++struct ws_ring {
++	struct ws_dma_desc *desc;	/* WS_RING_N descriptors */
++	u8 *buf;			/* WS_RING_N * WS_RING_STRIDE bytes */
++};
++
++struct ws_audio {
++	struct device *dev;
++	void __iomem *i2s;
++	void __iomem *dma;
++	void __iomem *clkrst;
++	struct gpio_desc *pa;		/* amplifier enable, optional */
++	struct miscdevice miscdev;
++	struct mutex lock;		/* everything below */
++	struct delayed_work janitor;
++	struct ws_ring rx, tx;
++	bool engine;			/* TX ring running */
++	bool reader, writer;		/* openers */
++	/* capture */
++	bool rx_running;
++	bool first_block;
++	unsigned int cons;		/* next RX slot to hand out */
++	unsigned int cons_off;		/* bytes of that slot already read */
++	unsigned long last_progress;
++	unsigned long overruns;
++	/* playback */
++	bool pa_on;
++	bool queued[WS_RING_N];		/* slot holds data not yet played */
++	unsigned int ahead;		/* queued slots */
++	unsigned int wnext;		/* next slot to queue */
++	int tx_last;			/* last TX slot reported done */
++	unsigned long tx_reaped;	/* jiffies of the last reap */
++	u8 *stage;			/* WS_BLOCK bytes being filled by write() */
++	unsigned int stage_len;
++	unsigned long underruns;
++};
++
++static void ws_cache_writeback(const void *addr, size_t size)
++{
++	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D_L2, (u32)(uintptr_t)addr, size);
++}
++
++static void ws_cache_invalidate(const void *addr, size_t size)
++{
++	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D_L2, (u32)(uintptr_t)addr, size);
++}
++
++static void ws_enable_clocks(struct ws_audio *audio)
++{
++	u32 value;
++
++	value = readl(audio->clkrst + CLKRST_SOC_CLK_CTRL1);
++	writel(value | CLKRST_AHB_PDMA_CLK, audio->clkrst + CLKRST_SOC_CLK_CTRL1);
++	value = readl(audio->clkrst + CLKRST_SOC_CLK_CTRL2);
++	writel(value | CLKRST_I2S1_APB_CLK, audio->clkrst + CLKRST_SOC_CLK_CTRL2);
++	value = readl(audio->clkrst + CLKRST_PERI_CLK_CTRL14);
++	writel(value | CLKRST_I2S1_RX_CLK, audio->clkrst + CLKRST_PERI_CLK_CTRL14);
++	value = readl(audio->clkrst + CLKRST_PERI_CLK_CTRL15);
++	writel(value | CLKRST_I2S1_TX_CLK, audio->clkrst + CLKRST_PERI_CLK_CTRL15);
++
++	value = readl(audio->dma + DMA_MISC_CONF);
++	writel(value | BIT(3), audio->dma + DMA_MISC_CONF);
++	value = readl(audio->dma + DMA_ARB_CONF);
++	writel(value | BIT(27) | BIT(28), audio->dma + DMA_ARB_CONF);
++}
++
++static int ws_i2s_start(struct ws_audio *audio, bool capture)
++{
++	void __iomem *conf = audio->i2s + (capture ? I2S_RX_CONF : I2S_TX_CONF);
++	u32 value;
++	int ret;
++
++	value = readl(conf) & ~I2S_CONF_START;
++	if (!capture)
++		value &= ~I2S_TX_STOP_EN;	/* keep BCLK/LRCK running */
++	writel(value | I2S_CONF_RESET | I2S_CONF_FIFO_RESET, conf);
++	writel(value & ~(I2S_CONF_RESET | I2S_CONF_FIFO_RESET), conf);
++	writel(value | I2S_CONF_UPDATE, conf);
++	ret = readl_poll_timeout(conf, value, !(value & I2S_CONF_UPDATE), 1, 1000);
++	if (ret)
++		return ret;
++	writel(readl(conf) | I2S_CONF_START, conf);
++	return 0;
++}
++
++static void ws_i2s_stop(struct ws_audio *audio, bool capture)
++{
++	void __iomem *conf = audio->i2s + (capture ? I2S_RX_CONF : I2S_TX_CONF);
++
++	writel(readl(conf) & ~I2S_CONF_START, conf);
++}
++
++/* Circular descriptor ring over WS_RING_N slots.  TX descriptors carry the
++ * full length and suc_eof so every block raises an "out EOF". */
++static phys_addr_t ws_ring_link(struct ws_ring *r, bool tx)
++{
++	phys_addr_t d0 = virt_to_phys(r->desc);
++	int i;
++
++	for (i = 0; i < WS_RING_N; i++) {
++		r->desc[i].control = WS_BLOCK | DESC_OWNER_DMA;
++		if (tx)
++			r->desc[i].control |= (WS_BLOCK << 12) | DESC_SUC_EOF;
++		r->desc[i].buffer = lower_32_bits(virt_to_phys(r->buf + i * WS_RING_STRIDE));
++		r->desc[i].next = lower_32_bits(d0 + ((i + 1) % WS_RING_N) *
++						sizeof(struct ws_dma_desc));
++	}
++	ws_cache_writeback(r->desc, WS_RING_N * sizeof(struct ws_dma_desc));
++	return d0;
++}
++
++static int ws_desc_index(struct ws_ring *r, u32 addr)
++{
++	u32 d0 = lower_32_bits(virt_to_phys(r->desc));
++
++	if (addr < d0 || addr >= d0 + WS_RING_N * sizeof(struct ws_dma_desc))
++		return -1;
++	return (addr - d0) / sizeof(struct ws_dma_desc);
++}
++
++/* ---- engine: TX ring, always running while the device is open ---- */
++
++static int ws_engine_start(struct ws_audio *audio)
++{
++	phys_addr_t d0;
++	int ret;
++
++	ws_enable_clocks(audio);
++	memset(audio->tx.buf, 0, WS_RING_N * WS_RING_STRIDE);
++	ws_cache_writeback(audio->tx.buf, WS_RING_N * WS_RING_STRIDE);
++	d0 = ws_ring_link(&audio->tx, true);
++	memset(audio->queued, 0, sizeof(audio->queued));
++	audio->ahead = 0;
++	audio->stage_len = 0;
++	/* desc 0 plays first: treat slot N-1 as "last done" */
++	audio->tx_last = WS_RING_N - 1;
++	audio->wnext = 1;
++	audio->tx_reaped = jiffies;
++
++	writel(DMA_OUT_LINK_STOP, audio->dma + DMA_OUT_LINK_CH2);
++	writel(DMA_CONF_RESET, audio->dma + DMA_OUT_CONF0_CH2);
++	writel(DMA_OUT_EOF_MODE, audio->dma + DMA_OUT_CONF0_CH2);
++	writel(0, audio->dma + DMA_OUT_CONF1_CH2);	/* no owner check: circular */
++	writel(DMA_I2S1_TRIGGER, audio->dma + DMA_OUT_PERI_SEL_CH2);
++	writel(0xff, audio->dma + DMA_OUT_INT_CLR_CH2);
++	writel(lower_32_bits(d0), audio->dma + DMA_OUT_LINK_ADDR_CH2);
++	writel(DMA_OUT_LINK_START, audio->dma + DMA_OUT_LINK_CH2);
++
++	ret = ws_i2s_start(audio, false);
++	if (ret) {
++		writel(DMA_OUT_LINK_STOP, audio->dma + DMA_OUT_LINK_CH2);
++		dev_warn(audio->dev, "I2S TX did not start (%d)\n", ret);
++		return ret;
++	}
++	audio->engine = true;
++	schedule_delayed_work(&audio->janitor, msecs_to_jiffies(WS_JANITOR_MS));
++	return 0;
++}
++
++static void ws_engine_stop(struct ws_audio *audio)
++{
++	if (!audio->engine)
++		return;
++	ws_i2s_stop(audio, false);
++	writel(DMA_OUT_LINK_STOP, audio->dma + DMA_OUT_LINK_CH2);
++	audio->engine = false;
++}
++
++static void ws_pa(struct ws_audio *audio, bool on)
++{
++	if (!audio->pa || audio->pa_on == on)
++		return;
++	gpiod_set_value_cansleep(audio->pa, on);
++	audio->pa_on = on;
++}
++
++/* Account for TX blocks the hardware has finished; zero them so the ring
++ * plays silence once the writer stops.  Called with the lock held. */
++static void ws_tx_reap(struct ws_audio *audio)
++{
++	int idx;
++
++	if (!(readl(audio->dma + DMA_OUT_INT_RAW_CH2) & DMA_OUT_EOF))
++		return;
++	idx = ws_desc_index(&audio->tx, readl(audio->dma + DMA_OUT_EOF_DES_ADDR_CH2));
++	if (idx < 0 || idx == audio->tx_last)
++		return;
++
++	if (time_after(jiffies, audio->tx_reaped + (WS_RING_N - 1) * WS_BLOCK_JIFFIES)) {
++		/* not reaped for a whole ring: everything queued has played */
++		int s;
++
++		for (s = 0; s < WS_RING_N; s++) {
++			if (audio->queued[s]) {
++				memset(audio->tx.buf + s * WS_RING_STRIDE, 0, WS_BLOCK);
++				ws_cache_writeback(audio->tx.buf + s * WS_RING_STRIDE, WS_BLOCK);
++				audio->queued[s] = false;
++			}
++		}
++		audio->ahead = 0;
++	} else {
++		int s = audio->tx_last;
++
++		while (s != idx) {
++			s = (s + 1) % WS_RING_N;
++			if (audio->queued[s]) {
++				memset(audio->tx.buf + s * WS_RING_STRIDE, 0, WS_BLOCK);
++				ws_cache_writeback(audio->tx.buf + s * WS_RING_STRIDE, WS_BLOCK);
++				audio->queued[s] = false;
++				audio->ahead--;
++			}
++		}
++	}
++	audio->tx_last = idx;
++	audio->tx_reaped = jiffies;
++}
++
++static void ws_janitor(struct work_struct *work)
++{
++	struct ws_audio *audio = container_of(to_delayed_work(work), struct ws_audio, janitor);
++
++	mutex_lock(&audio->lock);
++	if (audio->engine) {
++		ws_tx_reap(audio);
++		schedule_delayed_work(&audio->janitor, msecs_to_jiffies(WS_JANITOR_MS));
++	}
++	mutex_unlock(&audio->lock);
++}
++
++/* Queue the staged block.  Waits (lock dropped) while the ring is full. */
++static int ws_tx_commit(struct ws_audio *audio)
++{
++	u8 *slot;
++
++	for (;;) {
++		ws_tx_reap(audio);
++		if (audio->ahead == 0) {
++			/* idle or late: start right after the block now playing */
++			audio->wnext = (audio->tx_last + 2) % WS_RING_N;
++			if (audio->pa_on)
++				audio->underruns++;
++		}
++		if (audio->ahead < WS_RING_N - 2)
++			break;
++		mutex_unlock(&audio->lock);
++		usleep_range(3000, 5000);
++		mutex_lock(&audio->lock);
++		if (signal_pending(current))
++			return -ERESTARTSYS;
++	}
++	slot = audio->tx.buf + audio->wnext * WS_RING_STRIDE;
++	memcpy(slot, audio->stage, WS_BLOCK);
++	ws_cache_writeback(slot, WS_BLOCK);
++	audio->queued[audio->wnext] = true;
++	audio->ahead++;
++	audio->wnext = (audio->wnext + 1) % WS_RING_N;
++	audio->stage_len = 0;
++	ws_pa(audio, true);
++	return 0;
++}
++
++/* Writer closing: queue the partial block, let everything play, amp off. */
++static void ws_tx_drain(struct ws_audio *audio)
++{
++	unsigned long deadline = jiffies + (WS_RING_N + 2) * WS_BLOCK_JIFFIES;
++
++	if (audio->stage_len) {
++		memset(audio->stage + audio->stage_len, 0, WS_BLOCK - audio->stage_len);
++		ws_tx_commit(audio);
++	}
++	while (audio->ahead && time_before(jiffies, deadline)) {
++		mutex_unlock(&audio->lock);
++		usleep_range(5000, 8000);
++		mutex_lock(&audio->lock);
++		ws_tx_reap(audio);
++	}
++	/* one more block of silence before the amplifier goes off (no pop) */
++	mutex_unlock(&audio->lock);
++	msleep(70);
++	mutex_lock(&audio->lock);
++	ws_pa(audio, false);
++}
++
++/* ---- capture: RX ring ---- */
++
++static int ws_rx_start(struct ws_audio *audio)
++{
++	phys_addr_t d0;
++
++	ws_cache_writeback(audio->rx.buf, WS_RING_N * WS_RING_STRIDE);
++	ws_cache_invalidate(audio->rx.buf, WS_RING_N * WS_RING_STRIDE);
++	d0 = ws_ring_link(&audio->rx, false);
++
++	writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++	writel(DMA_CONF_RESET, audio->dma + DMA_IN_CONF0_CH2);
++	writel(0, audio->dma + DMA_IN_CONF0_CH2);
++	writel(0, audio->dma + DMA_IN_CONF1_CH2);	/* no owner check: circular */
++	writel(DMA_I2S1_TRIGGER, audio->dma + DMA_IN_PERI_SEL_CH2);
++	writel(0xff, audio->dma + DMA_IN_INT_CLR_CH2);
++	writel(lower_32_bits(d0), audio->dma + DMA_IN_LINK_ADDR_CH2);
++	writel(WS_BLOCK, audio->i2s + I2S_RX_EOF_NUM);
++	writel(DMA_IN_LINK_START, audio->dma + DMA_IN_LINK_CH2);
++
++	audio->cons = 0;
++	audio->cons_off = 0;
++	audio->first_block = true;
++	audio->last_progress = jiffies;
++	audio->overruns = 0;
++	if (ws_i2s_start(audio, true)) {
++		writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++		dev_warn(audio->dev, "capture: I2S RX did not start\n");
++		return -EIO;
++	}
++	audio->rx_running = true;
++	return 0;
++}
++
++static void ws_rx_stop(struct ws_audio *audio)
++{
++	if (!audio->rx_running)
++		return;
++	ws_i2s_stop(audio, true);
++	writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++	audio->rx_running = false;
++}
++
++/* Index of the newest completed RX slot, or -1 if none yet. */
++static int ws_rx_newest(struct ws_audio *audio)
++{
++	if (!(readl(audio->dma + DMA_IN_INT_RAW_CH2) & DMA_IN_SUC_EOF))
++		return -1;
++	return ws_desc_index(&audio->rx, readl(audio->dma + DMA_IN_SUC_EOF_DES_ADDR_CH2));
++}
++
++/* Wait until RX slot audio->cons is complete.  0, or a negative error.
++ * Called with the lock held; drops it while sleeping. */
++static int ws_rx_wait(struct ws_audio *audio)
++{
++	unsigned long deadline = jiffies + msecs_to_jiffies(500);
++
++	for (;;) {
++		int newest = ws_rx_newest(audio);
++
++		if (newest >= 0) {
++			unsigned int avail = (newest - audio->cons + 1 + WS_RING_N) % WS_RING_N;
++
++			/* more than a ring without consuming: the DMA lapped us */
++			if (time_after(jiffies, audio->last_progress +
++				       (WS_RING_N - 1) * WS_BLOCK_JIFFIES)) {
++				audio->overruns++;
++				audio->cons = newest;
++				audio->cons_off = 0;
++				audio->last_progress = jiffies;
++				return 0;
++			}
++			if (avail)
++				return 0;
++		}
++		if (time_after(jiffies, deadline))
++			return -ETIMEDOUT;
++		mutex_unlock(&audio->lock);
++		usleep_range(2000, 4000);
++		mutex_lock(&audio->lock);
++		if (signal_pending(current))
++			return -ERESTARTSYS;
++	}
++}
++
++/* ---- file operations ---- */
++
++static int ws_audio_open(struct inode *inode, struct file *file)
++{
++	struct miscdevice *miscdev = file->private_data;
++	struct ws_audio *audio = container_of(miscdev, struct ws_audio, miscdev);
++	bool rd = file->f_mode & FMODE_READ, wr = file->f_mode & FMODE_WRITE;
++	int ret = 0;
++
++	mutex_lock(&audio->lock);
++	if ((rd && audio->reader) || (wr && audio->writer)) {
++		ret = -EBUSY;
++		goto out;
++	}
++	if (!audio->engine) {
++		ret = ws_engine_start(audio);
++		if (ret)
++			goto out;
++	}
++	if (rd) {
++		ret = ws_rx_start(audio);
++		if (ret)
++			goto out_stop;
++		audio->reader = true;
++	}
++	if (wr) {
++		audio->writer = true;
++		audio->stage_len = 0;
++		audio->underruns = 0;
++	}
++	file->private_data = audio;
++	mutex_unlock(&audio->lock);
++	return nonseekable_open(inode, file);
++
++out_stop:
++	if (!audio->reader && !audio->writer)
++		ws_engine_stop(audio);
++out:
++	mutex_unlock(&audio->lock);
++	return ret;
++}
++
++static int ws_audio_release(struct inode *inode, struct file *file)
++{
++	struct ws_audio *audio = file->private_data;
++	bool rd = file->f_mode & FMODE_READ, wr = file->f_mode & FMODE_WRITE;
++
++	mutex_lock(&audio->lock);
++	if (wr && audio->writer) {
++		ws_tx_drain(audio);
++		audio->writer = false;
++		if (audio->underruns)
++			dev_info(audio->dev, "playback: %lu underrun(s) (writer too slow)\n",
++				 audio->underruns);
++	}
++	if (rd && audio->reader) {
++		ws_rx_stop(audio);
++		audio->reader = false;
++		if (audio->overruns)
++			dev_info(audio->dev, "capture: %lu overrun(s) (reader too slow)\n",
++				 audio->overruns);
++	}
++	if (!audio->reader && !audio->writer) {
++		ws_pa(audio, false);
++		ws_engine_stop(audio);
++	}
++	mutex_unlock(&audio->lock);
++	if (!audio->engine)
++		cancel_delayed_work_sync(&audio->janitor);
++	return 0;
++}
++
++static ssize_t ws_audio_read(struct file *file, char __user *buf,
++			     size_t count, loff_t *ppos)
++{
++	struct ws_audio *audio = file->private_data;
++	size_t done = 0;
++	ssize_t ret = 0;
++
++	count &= ~3UL;
++	if (!count)
++		return -EINVAL;
++	if (mutex_lock_interruptible(&audio->lock))
++		return -ERESTARTSYS;
++	while (done < count) {
++		u8 *slot;
++		size_t n;
++
++		if (audio->cons_off == 0) {
++			ret = ws_rx_wait(audio);
++			if (ret) {
++				if (ret == -ETIMEDOUT)
++					dev_warn_ratelimited(audio->dev,
++						"capture DMA timed out (no I2S clock?)\n");
++				break;
++			}
++			slot = audio->rx.buf + audio->cons * WS_RING_STRIDE;
++			ws_cache_invalidate(slot, WS_BLOCK);
++			if (audio->first_block) {
++				/* stale FIFO word before the first real frame */
++				memcpy(slot, slot + 4, 4);
++				audio->first_block = false;
++			}
++		}
++		slot = audio->rx.buf + audio->cons * WS_RING_STRIDE;
++		n = min_t(size_t, count - done, WS_BLOCK - audio->cons_off);
++		if (copy_to_user(buf + done, slot + audio->cons_off, n)) {
++			ret = -EFAULT;
++			break;
++		}
++		done += n;
++		audio->cons_off += n;
++		if (audio->cons_off >= WS_BLOCK) {
++			audio->cons_off = 0;
++			audio->cons = (audio->cons + 1) % WS_RING_N;
++			audio->last_progress = jiffies;
++		}
++	}
++	mutex_unlock(&audio->lock);
++	return done ? done : ret;
++}
++
++static ssize_t ws_audio_write(struct file *file, const char __user *buf,
++			      size_t count, loff_t *ppos)
++{
++	struct ws_audio *audio = file->private_data;
++	size_t done = 0;
++	ssize_t ret = 0;
++
++	count &= ~3UL;
++	if (!count)
++		return -EINVAL;
++	if (mutex_lock_interruptible(&audio->lock))
++		return -ERESTARTSYS;
++	while (done < count) {
++		size_t n = min_t(size_t, count - done, WS_BLOCK - audio->stage_len);
++
++		if (copy_from_user(audio->stage + audio->stage_len, buf + done, n)) {
++			ret = -EFAULT;
++			break;
++		}
++		audio->stage_len += n;
++		done += n;
++		if (audio->stage_len == WS_BLOCK) {
++			ret = ws_tx_commit(audio);
++			if (ret) {
++				audio->stage_len = 0;
++				break;
++			}
++		}
++	}
++	mutex_unlock(&audio->lock);
++	return done ? done : ret;
++}
++
++static const struct file_operations ws_audio_fops = {
++	.owner = THIS_MODULE,
++	.open = ws_audio_open,
++	.release = ws_audio_release,
++	.read = ws_audio_read,
++	.write = ws_audio_write,
++};
++
++static int ws_alloc_ring(struct device *dev, struct ws_ring *r)
++{
++	phys_addr_t b, d;
++
++	r->buf = devm_kmalloc(dev, WS_RING_N * WS_RING_STRIDE, GFP_KERNEL);
++	r->desc = devm_kcalloc(dev, WS_RING_N, sizeof(*r->desc), GFP_KERNEL);
++	if (!r->buf || !r->desc)
++		return -ENOMEM;
++	b = virt_to_phys(r->buf);
++	d = virt_to_phys(r->desc);
++	if (upper_32_bits(b) || upper_32_bits(d) ||
++	    b < 0x40000000 || b + WS_RING_N * WS_RING_STRIDE > 0x4ffc0000 ||
++	    d < 0x40000000 || d >= 0x4ffc0000) {
++		dev_err(dev, "DMA ring outside the ESP32-P4 DMA range\n");
++		return -ERANGE;
++	}
++	return 0;
++}
++
++static int ws_audio_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct ws_audio *audio;
++	int ret;
++
++	audio = devm_kzalloc(dev, sizeof(*audio), GFP_KERNEL);
++	if (!audio)
++		return -ENOMEM;
++	audio->dev = dev;
++	audio->i2s = devm_platform_ioremap_resource_byname(pdev, "i2s");
++	if (IS_ERR(audio->i2s))
++		return PTR_ERR(audio->i2s);
++	audio->dma = devm_platform_ioremap_resource_byname(pdev, "ahb-dma");
++	if (IS_ERR(audio->dma))
++		return PTR_ERR(audio->dma);
++	audio->clkrst = devm_platform_ioremap_resource_byname(pdev, "clkrst");
++	if (IS_ERR(audio->clkrst))
++		return PTR_ERR(audio->clkrst);
++	audio->pa = devm_gpiod_get_optional(dev, "pa", GPIOD_OUT_LOW);
++	if (IS_ERR(audio->pa))
++		return dev_err_probe(dev, PTR_ERR(audio->pa), "amplifier GPIO\n");
++
++	ret = ws_alloc_ring(dev, &audio->rx);
++	if (!ret)
++		ret = ws_alloc_ring(dev, &audio->tx);
++	if (ret)
++		return ret;
++	audio->stage = devm_kmalloc(dev, WS_BLOCK, GFP_KERNEL);
++	if (!audio->stage)
++		return -ENOMEM;
++
++	mutex_init(&audio->lock);
++	INIT_DELAYED_WORK(&audio->janitor, ws_janitor);
++	audio->miscdev.minor = MISC_DYNAMIC_MINOR;
++	audio->miscdev.name = "ws-audio";
++	audio->miscdev.fops = &ws_audio_fops;
++	audio->miscdev.parent = dev;
++	/* Single-user board: let m5 record and play without root. */
++	audio->miscdev.mode = 0666;
++	ret = misc_register(&audio->miscdev);
++	if (ret)
++		return ret;
++	platform_set_drvdata(pdev, audio);
++	dev_info(dev, "/dev/ws-audio: %d Hz, %d-bit, %d-channel PCM, capture + playback, %d x %d-byte rings%s\n",
++		 WS_AUDIO_RATE, WS_AUDIO_BITS, WS_AUDIO_CHANNELS, WS_RING_N, WS_BLOCK,
++		 audio->pa ? ", amplifier on GPIO" : ", no amplifier GPIO");
++	return 0;
++}
++
++static void ws_audio_remove(struct platform_device *pdev)
++{
++	struct ws_audio *audio = platform_get_drvdata(pdev);
++
++	misc_deregister(&audio->miscdev);
++	cancel_delayed_work_sync(&audio->janitor);
++}
++
++static const struct of_device_id ws_audio_of_match[] = {
++	{ .compatible = "waveshare,esp32p4-wifi6-audio" },
++	{}
++};
++MODULE_DEVICE_TABLE(of, ws_audio_of_match);
++
++static struct platform_driver ws_audio_driver = {
++	.probe = ws_audio_probe,
++	.remove = ws_audio_remove,
++	.driver = {
++		.name = "esp32p4-ws-audio",
++		.of_match_table = ws_audio_of_match,
++	},
++};
++module_platform_driver(ws_audio_driver);
++
++MODULE_DESCRIPTION("Waveshare ESP32-P4-WIFI6 lightweight PCM audio (ES8311)");
++MODULE_LICENSE("GPL");
