+// SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-only
+/*
+ * Waveshare ESP32-P4-WIFI6: prepare the ES8311 codec and I2S1 for Linux and
+ * check the on-board microphone before the jump.
+ *
+ * Wiring (Waveshare BSP waveshare/esp32_p4_platform 2.0.1, header
+ * esp32_p4_platform.h, and its 12_I2SCodec example):
+ *   I2C (codec control): SDA GPIO7, SCL GPIO8, ES8311 at 0x18
+ *   I2S: MCLK 13, BCLK 12, LRCK 10, DOUT 9 (to DSDIN), DIN 11 (from ASDOUT)
+ *   Power amplifier enable: GPIO53, active high (OFF here; Linux turns it on
+ *   while it plays)
+ *   Speaker: SPK header (MX1.25 2P, 8 ohm 2 W) on the amplifier output
+ *   Microphone: analog, into the ES8311 ADC (digital_mic = false)
+ *
+ * ESP-IDF owns the clock and GPIO-matrix setup.  Linux inherits the
+ * configured I2S1 registers; its small audio driver (linux-waveshare-xc's
+ * esp32p4-xc-audio, adapted) only starts/stops transfers on AHB-GDMA
+ * channel 2.  As in that project, the I2S channels are disabled before the
+ * jump so no ESP-IDF DMA or interrupt stays active, and GPIO7/8 are handed
+ * back as plain GPIO so Linux's i2c-gpio bus keeps working.
+ *
+ * With -DWS_SPEAKER_TEST it first checks the speaker (speaker_beep(): tone
+ * heard back by the microphone, codec registers, three beeps; off by default).  Then it records MIC_TEST_MS of audio and logs
+ * the level of each channel, so the serial console shows whether the
+ * microphone works without any Linux driver:
+ *   ws_audio: mic L rms=... peak=... dc=...  R rms=... peak=...
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <math.h>
+#include <inttypes.h>
+
+#include "driver/gpio.h"
+#include "driver/i2c_master.h"
+#include "driver/i2s_std.h"
+#include "esp_codec_dev.h"
+#include "esp_codec_dev_defaults.h"
+#include "esp_log.h"
+#include "esp_rom_gpio.h"
+#include "soc/gpio_sig_map.h"
+#include "soc/gpio_reg.h"
+#include "soc/soc.h"
+
+#include "ws_audio.h"
+
+#define WS_I2C_PORT	I2C_NUM_1
+#define WS_I2C_SDA	GPIO_NUM_7
+#define WS_I2C_SCL	GPIO_NUM_8
+#define WS_I2S_PORT	I2S_NUM_1
+#define WS_I2S_MCLK	GPIO_NUM_13
+#define WS_I2S_BCLK	GPIO_NUM_12
+#define WS_I2S_WS	GPIO_NUM_10
+#define WS_I2S_DOUT	GPIO_NUM_9
+#define WS_I2S_DIN	GPIO_NUM_11
+#define WS_PA_ENABLE	GPIO_NUM_53
+
+#define WS_RATE		16000
+#define WS_CHANNELS	2
+#define WS_BITS		16
+#define WS_MIC_GAIN_DB	24.0f	/* Waveshare BSP default */
+#define WS_OUT_VOLUME	90	/* esp_codec_dev 0..100; 70 gave ES8311 0x32 = 0xa8 (-11.5 dB) */
+#define MIC_TEST_MS	500
+#define MIC_SKIP_MS	100	/* ADC start-up transient */
+#define MIC_CHUNK	3200	/* 50 ms of stereo S16 */
+
+static const char *TAG = "ws_audio";
+static i2s_chan_handle_t rx_chan;
+static i2s_chan_handle_t tx_chan;
+static i2c_master_bus_handle_t i2c_bus;
+static esp_codec_dev_handle_t codec;
+
+static void pa_off(void)
+{
+	const gpio_config_t cfg = {
+		.pin_bit_mask = 1ULL << WS_PA_ENABLE,
+		.mode = GPIO_MODE_OUTPUT,
+		.pull_up_en = GPIO_PULLUP_DISABLE,
+		.pull_down_en = GPIO_PULLDOWN_DISABLE,
+		.intr_type = GPIO_INTR_DISABLE,
+	};
+
+	gpio_config(&cfg);
+	gpio_set_level(WS_PA_ENABLE, 0);
+}
+
+static void release_i2c_pins(void)
+{
+	const gpio_num_t pins[] = { WS_I2C_SDA, WS_I2C_SCL };
+
+	/* Linux drives GPIO7/8 as a bit-banged I2C bus (/dev/i2c-0).  Put the
+	 * GPIO matrix back to plain GPIO, inputs with pull-ups (bus idle). */
+	for (unsigned int i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		esp_rom_gpio_connect_out_signal(pins[i], SIG_GPIO_OUT_IDX, false, false);
+		gpio_set_direction(pins[i], GPIO_MODE_INPUT);
+		gpio_set_pull_mode(pins[i], GPIO_PULLUP_ONLY);
+	}
+}
+
+static esp_err_t init_i2s(void)
+{
+	i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(WS_I2S_PORT, I2S_ROLE_MASTER);
+	i2s_std_config_t std_cfg = {
+		.clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(WS_RATE),
+		.slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT,
+								I2S_SLOT_MODE_STEREO),
+		.gpio_cfg = {
+			.mclk = WS_I2S_MCLK,
+			.bclk = WS_I2S_BCLK,
+			.ws = WS_I2S_WS,
+			.dout = WS_I2S_DOUT,
+			.din = WS_I2S_DIN,
+		},
+	};
+	esp_err_t err;
+
+	chan_cfg.auto_clear = true;
+	std_cfg.clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
+
+	/*
+	 * Full duplex, as ESP-IDF sets it up: TX is the master and RX a slave
+	 * sharing BCLK/LRCK (rx_slave_mod, tx_conf.sig_loopback).  Under Linux
+	 * RX therefore only gets a clock while TX runs, so the Linux driver
+	 * keeps a TX DMA ring running (silence when nothing plays) for as long
+	 * as /dev/ws-audio is open in either direction.
+	 */
+	err = i2s_new_channel(&chan_cfg, &tx_chan, &rx_chan);
+	if (err == ESP_OK)
+		err = i2s_channel_init_std_mode(tx_chan, &std_cfg);
+	if (err == ESP_OK)
+		err = i2s_channel_init_std_mode(rx_chan, &std_cfg);
+	if (err == ESP_OK)
+		err = i2s_channel_enable(tx_chan);
+	if (err == ESP_OK)
+		err = i2s_channel_enable(rx_chan);
+	return err;
+}
+
+static esp_err_t init_i2c(void)
+{
+	const i2c_master_bus_config_t cfg = {
+		.i2c_port = WS_I2C_PORT,
+		.sda_io_num = WS_I2C_SDA,
+		.scl_io_num = WS_I2C_SCL,
+		.clk_source = I2C_CLK_SRC_DEFAULT,
+		.glitch_ignore_cnt = 7,
+		.flags.enable_internal_pullup = true,
+	};
+
+	return i2c_new_master_bus(&cfg, &i2c_bus);
+}
+
+static esp_err_t init_codec(void)
+{
+	const audio_codec_gpio_if_t *gpio_if = audio_codec_new_gpio();
+	audio_codec_i2s_cfg_t data_cfg = {
+		.port = WS_I2S_PORT,
+		.rx_handle = rx_chan,
+		.tx_handle = tx_chan,
+	};
+	const audio_codec_data_if_t *data_if = audio_codec_new_i2s_data(&data_cfg);
+	audio_codec_i2c_cfg_t i2c_cfg = {
+		.port = WS_I2C_PORT,
+		.addr = ES8311_CODEC_DEFAULT_ADDR,
+		.bus_handle = i2c_bus,
+	};
+	const audio_codec_ctrl_if_t *ctrl_if = audio_codec_new_i2c_ctrl(&i2c_cfg);
+	es8311_codec_cfg_t es_cfg = {
+		.ctrl_if = ctrl_if,
+		.gpio_if = gpio_if,
+		.codec_mode = ESP_CODEC_DEV_WORK_MODE_BOTH,
+		.pa_pin = -1,		/* amplifier stays off (pa_off) */
+		.master_mode = false,
+		.use_mclk = true,
+		.digital_mic = false,	/* analog microphone (Waveshare BSP) */
+		.no_dac_ref = true,	/* right channel not filled with DAC output */
+		.mclk_div = I2S_MCLK_MULTIPLE_256,
+		.hw_gain = {
+			.pa_voltage = 5.0,
+			.codec_dac_voltage = 3.3,
+		},
+	};
+	esp_codec_dev_sample_info_t sample = {
+		.sample_rate = WS_RATE,
+		.channel = WS_CHANNELS,
+		.bits_per_sample = WS_BITS,
+	};
+	const audio_codec_if_t *codec_if;
+	esp_codec_dev_cfg_t dev_cfg;
+
+	if (!gpio_if || !data_if || !ctrl_if)
+		return ESP_ERR_NO_MEM;
+	codec_if = es8311_codec_new(&es_cfg);
+	if (!codec_if)
+		return ESP_ERR_NOT_FOUND;	/* usually: no ACK at 0x18 */
+	dev_cfg = (esp_codec_dev_cfg_t) {
+		.dev_type = ESP_CODEC_DEV_TYPE_IN_OUT,
+		.codec_if = codec_if,
+		.data_if = data_if,
+	};
+	codec = esp_codec_dev_new(&dev_cfg);
+	if (!codec)
+		return ESP_ERR_NO_MEM;
+	if (esp_codec_dev_open(codec, &sample) != ESP_CODEC_DEV_OK)
+		return ESP_FAIL;
+	esp_codec_dev_set_in_gain(codec, WS_MIC_GAIN_DB);
+	/* DAC level for Linux playback: the player scales in software. */
+	esp_codec_dev_set_out_vol(codec, WS_OUT_VOLUME);
+	return ESP_OK;
+}
+
+/* Record MIC_TEST_MS and log RMS, peak and DC offset of both channels. */
+static void mic_level_test(void)
+{
+	int16_t *buf = malloc(MIC_CHUNK);
+	const int total = WS_RATE * MIC_TEST_MS / 1000;	/* frames */
+	const int skip = WS_RATE * MIC_SKIP_MS / 1000;
+	int64_t sum[2] = { 0, 0 };
+	double sq[2] = { 0, 0 };
+	int peak[2] = { 0, 0 };
+	int frames = 0, seen = 0;
+
+	if (!buf) {
+		ESP_LOGW(TAG, "mic test: no memory");
+		return;
+	}
+	while (seen < total) {
+		if (esp_codec_dev_read(codec, buf, MIC_CHUNK) != ESP_CODEC_DEV_OK) {
+			ESP_LOGW(TAG, "mic test: read failed after %d frames", seen);
+			break;
+		}
+		for (int i = 0; i < MIC_CHUNK / 4 && seen < total; i++, seen++) {
+			if (seen < skip)
+				continue;
+			for (int c = 0; c < 2; c++) {
+				int v = buf[2 * i + c];
+				sum[c] += v;
+				sq[c] += (double)v * v;
+				if (abs(v) > peak[c])
+					peak[c] = abs(v);
+			}
+			frames++;
+		}
+	}
+	free(buf);
+	if (frames == 0)
+		return;
+	for (int c = 0; c < 2; c++) {
+		double mean = (double)sum[c] / frames;
+		double var = sq[c] / frames - mean * mean;
+
+		ESP_LOGI(TAG, "mic %c rms=%d peak=%d dc=%d (%d frames, gain %.0f dB)",
+			 c ? 'R' : 'L', (int)sqrt(var > 0 ? var : 0), peak[c],
+			 (int)mean, frames, WS_MIC_GAIN_DB);
+	}
+}
+
+/*
+ * ESP-IDF's I2S driver took an AHB-GDMA channel for I2S1 (channel 0 on the
+ * board) and leaves its peripheral selector pointing at I2S1 after the
+ * channel is disabled.  The Linux driver uses channel 2; with two channels
+ * selecting I2S1 the data went to IDF's idle channel and every Linux read
+ * timed out (I2S INT_RAW rx_done + rx_hung, ch2 never got a byte).  Point
+ * every other AHB-GDMA channel that still selects I2S1 back to "none".
+ */
+#define AHB_DMA_BASE		0x50085000u
+#define AHB_DMA_CH_STRIDE	0xc0u
+#define AHB_DMA_IN_PERI_SEL	0x0a0u	/* channel 0; + n * stride */
+#define AHB_DMA_OUT_PERI_SEL	0x100u
+#define GDMA_PERI_NONE		0x3fu
+#define GDMA_PERI_I2S1		4u	/* SOC_GDMA_TRIG_PERIPH_I2S1 */
+#define LINUX_AUDIO_DMA_CH	2u
+
+static void release_idf_dma(void)
+{
+	for (uint32_t ch = 0; ch < 3; ch++) {
+		const uint32_t offs[2] = { AHB_DMA_IN_PERI_SEL, AHB_DMA_OUT_PERI_SEL };
+
+		if (ch == LINUX_AUDIO_DMA_CH)
+			continue;
+		for (int d = 0; d < 2; d++) {
+			volatile uint32_t *sel = (volatile uint32_t *)(uintptr_t)
+				(AHB_DMA_BASE + offs[d] + ch * AHB_DMA_CH_STRIDE);
+
+			if ((*sel & 0x3f) == GDMA_PERI_I2S1) {
+				*sel = GDMA_PERI_NONE;
+				ESP_LOGI(TAG, "AHB-GDMA ch%" PRIu32 " %s: I2S1 selector released for Linux (ch%u)",
+					 ch, d ? "out" : "in", LINUX_AUDIO_DMA_CH);
+			}
+		}
+	}
+}
+
+#ifdef WS_SPEAKER_TEST
+/*
+ * Speaker check (diagnostic), before the microphone setup for Linux:
+ *  1. full duplex at 16 kHz: 0.5 s of silence, then a 1 kHz tone for 1.5 s,
+ *     recording the on-board microphone all the time; logs the microphone
+ *     RMS in silence and during the tone (acoustic loopback: if the speaker
+ *     plays, the tone RMS is clearly higher);
+ *  2. logs ES8311 power/mute/volume registers and the GPIO53 (amplifier
+ *     enable) output level while the tone plays;
+ *  3. three 1 s beeps (660 Hz) with pauses, for a person to hear.
+ * Everything it creates is deleted again, so the RX-only setup for Linux
+ * below is unchanged.  Never fatal.  -DWS_NO_BEEP leaves it out.
+ */
+#define BEEP_VOLUME	70	/* esp_codec_dev 0..100 */
+#define BEEP_AMPLITUDE	8000	/* of 32767, about -12 dBFS */
+#define BEEP_FADE	160	/* 10 ms fade in/out against clicks */
+#define BEEP_CHUNK	320	/* 20 ms */
+
+/* Write one 20 ms chunk of tone (freq 0 = silence) starting at frame k0 of a
+ * tone that is `frames` long; if dev reads too, read 20 ms of microphone
+ * and return its sum of squares (left channel) in *sq. */
+static void dup_chunk(esp_codec_dev_handle_t dev, int16_t *out, int16_t *in,
+		      int freq, int k0, int frames, double *sq)
+{
+	for (int i = 0; i < BEEP_CHUNK; i++) {
+		int k = k0 + i;
+		float g = 1.0f;
+		int16_t v = 0;
+
+		if (freq) {
+			if (k < BEEP_FADE)
+				g = (float)k / BEEP_FADE;
+			else if (frames - k < BEEP_FADE)
+				g = (float)(frames - k) / BEEP_FADE;
+			v = (int16_t)(BEEP_AMPLITUDE * g *
+				      sinf(2.0f * (float)M_PI * freq * k / WS_RATE));
+		}
+		out[2 * i] = v;
+		out[2 * i + 1] = v;
+	}
+	esp_codec_dev_write(dev, out, BEEP_CHUNK * 4);
+	if (in && sq && esp_codec_dev_read(dev, in, BEEP_CHUNK * 4) == ESP_CODEC_DEV_OK) {
+		for (int i = 0; i < BEEP_CHUNK; i++)
+			*sq += (double)in[2 * i] * in[2 * i];
+	}
+}
+
+static void play_and_listen(esp_codec_dev_handle_t dev, int16_t *out, int16_t *in,
+			    int freq, int ms, int skip_ms, double *rms)
+{
+	const int frames = WS_RATE * ms / 1000;
+	double sq = 0;
+	int counted = 0;
+
+	for (int k = 0; k < frames; k += BEEP_CHUNK) {
+		double c = 0;
+
+		dup_chunk(dev, out, in, freq, k, frames, in ? &c : NULL);
+		if (k >= WS_RATE * skip_ms / 1000) {
+			sq += c;
+			counted += BEEP_CHUNK;
+		}
+	}
+	if (rms)
+		*rms = counted ? sqrt(sq / counted) : 0;
+}
+
+static void dump_codec(esp_codec_dev_handle_t dev, const char *when)
+{
+	static const int regs[] = { 0x00, 0x01, 0x0d, 0x0e, 0x12, 0x13, 0x14, 0x31, 0x32, 0x37 };
+	char line[160];
+	int len = 0;
+
+	for (unsigned int i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		int v = -1;
+
+		esp_codec_dev_read_reg(dev, regs[i], &v);
+		len += snprintf(line + len, sizeof(line) - len, " %02x=%02x", regs[i], v & 0xff);
+	}
+	ESP_LOGI(TAG, "speaker test %s: ES8311%s; GPIO53 out=%d", when, line,
+		 (int)((REG_READ(GPIO_OUT1_REG) >> (WS_PA_ENABLE - 32)) & 1));
+}
+
+static void speaker_beep(void)
+{
+	i2s_chan_handle_t tx = NULL, rx = NULL;
+	i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(WS_I2S_PORT, I2S_ROLE_MASTER);
+	i2s_std_config_t std_cfg = {
+		.clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(WS_RATE),
+		.slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT,
+								I2S_SLOT_MODE_STEREO),
+		.gpio_cfg = {
+			.mclk = WS_I2S_MCLK,
+			.bclk = WS_I2S_BCLK,
+			.ws = WS_I2S_WS,
+			.dout = WS_I2S_DOUT,
+			.din = WS_I2S_DIN,
+		},
+	};
+	const audio_codec_gpio_if_t *gpio_if = NULL;
+	const audio_codec_data_if_t *data_if = NULL;
+	const audio_codec_ctrl_if_t *ctrl_if = NULL;
+	const audio_codec_if_t *codec_if = NULL;
+	esp_codec_dev_handle_t dev = NULL;
+	int16_t *out = NULL, *in = NULL;
+	double rms_sil = 0, rms_tone = 0;
+	bool enabled = false;	/* I2S channels still enabled (must be off before Linux) */
+
+	std_cfg.clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;
+	chan_cfg.auto_clear = true;
+	if (i2s_new_channel(&chan_cfg, &tx, &rx) != ESP_OK ||
+	    i2s_channel_init_std_mode(tx, &std_cfg) != ESP_OK ||
+	    i2s_channel_init_std_mode(rx, &std_cfg) != ESP_OK ||
+	    i2s_channel_enable(tx) != ESP_OK || i2s_channel_enable(rx) != ESP_OK) {
+		ESP_LOGW(TAG, "speaker test: I2S setup failed");
+		goto out;
+	}
+	enabled = true;
+
+	audio_codec_i2s_cfg_t data_cfg = {
+		.port = WS_I2S_PORT,
+		.rx_handle = rx,
+		.tx_handle = tx,
+	};
+	audio_codec_i2c_cfg_t i2c_cfg = {
+		.port = WS_I2C_PORT,
+		.addr = ES8311_CODEC_DEFAULT_ADDR,
+		.bus_handle = i2c_bus,
+	};
+	gpio_if = audio_codec_new_gpio();
+	data_if = audio_codec_new_i2s_data(&data_cfg);
+	ctrl_if = audio_codec_new_i2c_ctrl(&i2c_cfg);
+	if (!gpio_if || !data_if || !ctrl_if)
+		goto out;
+
+	es8311_codec_cfg_t es_cfg = {
+		.ctrl_if = ctrl_if,
+		.gpio_if = gpio_if,
+		.codec_mode = ESP_CODEC_DEV_WORK_MODE_BOTH,
+		.pa_pin = WS_PA_ENABLE,	/* amplifier on only while open */
+		.pa_reverted = false,
+		.master_mode = false,
+		.use_mclk = true,
+		.digital_mic = false,
+		.no_dac_ref = true,
+		.mclk_div = I2S_MCLK_MULTIPLE_256,
+		.hw_gain = {
+			.pa_voltage = 5.0,
+			.codec_dac_voltage = 3.3,
+		},
+	};
+	codec_if = es8311_codec_new(&es_cfg);
+	if (!codec_if)
+		goto out;
+	esp_codec_dev_cfg_t dev_cfg = {
+		.dev_type = ESP_CODEC_DEV_TYPE_IN_OUT,
+		.codec_if = codec_if,
+		.data_if = data_if,
+	};
+	dev = esp_codec_dev_new(&dev_cfg);
+	esp_codec_dev_sample_info_t sample = {
+		.sample_rate = WS_RATE,
+		.channel = WS_CHANNELS,
+		.bits_per_sample = WS_BITS,
+	};
+	out = malloc(BEEP_CHUNK * 4);
+	in = malloc(BEEP_CHUNK * 4);
+	if (!dev || !out || !in || esp_codec_dev_open(dev, &sample) != ESP_CODEC_DEV_OK) {
+		ESP_LOGW(TAG, "speaker test: codec open failed");
+		goto out;
+	}
+	esp_codec_dev_set_out_vol(dev, BEEP_VOLUME);
+	esp_codec_dev_set_in_gain(dev, WS_MIC_GAIN_DB);
+
+	/* 1 + 2: acoustic loopback through the on-board microphone */
+	play_and_listen(dev, out, in, 0, 500, 200, &rms_sil);
+	dump_codec(dev, "before tone");
+	play_and_listen(dev, out, in, 1000, 750, 100, &rms_tone);
+	dump_codec(dev, "during tone");
+	{
+		double r2 = 0;
+
+		play_and_listen(dev, out, in, 1000, 750, 0, &r2);
+		rms_tone = sqrt((rms_tone * rms_tone + r2 * r2) / 2);
+	}
+	ESP_LOGI(TAG, "speaker test: mic rms silence=%d, during 1 kHz tone=%d (%s)",
+		 (int)rms_sil, (int)rms_tone,
+		 rms_tone > 4 * rms_sil + 50 ? "tone HEARD by the microphone"
+					   : "tone NOT heard by the microphone");
+
+	/* 3: beeps for a person */
+	for (int b = 0; b < 3; b++) {
+		play_and_listen(dev, out, NULL, 660, 1000, 0, NULL);
+		play_and_listen(dev, out, NULL, 0, 500, 0, NULL);
+	}
+	esp_codec_dev_close(dev);	/* also disables both I2S channels */
+	enabled = false;
+	ESP_LOGI(TAG, "speaker test: 3 beeps played (660 Hz 1 s, volume %d)", BEEP_VOLUME);
+
+out:
+	free(out);
+	free(in);
+	if (dev)
+		esp_codec_dev_delete(dev);
+	if (codec_if)
+		audio_codec_delete_codec_if(codec_if);
+	if (ctrl_if)
+		audio_codec_delete_ctrl_if(ctrl_if);
+	if (data_if)
+		audio_codec_delete_data_if(data_if);
+	if (gpio_if)
+		audio_codec_delete_gpio_if(gpio_if);
+	if (enabled) {
+		/* error path: no DMA or interrupt may stay active for Linux */
+		i2s_channel_disable(tx);
+		i2s_channel_disable(rx);
+	}
+	if (tx)
+		i2s_del_channel(tx);
+	if (rx)
+		i2s_del_channel(rx);
+	pa_off();
+}
+
+#endif /* WS_SPEAKER_TEST */
+
+esp_err_t ws_audio_init(void)
+{
+	esp_err_t err;
+
+	pa_off();
+	err = init_i2c();
+#ifdef WS_SPEAKER_TEST	/* -DWS_SPEAKER_TEST: boot-time speaker diagnostic */
+	if (err == ESP_OK)
+		speaker_beep();
+#endif
+	if (err == ESP_OK)
+		err = init_i2s();
+	if (err == ESP_OK)
+		err = init_codec();
+	if (err == ESP_OK)
+		mic_level_test();
+
+	/* Keep the register and IO-matrix setup, leave no live IDF transfer. */
+	if (rx_chan)
+		i2s_channel_disable(rx_chan);
+	if (tx_chan)
+		i2s_channel_disable(tx_chan);
+	release_idf_dma();
+	if (i2c_bus)
+		release_i2c_pins();
+
+	if (err == ESP_OK)
+		ESP_LOGI(TAG, "I2S1 full duplex + ES8311 ADC/DAC ready for Linux: 16 kHz S16_LE stereo, mic gain %.0f dB, out volume %d",
+			 WS_MIC_GAIN_DB, WS_OUT_VOLUME);
+	else
+		ESP_LOGW(TAG, "audio preparation failed: %s; continuing Linux boot",
+			 esp_err_to_name(err));
+	return err;
+}
