@@ -0,0 +1,595 @@
+Waveshare ESP32-P4-WIFI6: ES8311 PCM device /dev/ws-audio (continuous capture).
+
+Adapted from linux-waveshare-xc's esp32p4-xc-audio (patch 0043 there).
+The boot shim (ws_audio.c) configures the codec and I2S1.
+
+--- a/drivers/misc/Kconfig
++++ b/drivers/misc/Kconfig
+@@ -655,6 +655,15 @@
+ 	  boot shim, which turns the C6 off and puts the chip into Deep
+ 	  Sleep until a timer or LP GPIO wakes it.
+ 
++config ESP32P4_WS_AUDIO
++	bool "Waveshare ESP32-P4-WIFI6: ES8311 PCM device (/dev/ws-audio)"
++	depends on SOC_ESP32P4 && !MMU
++	help
++	  Minimal read/write PCM device for the ES8311 codec of the Waveshare
++	  ESP32-P4-WIFI6: 16 kHz, S16_LE, two channels, microphone on the
++	  left.  The boot shim configures the codec and I2S1; Linux only
++	  starts and stops transfers on AHB-GDMA channel 2.
++
+ source "drivers/misc/c2port/Kconfig"
+ source "drivers/misc/eeprom/Kconfig"
+ source "drivers/misc/cb710/Kconfig"
+--- a/drivers/misc/Makefile
++++ b/drivers/misc/Makefile
+@@ -76,3 +76,4 @@
+ obj-$(CONFIG_MISC_RP1)		+= rp1/
+ obj-$(CONFIG_ESP32P4_BOOTFLASH)	+= esp32p4-bootflash.o
+ obj-$(CONFIG_ESP32P4_SLEEP)	+= esp32p4-sleep.o
++obj-$(CONFIG_ESP32P4_WS_AUDIO)	+= esp32p4-ws-audio.o
+--- /dev/null
++++ b/drivers/misc/esp32p4-ws-audio.c
+@@ -0,0 +1,562 @@
++// SPDX-License-Identifier: GPL-2.0
++/*
++ * Lightweight PCM driver for the Waveshare ESP32-P4-WIFI6 (ES8311 codec).
++ *
++ * Adapted from linux-waveshare-xc's esp32p4-xc-audio (Waveshare XC boards,
++ * ES8311 + ES7210; written but never tested on hardware there).  On the
++ * WIFI6 board the ES8311 alone does both directions: its analog microphone
++ * input comes back on I2S DIN (GPIO11).
++ *
++ * The ESP-IDF boot shim (ws_audio.c) configures the I2S pin matrix, I2S1
++ * clocks/slots and the codec, then disables its I2S channels before the
++ * jump.  Linux keeps that configuration and owns I2S1 plus AHB-GDMA channel
++ * pair 2.  The userspace ABI is fixed and tiny: read /dev/ws-audio,
++ * S16_LE, 16000 Hz, two interleaved channels (the microphone is the left
++ * one).
++ *
++ * Capture is continuous: open() starts I2S RX and a circular ring of
++ * WS_RING_N DMA descriptors (one 4080-byte block = 63.75 ms each), the way
++ * ESP-IDF's own I2S driver does it; read() copies completed blocks, found
++ * through the DMA's "last EOF descriptor" register, and close() stops it.
++ * There is no interrupt: read() sleeps in 2 ms steps while it waits.  If the
++ * reader falls more than the ring behind, the oldest audio is lost: read()
++ * resynchronises and the count is logged at close().  The first frame after start is a stale FIFO word and is replaced
++ * by the second.  Only one reader at a time (-EBUSY).
++ *
++ * write() is the old one-shot path (one block per call, I2S restarted):
++ * the shim currently sets I2S1 up for RX only, so playback is not wired.
++ */
++
++#include <linux/bitops.h>
++#include <linux/delay.h>
++#include <linux/fs.h>
++#include <linux/io.h>
++#include <linux/iopoll.h>
++#include <linux/miscdevice.h>
++#include <linux/module.h>
++#include <linux/mutex.h>
++#include <linux/of.h>
++#include <linux/platform_device.h>
++#include <linux/slab.h>
++#include <linux/uaccess.h>
++#include <linux/atomic.h>
++#include <linux/jiffies.h>
++#include <linux/sched/signal.h>
++
++#define WS_AUDIO_RATE		16000
++#define WS_AUDIO_CHANNELS	2
++#define WS_AUDIO_BITS		16
++#define WS_AUDIO_MAX_IO		4080
++
++#define I2S_RX_CONF		0x020
++#define I2S_TX_CONF		0x024
++#define I2S_RX_EOF_NUM		0x064
++#define I2S_CONF_RESET		BIT(0)
++#define I2S_CONF_FIFO_RESET	BIT(1)
++#define I2S_CONF_START		BIT(2)
++#define I2S_CONF_UPDATE		BIT(8)
++
++#define DMA_IN_INT_RAW_CH2	0x020
++#define DMA_IN_INT_CLR_CH2	0x02c
++#define DMA_OUT_INT_RAW_CH2	0x050
++#define DMA_OUT_INT_CLR_CH2	0x05c
++#define DMA_MISC_CONF		0x064
++#define DMA_IN_CONF0_CH2	0x1f0
++#define DMA_IN_CONF1_CH2	0x1f4
++#define DMA_IN_LINK_CH2		0x200
++#define DMA_IN_PERI_SEL_CH2	0x220
++#define DMA_OUT_CONF0_CH2	0x250
++#define DMA_OUT_CONF1_CH2	0x254
++#define DMA_OUT_LINK_CH2	0x260
++#define DMA_OUT_PERI_SEL_CH2	0x280
++#define DMA_IN_SUC_EOF_DES_ADDR_CH2	0x208
++#define DMA_IN_LINK_ADDR_CH2	0x3b4
++#define DMA_OUT_LINK_ADDR_CH2	0x3c0
++#define DMA_ARB_CONF		0x404
++
++#define DMA_IN_DONE		BIT(1)
++#define DMA_IN_SUC_EOF		BIT(1)
++#define DMA_IN_DESC_ERR		BIT(3)
++#define DMA_OUT_DESC_ERR	BIT(2)
++#define DMA_OUT_DONE		BIT(3)
++#define DMA_CONF_RESET		BIT(0)
++#define DMA_OWNER_CHECK		BIT(12)
++#define DMA_IN_LINK_STOP	BIT(1)
++#define DMA_IN_LINK_START	BIT(2)
++#define DMA_OUT_LINK_STOP	BIT(0)
++#define DMA_OUT_LINK_START	BIT(1)
++#define DMA_I2S1_TRIGGER	4
++
++#define CLKRST_SOC_CLK_CTRL1	0x018
++#define CLKRST_SOC_CLK_CTRL2	0x01c
++#define CLKRST_PERI_CLK_CTRL14	0x050
++#define CLKRST_PERI_CLK_CTRL15	0x054
++#define CLKRST_AHB_PDMA_CLK	BIT(3)
++#define CLKRST_I2S1_APB_CLK	BIT(15)
++#define CLKRST_I2S1_RX_CLK	BIT(20)
++#define CLKRST_I2S1_TX_CLK	BIT(28)
++
++/* P4 ROM cache helpers: Cache_WriteBack_Addr / Cache_Invalidate_Addr, the
++ * same address in esp32p4.rom.ld and esp32p4.rom.eco5.ld (chip v3.x). */
++#define ESP32P4_CACHE_MAP_L1D_L2 0x30
++typedef int (*esp32p4_cache_op_t)(u32 map, u32 addr, u32 size);
++#define esp32p4_cache_writeback ((esp32p4_cache_op_t)0x4fc003f4)
++#define esp32p4_cache_invalidate ((esp32p4_cache_op_t)0x4fc003e4)
++
++struct ws_dma_desc {
++	u32 control;
++	u32 buffer;
++	u32 next;
++};
++
++/* Capture ring: 8 x 63.75 ms = 510 ms of slack for the reader. */
++#define WS_RING_N		8
++#define WS_RING_STRIDE		4096	/* cache-line aligned slots */
++#define WS_BLOCK_JIFFIES	msecs_to_jiffies(64)
++
++struct ws_audio {
++	struct device *dev;
++	void __iomem *i2s;
++	void __iomem *dma;
++	void __iomem *clkrst;
++	struct miscdevice miscdev;
++	struct mutex lock; /* serializes the buffer and the DMA channel pair */
++	struct ws_dma_desc *desc;
++	u8 *buffer;
++	/* continuous capture */
++	struct ws_dma_desc *rdesc;	/* WS_RING_N descriptors */
++	u8 *ring;			/* WS_RING_N * WS_RING_STRIDE bytes */
++	atomic_t busy;			/* one opener at a time */
++	bool running;
++	bool first_block;
++	unsigned int cons;		/* next ring slot to hand out */
++	unsigned int cons_off;		/* bytes of that slot already read */
++	unsigned long last_progress;	/* jiffies of the last consumed block */
++	unsigned long overruns;
++};
++
++static void ws_cache_writeback(const void *addr, size_t size)
++{
++	esp32p4_cache_writeback(ESP32P4_CACHE_MAP_L1D_L2, (u32)(uintptr_t)addr, size);
++}
++
++static void ws_cache_invalidate(const void *addr, size_t size)
++{
++	esp32p4_cache_invalidate(ESP32P4_CACHE_MAP_L1D_L2, (u32)(uintptr_t)addr, size);
++}
++
++static void ws_enable_clocks(struct ws_audio *audio)
++{
++	u32 value;
++
++	value = readl(audio->clkrst + CLKRST_SOC_CLK_CTRL1);
++	writel(value | CLKRST_AHB_PDMA_CLK, audio->clkrst + CLKRST_SOC_CLK_CTRL1);
++	value = readl(audio->clkrst + CLKRST_SOC_CLK_CTRL2);
++	writel(value | CLKRST_I2S1_APB_CLK, audio->clkrst + CLKRST_SOC_CLK_CTRL2);
++	value = readl(audio->clkrst + CLKRST_PERI_CLK_CTRL14);
++	writel(value | CLKRST_I2S1_RX_CLK, audio->clkrst + CLKRST_PERI_CLK_CTRL14);
++	value = readl(audio->clkrst + CLKRST_PERI_CLK_CTRL15);
++	writel(value | CLKRST_I2S1_TX_CLK, audio->clkrst + CLKRST_PERI_CLK_CTRL15);
++
++	value = readl(audio->dma + DMA_MISC_CONF);
++	writel(value | BIT(3), audio->dma + DMA_MISC_CONF);
++	value = readl(audio->dma + DMA_ARB_CONF);
++	writel(value | BIT(27) | BIT(28), audio->dma + DMA_ARB_CONF);
++}
++
++static int ws_i2s_start(struct ws_audio *audio, bool capture)
++{
++	void __iomem *conf = audio->i2s + (capture ? I2S_RX_CONF : I2S_TX_CONF);
++	u32 value;
++	int ret;
++
++	value = readl(conf) & ~I2S_CONF_START;
++	writel(value | I2S_CONF_RESET | I2S_CONF_FIFO_RESET, conf);
++	writel(value & ~(I2S_CONF_RESET | I2S_CONF_FIFO_RESET), conf);
++	writel(value | I2S_CONF_UPDATE, conf);
++	ret = readl_poll_timeout(conf, value, !(value & I2S_CONF_UPDATE), 1, 1000);
++	if (ret)
++		return ret;
++	writel(readl(conf) | I2S_CONF_START, conf);
++	return 0;
++}
++
++static void ws_i2s_stop(struct ws_audio *audio, bool capture)
++{
++	void __iomem *conf = audio->i2s + (capture ? I2S_RX_CONF : I2S_TX_CONF);
++
++	writel(readl(conf) & ~I2S_CONF_START, conf);
++}
++
++static void ws_dma_prepare(struct ws_audio *audio, bool capture, size_t len)
++{
++	phys_addr_t desc_phys = virt_to_phys(audio->desc);
++	phys_addr_t buffer_phys = virt_to_phys(audio->buffer);
++
++	audio->desc->control = len | (len << 12) | BIT(30) | BIT(31);
++	audio->desc->buffer = lower_32_bits(buffer_phys);
++	audio->desc->next = 0;
++
++	/* Generic dma_sync does not cover descriptor/data visibility on this
++	 * rv32imac NOMMU build: use the P4 ROM cache operations. */
++	ws_cache_writeback(audio->buffer, len);
++	ws_cache_writeback(audio->desc, sizeof(*audio->desc));
++	if (capture)
++		ws_cache_invalidate(audio->buffer, len);
++
++	if (capture) {
++		writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++		writel(DMA_CONF_RESET, audio->dma + DMA_IN_CONF0_CH2);
++		writel(0, audio->dma + DMA_IN_CONF0_CH2);
++		writel(DMA_OWNER_CHECK, audio->dma + DMA_IN_CONF1_CH2);
++		writel(DMA_I2S1_TRIGGER, audio->dma + DMA_IN_PERI_SEL_CH2);
++		writel(0xff, audio->dma + DMA_IN_INT_CLR_CH2);
++		writel(lower_32_bits(desc_phys), audio->dma + DMA_IN_LINK_ADDR_CH2);
++		writel(len, audio->i2s + I2S_RX_EOF_NUM);
++		writel(DMA_IN_LINK_START, audio->dma + DMA_IN_LINK_CH2);
++	} else {
++		writel(DMA_OUT_LINK_STOP, audio->dma + DMA_OUT_LINK_CH2);
++		writel(DMA_CONF_RESET, audio->dma + DMA_OUT_CONF0_CH2);
++		writel(BIT(3), audio->dma + DMA_OUT_CONF0_CH2);
++		writel(DMA_OWNER_CHECK, audio->dma + DMA_OUT_CONF1_CH2);
++		writel(DMA_I2S1_TRIGGER, audio->dma + DMA_OUT_PERI_SEL_CH2);
++		writel(0x7f, audio->dma + DMA_OUT_INT_CLR_CH2);
++		writel(lower_32_bits(desc_phys), audio->dma + DMA_OUT_LINK_ADDR_CH2);
++		writel(DMA_OUT_LINK_START, audio->dma + DMA_OUT_LINK_CH2);
++	}
++}
++
++static void ws_dma_stop(struct ws_audio *audio, bool capture)
++{
++	writel(capture ? DMA_IN_LINK_STOP : DMA_OUT_LINK_STOP,
++	       audio->dma + (capture ? DMA_IN_LINK_CH2 : DMA_OUT_LINK_CH2));
++}
++
++static int ws_audio_transfer(struct ws_audio *audio, bool capture, size_t len)
++{
++	void __iomem *status = audio->dma +
++		(capture ? DMA_IN_INT_RAW_CH2 : DMA_OUT_INT_RAW_CH2);
++	u32 done = capture ? DMA_IN_DONE : DMA_OUT_DONE;
++	u32 error = capture ? DMA_IN_DESC_ERR : DMA_OUT_DESC_ERR;
++	u32 value;
++	int ret;
++
++	ws_enable_clocks(audio);
++	ws_dma_prepare(audio, capture, len);
++	ret = ws_i2s_start(audio, capture);
++	if (ret)
++		goto stop_dma;
++
++	/* 4080 bytes = 63.75 ms at 16 kHz stereo S16; 500 ms is "no clock". */
++	ret = readl_poll_timeout(status, value, value & (done | error), 10, 500000);
++	ws_i2s_stop(audio, capture);
++	if (!ret && (value & error))
++		ret = -EIO;
++	if (!ret && capture)
++		ws_cache_invalidate(audio->buffer, len);
++
++stop_dma:
++	ws_dma_stop(audio, capture);
++	if (ret == -ETIMEDOUT)
++		dev_warn_ratelimited(audio->dev, "%s DMA timed out (no I2S clock?)\n",
++				     capture ? "capture" : "playback");
++	return ret;
++}
++
++static void ws_ring_start(struct ws_audio *audio)
++{
++	phys_addr_t d0 = virt_to_phys(audio->rdesc);
++	int i;
++
++	ws_enable_clocks(audio);
++	for (i = 0; i < WS_RING_N; i++) {
++		audio->rdesc[i].control = WS_AUDIO_MAX_IO | BIT(31); /* size, owner DMA */
++		audio->rdesc[i].buffer = lower_32_bits(virt_to_phys(audio->ring +
++							i * WS_RING_STRIDE));
++		audio->rdesc[i].next = lower_32_bits(d0 + ((i + 1) % WS_RING_N) *
++						     sizeof(struct ws_dma_desc));
++	}
++	ws_cache_writeback(audio->rdesc, WS_RING_N * sizeof(struct ws_dma_desc));
++	ws_cache_writeback(audio->ring, WS_RING_N * WS_RING_STRIDE);
++	ws_cache_invalidate(audio->ring, WS_RING_N * WS_RING_STRIDE);
++
++	writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++	writel(DMA_CONF_RESET, audio->dma + DMA_IN_CONF0_CH2);
++	writel(0, audio->dma + DMA_IN_CONF0_CH2);
++	writel(0, audio->dma + DMA_IN_CONF1_CH2);	/* no owner check: circular */
++	writel(DMA_I2S1_TRIGGER, audio->dma + DMA_IN_PERI_SEL_CH2);
++	writel(0xff, audio->dma + DMA_IN_INT_CLR_CH2);
++	writel(lower_32_bits(d0), audio->dma + DMA_IN_LINK_ADDR_CH2);
++	writel(WS_AUDIO_MAX_IO, audio->i2s + I2S_RX_EOF_NUM);
++	writel(DMA_IN_LINK_START, audio->dma + DMA_IN_LINK_CH2);
++
++	audio->cons = 0;
++	audio->cons_off = 0;
++	audio->first_block = true;
++	audio->last_progress = jiffies;
++	audio->running = !ws_i2s_start(audio, true);
++	if (!audio->running) {
++		writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++		dev_warn(audio->dev, "capture: I2S RX did not start\n");
++	}
++}
++
++static void ws_ring_stop(struct ws_audio *audio)
++{
++	if (!audio->running)
++		return;
++	ws_i2s_stop(audio, true);
++	writel(DMA_IN_LINK_STOP, audio->dma + DMA_IN_LINK_CH2);
++	audio->running = false;
++}
++
++/* Index of the newest completed ring slot, or -1 if none yet. */
++static int ws_ring_newest(struct ws_audio *audio)
++{
++	u32 raw = readl(audio->dma + DMA_IN_INT_RAW_CH2);
++	u32 addr, d0 = lower_32_bits(virt_to_phys(audio->rdesc));
++
++	if (!(raw & DMA_IN_SUC_EOF))
++		return -1;
++	addr = readl(audio->dma + DMA_IN_SUC_EOF_DES_ADDR_CH2);
++	if (addr < d0 || addr >= d0 + WS_RING_N * sizeof(struct ws_dma_desc))
++		return -1;
++	return (addr - d0) / sizeof(struct ws_dma_desc);
++}
++
++/* Wait until ring slot audio->cons is complete.  0, or -ETIMEDOUT. */
++static int ws_ring_wait(struct ws_audio *audio)
++{
++	unsigned long deadline = jiffies + msecs_to_jiffies(500);
++
++	for (;;) {
++		int newest = ws_ring_newest(audio);
++
++		if (newest >= 0) {
++			unsigned int avail = (newest - audio->cons + 1 + WS_RING_N) % WS_RING_N;
++
++			/*
++			 * More than a ring of time without consuming: the DMA
++			 * has lapped the reader and avail is meaningless.
++			 * Jump to the newest block.
++			 */
++			if (time_after(jiffies, audio->last_progress +
++				       (WS_RING_N - 1) * WS_BLOCK_JIFFIES)) {
++				audio->overruns++;
++				audio->cons = newest;
++				audio->cons_off = 0;
++				audio->last_progress = jiffies;
++				return 0;
++			}
++			if (avail)
++				return 0;
++		}
++		if (time_after(jiffies, deadline))
++			return -ETIMEDOUT;
++		if (signal_pending(current))
++			return -ERESTARTSYS;
++		usleep_range(2000, 4000);
++	}
++}
++
++static ssize_t ws_ring_read(struct ws_audio *audio, char __user *buf, size_t count)
++{
++	size_t done = 0;
++
++	count &= ~3UL;
++	while (done < count) {
++		u8 *slot = audio->ring + audio->cons * WS_RING_STRIDE;
++		size_t n;
++		int ret;
++
++		if (audio->cons_off == 0) {
++			ret = ws_ring_wait(audio);
++			if (ret) {
++				if (done)
++					break;
++				if (ret == -ETIMEDOUT)
++					dev_warn_ratelimited(audio->dev,
++						"capture DMA timed out (no I2S clock?)\n");
++				return ret;
++			}
++			slot = audio->ring + audio->cons * WS_RING_STRIDE;
++			ws_cache_invalidate(slot, WS_AUDIO_MAX_IO);
++			if (audio->first_block) {
++				/* stale FIFO word before the first real frame */
++				memcpy(slot, slot + 4, 4);
++				audio->first_block = false;
++			}
++		}
++		n = min_t(size_t, count - done, WS_AUDIO_MAX_IO - audio->cons_off);
++		if (copy_to_user(buf + done, slot + audio->cons_off, n))
++			return done ? done : -EFAULT;
++		done += n;
++		audio->cons_off += n;
++		if (audio->cons_off >= WS_AUDIO_MAX_IO) {
++			audio->cons_off = 0;
++			audio->cons = (audio->cons + 1) % WS_RING_N;
++			audio->last_progress = jiffies;
++		}
++	}
++	return done;
++}
++
++static int ws_audio_open(struct inode *inode, struct file *file)
++{
++	struct miscdevice *miscdev = file->private_data;
++	struct ws_audio *audio = container_of(miscdev, struct ws_audio, miscdev);
++
++	if (atomic_cmpxchg(&audio->busy, 0, 1))
++		return -EBUSY;
++	file->private_data = audio;
++	return nonseekable_open(inode, file);
++}
++
++static int ws_audio_release(struct inode *inode, struct file *file)
++{
++	struct ws_audio *audio = file->private_data;
++
++	mutex_lock(&audio->lock);
++	ws_ring_stop(audio);
++	mutex_unlock(&audio->lock);
++	if (audio->overruns)
++		dev_info(audio->dev, "capture: %lu overrun(s) (reader too slow)\n",
++			 audio->overruns);
++	atomic_set(&audio->busy, 0);
++	return 0;
++}
++
++static ssize_t ws_audio_read(struct file *file, char __user *buf,
++			     size_t count, loff_t *ppos)
++{
++	struct ws_audio *audio = file->private_data;
++	ssize_t ret;
++
++	if (count < 4)
++		return -EINVAL;
++	if (mutex_lock_interruptible(&audio->lock))
++		return -ERESTARTSYS;
++	if (!audio->running) {
++		audio->overruns = 0;
++		ws_ring_start(audio);
++	}
++	ret = audio->running ? ws_ring_read(audio, buf, count) : -EIO;
++	mutex_unlock(&audio->lock);
++	return ret;
++}
++
++static ssize_t ws_audio_write(struct file *file, const char __user *buf,
++			      size_t count, loff_t *ppos)
++{
++	struct ws_audio *audio = file->private_data;
++	size_t len = min_t(size_t, count, WS_AUDIO_MAX_IO) & ~3UL;
++	int ret;
++
++	if (!len)
++		return -EINVAL;
++	if (mutex_lock_interruptible(&audio->lock))
++		return -ERESTARTSYS;
++	if (copy_from_user(audio->buffer, buf, len)) {
++		mutex_unlock(&audio->lock);
++		return -EFAULT;
++	}
++	ret = ws_audio_transfer(audio, false, len);
++	mutex_unlock(&audio->lock);
++	return ret ? ret : len;
++}
++
++static const struct file_operations ws_audio_fops = {
++	.owner = THIS_MODULE,
++	.open = ws_audio_open,
++	.release = ws_audio_release,
++	.read = ws_audio_read,
++	.write = ws_audio_write,
++};
++
++static int ws_audio_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct ws_audio *audio;
++	phys_addr_t desc_phys, buffer_phys;
++	int ret;
++
++	audio = devm_kzalloc(dev, sizeof(*audio), GFP_KERNEL);
++	if (!audio)
++		return -ENOMEM;
++	audio->dev = dev;
++	audio->i2s = devm_platform_ioremap_resource_byname(pdev, "i2s");
++	if (IS_ERR(audio->i2s))
++		return PTR_ERR(audio->i2s);
++	audio->dma = devm_platform_ioremap_resource_byname(pdev, "ahb-dma");
++	if (IS_ERR(audio->dma))
++		return PTR_ERR(audio->dma);
++	audio->clkrst = devm_platform_ioremap_resource_byname(pdev, "clkrst");
++	if (IS_ERR(audio->clkrst))
++		return PTR_ERR(audio->clkrst);
++
++	audio->buffer = devm_kmalloc(dev, WS_AUDIO_MAX_IO, GFP_KERNEL);
++	audio->desc = devm_kzalloc(dev, sizeof(*audio->desc), GFP_KERNEL);
++	audio->ring = devm_kmalloc(dev, WS_RING_N * WS_RING_STRIDE, GFP_KERNEL);
++	audio->rdesc = devm_kcalloc(dev, WS_RING_N, sizeof(*audio->rdesc), GFP_KERNEL);
++	if (!audio->buffer || !audio->desc || !audio->ring || !audio->rdesc)
++		return -ENOMEM;
++	if (virt_to_phys(audio->ring) < 0x40000000 ||
++	    virt_to_phys(audio->ring) + WS_RING_N * WS_RING_STRIDE > 0x4ffc0000 ||
++	    virt_to_phys(audio->rdesc) < 0x40000000 ||
++	    virt_to_phys(audio->rdesc) >= 0x4ffc0000) {
++		dev_err(dev, "capture ring outside the ESP32-P4 DMA range\n");
++		return -ERANGE;
++	}
++	atomic_set(&audio->busy, 0);
++	desc_phys = virt_to_phys(audio->desc);
++	buffer_phys = virt_to_phys(audio->buffer);
++	if (upper_32_bits(desc_phys) || upper_32_bits(buffer_phys) ||
++	    desc_phys < 0x40000000 || desc_phys >= 0x4ffc0000 ||
++	    buffer_phys < 0x40000000 ||
++	    buffer_phys + WS_AUDIO_MAX_IO > 0x4ffc0000) {
++		dev_err(dev, "DMA memory outside the ESP32-P4 addressable range\n");
++		return -ERANGE;
++	}
++
++	mutex_init(&audio->lock);
++	audio->miscdev.minor = MISC_DYNAMIC_MINOR;
++	audio->miscdev.name = "ws-audio";
++	audio->miscdev.fops = &ws_audio_fops;
++	audio->miscdev.parent = dev;
++	/* Single-user board: let m5 record without root. */
++	audio->miscdev.mode = 0666;
++	ret = misc_register(&audio->miscdev);
++	if (ret)
++		return ret;
++	platform_set_drvdata(pdev, audio);
